	{ id = "no_betray", category = "Warn", text = "Stay loyal! No betrayal!", color = "#f97316" },
}

-- Progression XP Curve matching OpenFront level badges
function Config.XpForNextLevel(level: number): number
	return 500 + level * 350
end

return Config
