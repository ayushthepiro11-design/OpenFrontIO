--!strict
-- Exact `--!native` port of OpenFront default-theme.json, colorblind-theme.json &amp; ColorUtils.ts

local Theme = {}

export type RGB = { number }

function Theme.HexToRGB(hex: string): (number, number, number)
	local clean = string.gsub(hex, "^#", "")
	local r = tonumber(string.sub(clean, 1, 2), 16) or 128
	local g = tonumber(string.sub(clean, 3, 4), 16) or 128
	local b = tonumber(string.sub(clean, 5, 6), 16) or 128
	return r, g, b
end

function Theme.HexToColor3(hex: string): Color3
	local r, g, b = Theme.HexToRGB(hex)
	return Color3.fromRGB(r, g, b)
end

function Theme.PackRGBA(r: number, g: number, b: number, a: number?): number
	local alpha = if a ~= nil then a else 255
	return bit32.bor(
		math.clamp(math.floor(r + 0.5), 0, 255),
		bit32.lshift(math.clamp(math.floor(g + 0.5), 0, 255), 8),
		bit32.lshift(math.clamp(math.floor(b + 0.5), 0, 255), 16),
		bit32.lshift(math.clamp(math.floor(alpha + 0.5), 0, 255), 24)
	)
end

function Theme.UnpackRGB(u32: number): (number, number, number)
	return bit32.band(u32, 0xFF),
		bit32.band(bit32.rshift(u32, 8), 0xFF),
		bit32.band(bit32.rshift(u32, 16), 0xFF)
end

Theme.TeamColors = {
	Red = "#eb3333",
	Blue = "#2962ff",
	Teal = "#06b6d4",
	Purple = "#9234ea",
	Yellow = "#e7b008",
	Orange = "#ff7f0e",
	Green = "#41be52",
	Bot = "#d1cdc7",
	Humans = "#2962ff",
	Nations = "#eb3333",
}

Theme.TeamOrder = { "Blue", "Red", "Green", "Yellow", "Purple", "Teal", "Orange" }

Theme.HumanColors = {
	"#06b6d4", "#ef4444", "#22c55e", "#f59e0b", "#8b5cf6", "#ec4899", "#3b82f6",
	"#10b981", "#f97316", "#a855f7", "#14b8a6", "#eab308", "#f43f5e", "#0ea5e9",
	"#84cc16", "#6366f1", "#d946ef", "#fb7185", "#2dd4bf", "#fbbf24", "#60a5fa",
	"#4ade80", "#c084fc", "#38bdf8", "#f87171", "#34d399", "#facc15", "#e879f9",
}

Theme.NationColors = {
	"#e05656", "#3b82f6", "#22c55e", "#f59e0b", "#a855f7", "#14b8a6", "#ec4899", "#84cc16",
	"#f97316", "#06b6d4", "#6366f1", "#10b981", "#eab308", "#f43f5e", "#0ea5e9", "#d946ef",
	"#ef4444", "#2dd4bf", "#8b5cf6", "#4ade80", "#fb923c", "#38bdf8", "#fb7185", "#a3e635",
	"#c084fc", "#34d399", "#fbbf24", "#60a5fa", "#f472b6", "#2563eb", "#16a34a", "#d97706",
	"#9333ea", "#0d9488", "#db2777", "#65a30d", "#ea580c", "#0891b2", "#4f46e5", "#059669",
	"#ca8a04", "#e11d48", "#0284c7", "#c026d3", "#dc2626", "#0f766e", "#7c3aed", "#15803d",
}

-- 40 distinct minor-bot hues (zero duplicate hex entries!)
Theme.BotColors = {
	"#60a5fa", "#f87171", "#4ade80", "#fbbf24", "#c084fc", "#2dd4bf", "#f472b6", "#a3e635",
	"#fb923c", "#38bdf8", "#818cf8", "#34d399", "#facc15", "#fb7185", "#67e8f9", "#e879f9",
	"#5eead4", "#fda4af", "#93c5fd", "#86efac", "#fde047", "#d8b4fe", "#fdba74", "#7dd3fc",
	"#a5b4fc", "#6ee7b7", "#fcd34d", "#f9a8d4", "#22d3ee", "#bef264", "#fca5a5", "#c4b5fd",
	"#0ea5e9", "#10b981", "#f97316", "#ec4899", "#3b82f6", "#eab308", "#14b8a6", "#a855f7",
}

Theme.ColorblindColors = {
	"#0072B2", "#E69F00", "#009E73", "#CC79A7", "#56B4E9", "#D55E00", "#F0E442", "#7F7F7F",
}

Theme.Patterns = {
	{ id = "none", name = "Solid Classic" },
	{ id = "stripes", name = "Diagonal Stripes" },
	{ id = "checkers", name = "Royal Checkers" },
	{ id = "grid", name = "Imperial Grid" },
	{ id = "dots", name = "Tactical Dots" },
}

function Theme.SamplePatternSecondary(patternId: string, x: number, y: number): boolean
	if patternId == "none" or patternId == "" then
		return false
	elseif patternId == "stripes" then
		return ((x + y) % 8) &lt; 3
	elseif patternId == "checkers" then
		return (bit32.band(bit32.rshift(x, 2), 1) ~= bit32.band(bit32.rshift(y, 2), 1))
	elseif patternId == "grid" then
		return (x % 8 == 0) or (y % 8 == 0)
	elseif patternId == "dots" then
		return (x % 6 &lt; 2) and (y % 6 &lt; 2)
	end
	return false
end

function Theme.TerrainByteToRGB(tb: number): (number, number, number)
	local isLand = bit32.band(tb, 0x80) ~= 0
	local isShoreline = bit32.band(tb, 0x40) ~= 0
	local magnitude = bit32.band(tb, 0x1F)

	if isLand and magnitude == 31 then
		return 60, 60, 60
	elseif isLand and isShoreline then
		return 204, 203, 158
	elseif isLand then
		if magnitude &lt; 10 then
			return 190, 220 - 2 * magnitude, 138
		elseif magnitude &lt; 20 then
			local m = magnitude - 10
			return math.min(255, 200 + 2 * m), math.min(255, 183 + 2 * m), math.min(255, 138 + 2 * m)
		else
			local m = math.floor(magnitude / 2)
			return math.min(255, 230 + m), math.min(255, 230 + m), math.min(255, 230 + m)
		end
	elseif isShoreline then
		return 126, 170, 203
	else
		local m = math.min(magnitude, 10)
		return math.max(0, 71 - m), math.max(0, 133 - m), math.max(0, 181 - m)
	end
end

Theme.TerrainU32LUT = table.create(256, 0)
Theme.TerrainColor3LUT = table.create(256, Color3.new())
for tb = 0, 255 do
	local r, g, b = Theme.TerrainByteToRGB(tb)
	Theme.TerrainU32LUT[tb + 1] = Theme.PackRGBA(r, g, b, 255)
	Theme.TerrainColor3LUT[tb + 1] = Color3.fromRGB(r, g, b)
end

function Theme.BlendTerritoryOverTerrain(
	tr: number,
	tg: number,
	tb: number,
	pr: number,
	pg: number,
	pb: number,
	defended: boolean
): (number, number, number)
	local sr, sg, sb = pr, pg, pb
	if defended then
		sr *= 0.88
		sg *= 0.88
		sb *= 0.88
	end
	local alpha = 0.72
	local inv = 1.0 - alpha
	return math.floor(tr * inv + sr * alpha + 0.5),
		math.floor(tg * inv + sg * alpha + 0.5),
		math.floor(tb * inv + sb * alpha + 0.5)
end

function Theme.BorderRGB(pr: number, pg: number, pb: number): (number, number, number)
	return math.floor(pr * 0.62 + 0.5), math.floor(pg * 0.62 + 0.5), math.floor(pb * 0.62 + 0.5)
end

Theme.FalloutBrightU32 = Theme.PackRGBA(38, 205, 42, 255)
Theme.FalloutDarkU32 = Theme.PackRGBA(24, 138, 30, 255)
Theme.FalloutColor3 = Color3.fromRGB(34, 185, 38)
Theme.RailroadU32 = Theme.PackRGBA(68, 52, 38, 255)
Theme.RailroadColor3 = Color3.fromRGB(68, 52, 38)
Theme.SpawnHighlightU32 = Theme.PackRGBA(255, 213, 79, 255)

Theme.Affiliation = {
	SelfFill = Color3.fromRGB(34, 197, 94),
	SelfU32 = Theme.PackRGBA(34, 197, 94, 255),
	AllyFill = Color3.fromRGB(250, 204, 21),
	AllyU32 = Theme.PackRGBA(250, 204, 21, 255),
	NeutralFill = Color3.fromRGB(148, 163, 184),
	NeutralU32 = Theme.PackRGBA(148, 163, 184, 255),
	EnemyFill = Color3.fromRGB(239, 68, 68),
	EnemyU32 = Theme.PackRGBA(239, 68, 68, 255),
}

Theme.UI = {
	BgDark = Color3.fromRGB(15, 23, 42),
	BgPanel = Color3.fromRGB(24, 32, 48),
	BgCard = Color3.fromRGB(30, 41, 59),
	BgHover = Color3.fromRGB(51, 65, 85),
	Border = Color3.fromRGB(71, 85, 105),
	AccentBlue = Color3.fromRGB(37, 99, 235),
	AccentGreen = Color3.fromRGB(22, 163, 74),
	AccentGold = Color3.fromRGB(245, 158, 11),
	AccentRed = Color3.fromRGB(220, 38, 38),
	AccentPurple = Color3.fromRGB(124, 58, 237),
	TextPrimary = Color3.fromRGB(248, 250, 252),
	TextMuted = Color3.fromRGB(148, 163, 184),
}

return Theme
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000107"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
-- Complete type definitions for OpenFront Roblox 1:1 Port (Full-Scale Edition)

export type PlayerType = "Human" | "Nation" | "Bot"
export type Difficulty = "Easy" | "Medium" | "Hard" | "Impossible"
export type GameMode = "FFA" | "Teams"
export type DoomsdaySpeed = "slow" | "normal" | "fast" | "veryfast"

export type UnitType =
	"City"
	| "Port"
	| "Factory"
	| "DefensePost"
	| "MissileSilo"
	| "SAMLauncher"
	| "Warship"
	| "TransportShip"
	| "TradeShip"
	| "Train"
	| "AtomBomb"
	| "HydrogenBomb"
	| "MIRV"
	| "MIRVWarhead"
	| "SAMMissile"
	| "Shell"

export type TerrainKind = "Water" | "Plains" | "Highland" | "Mountain" | "Impassable"

export type GameConfig = {
	mapId: string,
	mode: GameMode,
	numTeams: number, -- 0 for FFA, 2/3/4/5/6/7 for Teams, -1 for Humans vs Nations
	difficulty: Difficulty,
	bots: number,
	spawnNations: boolean,
	instantBuild: boolean,
	infiniteGold: boolean,
	infiniteTroops: boolean,
	startingGold: number,
	goldMultiplier: number,
	disableAlliances: boolean,
	allianceDurationMinutes: number,
	donateGold: boolean,
	donateTroops: boolean,
	randomSpawn: boolean,
	waterNukes: boolean,
	doomsdayEnabled: boolean,
	doomsdaySpeed: DoomsdaySpeed,
	overtimeEnabled: boolean,
	overtimeStartMinutes: number,
	singleplayer: boolean,
	seed: number?,
}

export type PlayerProfileSave = {
	xp: number,
	level: number,
	prestige: number,
	wins: number,
	gamesPlayed: number,
	tilesConquered: number,
	nukesLaunched: number,
	goldEarnedTotal: number,
	flag: string,
	colorIndex: number,
	patternId: string,
	defaultAttackRatio: number,
	colorblindMode: boolean,
	preferScanline2D: boolean,
	showNames: boolean,
	soundVolume: number,
}

export type AttackSummary = {
	id: number,
	attackerSmallId: number,
	targetSmallId: number, -- 0 = Terra Nullius
	troops: number,
	retreating: boolean,
	isBoat: boolean,
}

export type UnitSummary = {
	id: number,
	unitType: UnitType,
	ownerSmallId: number,
	x: number,
	y: number,
	srcX: number,
	srcY: number,
	dstX: number,
	dstY: number,
	patrolX: number?,
	patrolY: number?,
	level: number,
	hp: number,
	maxHp: number,
	veterancy: number,
	underConstruction: boolean,
	constructionProgress: number,
	onCooldown: boolean?,
	cooldownProgress: number?,
	troops: number,
	progress: number, -- 0..1 flight progress for parabolic projectiles
}

export type PlayerSummary = {
	smallId: number,
	userId: number, -- &gt;0 for Roblox Player, &lt;=0 for AI Nation / Bot
	playerType: PlayerType,
	name: string,
	flag: string,
	colorHex: string,
	patternId: string,
	team: string?,
	alive: boolean,
	hasSpawned: boolean,
	spawnX: number,
	spawnY: number,
	labelX: number,
	labelY: number,
	labelSpan: number,
	tilesOwned: number,
	troops: number,
	maxTroops: number,
	troopRatePerSec: number,
	attackingTroops: number,
	gold: number,
	goldEarned: number?,
	isTraitor: boolean,
	traitorTicksLeft: number?,
	isDoomed: boolean,
	allies: { number },
	embargoes: { number },
	emoji: string?,
	emojiTicksLeft: number?,
	targetedBy: { number },
	nukesSent: number?,
	unitCounts: { [string]: number }?,
}

export type ActionableAlert = {
	id: number,
	kind: "AllianceRequest" | "AllianceExpiring" | "NukeInbound",
	fromSmallId: number,
	fromName: string,
	unitType: string?,
	targetX: number?,
	targetY: number?,
	expiresTick: number,
}

export type EventFeedItem = {
	id: number,
	kind: "info" | "conquest" | "alliance" | "betrayal" | "nuke" | "trade" | "donate" | "chat",
	text: string,
	colorHex: string,
	targetX: number?,
	targetY: number?,
	tick: number,
}

export type FloatingPopup = {
	x: number,
	y: number,
	text: string,
	colorHex: string,
}

return {}
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX000108"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000109"><Properties><string name="Name">OpenFrontServer</string></Properties><Item class="ModuleScript" referent="RBX000110"><Properties><string name="Name">AiBrain</string><ProtectedString name="Source">--!native
--!strict
-- Full-Scale OpenFront AI Brain (`AiBrain.luau` — 100% Seeded Deterministic `engine:_Rand()`)
-- Supports ALL 24 full-resolution maps (`1000x1000` .. `4108x1948` / `107` nations):
--   1. Fast Terra Nullius continent &amp; island expansion
--   2. Cross-Ocean Amphibious TransportShip Invasions (`SameWaterBody` O(1) reachability!)
--   3. Sovereign Nation Infrastructure (Cities, Ports, Factories, DefensePosts, Warships, SAMs, Silos)
--   4. Coalition Deterrence against runaway #1 leader + Traitor dogpiling + Nuclear Retaliation!

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")
local Config = require(Shared:WaitForChild("Config"))
local MapCodec = require(Shared:WaitForChild("MapCodec"))

local AiBrain = {}

local function pickOwnedTile(engine: any, p: any, requireShore: boolean): number?
	local map = engine.map
	local w = map.width
	local borderList = p.borderList
	if requireShore then
		local count = #borderList
		if count == 0 then
			return nil
		end
		local startIdx = engine:_RandInt(1, count)
		for step = 0, math.min(count - 1, 120) do
			local ref = borderList[((startIdx + step - 1) % count) + 1]
			if MapCodec.GetOwner(map, ref) == p.smallId and MapCodec.IsShoreLand(map, ref) then
				if engine:CanPlaceStructureNear(p, ref) then
					return ref
				end
			end
		end
		return nil
	end

	local spread = math.max(24, math.floor(42 * Config.MapScaleFactor(w)))
	local lx = math.clamp(math.floor(p.labelX), 0, w - 1)
	local ly = math.clamp(math.floor(p.labelY), 0, map.height - 1)
	for _ = 1, 30 do
		local ox = math.clamp(lx + engine:_RandInt(-spread, spread), 0, w - 1)
		local oy = math.clamp(ly + engine:_RandInt(-spread, spread), 0, map.height - 1)
		local ref = oy * w + ox
		if MapCodec.GetOwner(map, ref) == p.smallId and MapCodec.IsPlayableLand(map, ref) then
			if engine:CanPlaceStructureNear(p, ref) then
				return ref
			end
		end
	end
	return nil
end

local function runNationEconomyAndWarships(engine: any, p: any)
	local cfg = engine.config
	local isHuman = false
	local cities = p.unitCounts["City"] or 0
	local ports = p.unitCounts["Port"] or 0
	local factories = p.unitCounts["Factory"] or 0
	local posts = p.unitCounts["DefensePost"] or 0
	local silos = p.unitCounts["MissileSilo"] or 0
	local sams = p.unitCounts["SAMLauncher"] or 0
	local warships = p.unitCounts["Warship"] or 0

	if ports &lt; 2 and p.tilesOwned &gt; 80 then
		local portCost = Config.UnitCost("Port", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
		if p.gold &gt;= portCost then
			local shoreRef = pickOwnedTile(engine, p, true)
			if shoreRef ~= nil then
				engine:BuildUnit(p, "Port", shoreRef)
				return
			end
		end
	end

	if cities &lt;= factories + 1 and p.tilesOwned &gt; 60 then
		local cityCost = Config.UnitCost("City", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
		if p.gold &gt;= cityCost * 1.05 then
			local ref = pickOwnedTile(engine, p, false)
			if ref ~= nil then
				engine:BuildUnit(p, "City", ref)
				return
			end
		end
	end

	if factories &lt; 3 and cities &gt;= 1 and p.tilesOwned &gt; 140 then
		local facCost = Config.UnitCost("Factory", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
		if p.gold &gt;= facCost * 1.1 then
			local ref = pickOwnedTile(engine, p, false)
			if ref ~= nil then
				engine:BuildUnit(p, "Factory", ref)
				return
			end
		end
	end

	if posts &lt; math.min(5, math.floor(p.tilesOwned / 900) + 1) and #p.borderList &gt; 8 then
		local dpCost = Config.UnitCost("DefensePost", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
		if p.gold &gt;= dpCost * 1.25 then
			local bRef = p.borderList[engine:_RandInt(1, #p.borderList)]
			if bRef ~= nil and engine:CanPlaceStructureNear(p, bRef) then
				engine:BuildUnit(p, "DefensePost", bRef)
				return
			end
		end
	end

	if ports &gt;= 1 and warships &lt; 3 and cfg.difficulty ~= "Easy" then
		local wsCost = Config.UnitCost("Warship", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
		if p.gold &gt;= wsCost * 1.2 then
			local portUnit = engine:FindFirstOwnedUnit(p.smallId, "Port")
			if portUnit ~= nil then
				local waterRef = MapCodec.AdjacentWater(engine.map, portUnit.y * engine.map.width + portUnit.x)
				if waterRef ~= nil then
					engine:BuildUnit(p, "Warship", waterRef)
					return
				end
			end
		end
	end

	if sams &lt; 2 and p.tilesOwned &gt; 250 then
		local samCost = Config.UnitCost("SAMLauncher", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
		if p.gold &gt;= samCost then
			local ref = pickOwnedTile(engine, p, false)
			if ref ~= nil then
				engine:BuildUnit(p, "SAMLauncher", ref)
				return
			end
		end
	end

	if silos &lt; 1 and p.tilesOwned &gt; 300 and cfg.difficulty ~= "Easy" then
		local siloCost = Config.UnitCost("MissileSilo", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
		if p.gold &gt;= siloCost then
			local ref = pickOwnedTile(engine, p, false)
			if ref ~= nil then
				engine:BuildUnit(p, "MissileSilo", ref)
				return
			end
		end
	end

	if silos &gt;= 1 then
		local bestEnemy = engine:PickHostileTargetForNuke(p)
		if bestEnemy ~= nil then
			local mirvCost = Config.UnitCost("MIRV", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
			local hCost = Config.UnitCost("HydrogenBomb", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
			local aCost = Config.UnitCost("AtomBomb", p.unitCounts, engine.mirvsLaunched, cfg.infiniteGold, isHuman)
			local targetRef = math.clamp(math.floor(bestEnemy.labelY), 0, engine.map.height - 1) * engine.map.width
				+ math.clamp(math.floor(bestEnemy.labelX), 0, engine.map.width - 1)
			if p.gold &gt;= mirvCost and bestEnemy.tilesOwned &gt; 900 then
				engine:BuildUnit(p, "MIRV", targetRef)
			elseif p.gold &gt;= hCost and engine:_Rand() &lt; 0.45 then
				engine:BuildUnit(p, "HydrogenBomb", targetRef)
			elseif p.gold &gt;= aCost * 1.15 then
				engine:BuildUnit(p, "AtomBomb", targetRef)
			end
		end
	end
end

function AiBrain.StepAll(engine: any, tick: number)
	local map = engine.map
	local nbuf = { 0, 0, 0, 0 }
	local topLeader: any = nil
	for _, cand in ipairs(engine.playersList) do
		if cand.alive and (topLeader == nil or cand.tilesOwned &gt; topLeader.tilesOwned) then
			topLeader = cand
		end
	end

	for _, p in ipairs(engine.playersList) do
		if not p.alive or p.playerType == "Human" then
			continue
		end
		if tick % p.aiCadence ~= p.aiOffset then
			continue
		end

		local maxT = engine:GetMaxTroops(p)
		local troopFrac = p.troops / math.max(1, maxT)

		local bordersTerraNullius = false
		local neighborCounts: { [number]: number } = {}
		local shoreTiles: { number } = {}
		local bLen = #p.borderList
		local sampleCount = math.min(bLen, 72)
		if sampleCount &gt; 0 then
			local startIdx = engine:_RandInt(1, bLen)
			for s = 0, sampleCount - 1 do
				local bRef = p.borderList[((startIdx + s - 1) % bLen) + 1]
				if MapCodec.GetOwner(map, bRef) == p.smallId then
					local n = MapCodec.Neighbors4(map, bRef, nbuf)
					for i = 1, n do
						local nb = nbuf[i]
						if MapCodec.IsPlayableLand(map, nb) then
							local oid = MapCodec.GetOwner(map, nb)
							if oid == 0 then
								bordersTerraNullius = true
							elseif oid ~= p.smallId then
								neighborCounts[oid] = (neighborCounts[oid] or 0) + 1
							end
						elseif MapCodec.IsWater(map, nb) and #shoreTiles &lt; 12 then
							table.insert(shoreTiles, bRef)
						end
					end
				end
			end
		end

		-- Priority 1: Sweep adjacent unclaimed Terra Nullius rapidly!
		if bordersTerraNullius and p.troops &gt; 200 and troopFrac &gt; 0.08 then
			local ratio = if p.playerType == "Nation" then 0.44 else 0.32
			engine:StartLandAttack(p, 0, math.floor(p.troops * ratio))
			continue
		end

		if p.playerType == "Nation" then
			runNationEconomyAndWarships(engine, p)

			if not engine.config.disableAlliances and engine:_Rand() &lt; 0.04 then
				for nid, _ in pairs(neighborCounts) do
					local other = engine.playersBySmallId[nid]
					if
						other ~= nil
						and other.alive
						and other.playerType == "Human"
						and not engine:AreFriendly(p, other)
						and (p.relations[nid] or 0) &gt; -20
					then
						engine:SendAllianceRequest(p, other)
						break
					end
				end
			end
		end

		-- Priority 2: Land Frontier War + Coalition Anti-Leader Deterrence!
		local reserveThreshold = if p.playerType == "Bot" then 0.54 else p.aiTriggerRatio
		if troopFrac &gt;= reserveThreshold then
			local bestTarget: any = nil
			local bestScore = -1e9
			for nid, _ in pairs(neighborCounts) do
				local other = engine.playersBySmallId[nid]
				if other ~= nil and other.alive and not engine:AreFriendly(p, other) then
					local rel = p.relations[nid] or 0
					local score = (p.troops / math.max(500, other.troops)) * 50 - rel * 0.6
					if other.isTraitor then
						score += 120
					end
					if other.playerType == "Bot" then
						score += 35
					end
					if topLeader ~= nil and other.smallId == topLeader.smallId and other.tilesOwned &gt; map.numLandTiles * 0.22 then
						score += 85
					end
					if score &gt; bestScore then
						bestScore = score
						bestTarget = other
					end
				end
			end

			if bestTarget ~= nil and (bestScore &gt; 26 or troopFrac &gt; 0.84) then
				local sendFrac = if p.playerType == "Bot" then 0.22 else 0.32
				engine:StartLandAttack(p, bestTarget.smallId, math.floor(p.troops * sendFrac))
				if p.playerType == "Nation" and bestTarget.isTraitor and engine:_Rand() &lt; 0.25 then
					engine:SetEmoji(p, "😡")
				end
				continue
			end
		end

		-- Priority 3: Cross-Ocean Amphibious Landing across `SameWaterBody` (Islands &amp; Archipelagos thrive!)
		if
			#shoreTiles &gt; 0
			and troopFrac &gt; 0.52
			and (p.unitCounts["TransportShip"] or 0) == 0
			and (p.playerType == "Nation" and engine:_Rand() &lt; 0.35 or engine:_Rand() &lt; 0.12)
		then
			local srcShore = shoreTiles[engine:_RandInt(1, #shoreTiles)]
			local srcWater = MapCodec.AdjacentWater(map, srcShore)
			if srcWater ~= nil then
				local sx = srcShore % map.width
				local sy = math.floor(srcShore / map.width)
				local maxHop = math.max(180, math.floor(map.width * 0.22))
				for attempt = 1, 14 do
					local span = if attempt &lt;= 18 then math.floor(maxHop * 0.45) else maxHop
					local tx = sx + engine:_RandInt(-span, span)
					if map.wrapX then
						tx = tx % map.width
					else
						tx = math.clamp(tx, 0, map.width - 1)
					end
					local ty = math.clamp(sy + engine:_RandInt(-math.floor(span * 0.65), math.floor(span * 0.65)), 0, map.height - 1)
					local tref = ty * map.width + tx
					if MapCodec.IsShoreLand(map, tref) then
						local toid = MapCodec.GetOwner(map, tref)
						local targetOwner = if toid &gt; 0 then engine.playersBySmallId[toid] else nil
						if toid ~= p.smallId and (targetOwner == nil or not engine:AreFriendly(p, targetOwner)) then
							local dw = MapCodec.AdjacentWater(map, tref)
							if dw ~= nil and MapCodec.SameWaterBody(map, srcWater, dw) then
								if engine:LaunchBoatAttack(p, tref, math.floor(p.troops * 0.28)) then
									break
								end
							end
						end
					end
				end
			end
		end
	end
end

return AiBrain
</ProtectedString></Properties></Item><Item class="Script" referent="RBX000111"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source">--!native
--!strict
-- Security-Hardened OpenFront Authoritative Match Server (`Bootstrap.server.luau`)
-- Supports ALL 24 Full-Scale 1:1 OpenFront Maps (`1000x1000` .. `4108x1948`) with:
--   - Pure 2D workspace cleanup (`CharacterAutoLoads = false`)
--   - Sliding-window per-player RemoteEvent Rate Limiter (`&lt;= 45 intents/sec` anti-flood protection!)
--   - Strict `Config.IsFiniteNumber` sanitization on EVERY GameConfig &amp; ClientIntent parameter (`zero NaN/Inf bugs!`)
--   - Host / Singleplayer / Studio authorization for `StartMatchNow` &amp; `SimControl` (`1x`/`2x`/`4x`/Pause)
--   - XP anti-exploit gate (`xpEligible = false` when cheat flags are active)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

Players.CharacterAutoLoads = false
for _, child in ipairs(Workspace:GetChildren()) do
	if child:IsA("BasePart") or child:IsA("SpawnLocation") or child:IsA("Model") then
		child:Destroy()
	end
end

local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")
local Config = require(Shared:WaitForChild("Config"))
local MapRegistry = require(Shared:WaitForChild("Maps"):WaitForChild("MapRegistry"))
local Theme = require(Shared:WaitForChild("Theme"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local SimEngine = require(script.Parent:WaitForChild("SimEngine"))

local Remotes = ReplicatedStorage:FindFirstChild("OpenFrontRemotes")
if Remotes == nil then
	Remotes = Instance.new("Folder")
	Remotes.Name = "OpenFrontRemotes"
	Remotes.Parent = ReplicatedStorage
end

local function makeRemoteEvent(name: string): RemoteEvent
	local existing = Remotes:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = Remotes
	return re
end

local function makeRemoteFunction(name: string): RemoteFunction
	local existing = Remotes:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end
	local rf = Instance.new("RemoteFunction")
	rf.Name = name
	rf.Parent = Remotes
	return rf
end

local ClientIntentRE = makeRemoteEvent("ClientIntent")
local StateSyncRE = makeRemoteEvent("StateSync")
local LobbySyncRE = makeRemoteEvent("LobbySync")
local MatchResultRE = makeRemoteEvent("MatchResult")
local ProfileSyncRE = makeRemoteEvent("ProfileSync")
local GetInitialStateRF = makeRemoteFunction("GetInitialState")

-- Sliding-window per-player rate limiter (`&lt;= 45 intents/sec`)
local rateWindowStart: { [number]: number } = {}
local rateCount: { [number]: number } = {}
local hostUserId = 0

local function allowIntentRate(uid: number): boolean
	local now = os.clock()
	local wStart = rateWindowStart[uid] or 0
	if now - wStart &gt;= 1.0 then
		rateWindowStart[uid] = now
		rateCount[uid] = 1
		return true
	end
	local c = (rateCount[uid] or 0) + 1
	rateCount[uid] = c
	return c &lt;= 45
end

local FEATURED_ROTATION = {
	{ mapId = "World", mode = "FFA", numTeams = 0 },
	{ mapId = "Europe", mode = "Teams", numTeams = 2 },
	{ mapId = "NorthAmerica", mode = "FFA", numTeams = 0 },
	{ mapId = "ShinobiWorld", mode = "FFA", numTeams = 0 },
	{ mapId = "GiantWorldMap", mode = "Teams", numTeams = 4 },
	{ mapId = "IndianSubcontinent", mode = "FFA", numTeams = 0 },
	{ mapId = "Asia", mode = "Teams", numTeams = 3 },
	{ mapId = "Caribbean", mode = "FFA", numTeams = 0 },
}

local rotationIndex = 1
local publicQueueUsers: { [number]: boolean } = {}
local lobbyCountdown = 15

local activeEngine: any = nil
local activeMode: "Preview" | "LiveMatch" = "Preview"
local postGameCooldown = 0
local xpEligible = true

local function isHostAuthorized(plr: Player): boolean
	return RunService:IsStudio() or #Players:GetPlayers() &lt;= 1 or hostUserId == 0 or plr.UserId == hostUserId
end

local function buildHumanList(selectedPlayers: { Player })
	local out = {}
	for _, plr in ipairs(selectedPlayers) do
		local prof = DataService.GetProfile(plr.UserId)
		local palette = if prof.colorblindMode then Theme.ColorblindColors else Theme.HumanColors
		local col = palette[((prof.colorIndex - 1) % #palette) + 1]
		table.insert(out, {
			userId = plr.UserId,
			name = plr.DisplayName ~= "" and plr.DisplayName or plr.Name,
			flag = prof.flag,
			colorHex = col,
			patternId = prof.patternId,
		})
	end
	return out
end

local function startPreviewBattle()
	activeMode = "Preview"
	local previewCfg = Config.DefaultGameConfig(true)
	previewCfg.mapId = FEATURED_ROTATION[rotationIndex].mapId
	previewCfg.bots = 30
	previewCfg.goldMultiplier = 3
	previewCfg.seed = 42000 + rotationIndex
	activeEngine = SimEngine.new(previewCfg, {}, true)
	for _ = 1, 25 do
		activeEngine:Step()
	end
	StateSyncRE:FireAllClients(activeEngine:BuildTickPayload(true))
end

local function startLiveMatch(cfg: any, participants: { Player })
	activeMode = "LiveMatch"
	postGameCooldown = 0
	xpEligible = not (cfg.infiniteGold or cfg.infiniteTroops or cfg.instantBuild or cfg.startingGold &gt; 0)
	table.clear(publicQueueUsers)
	local humans = buildHumanList(participants)
	activeEngine = SimEngine.new(cfg, humans, false)
	StateSyncRE:FireAllClients(activeEngine:BuildTickPayload(true))
end

local function broadcastLobbyState()
	local slot = FEATURED_ROTATION[rotationIndex]
	local mapDef = MapRegistry.Get(slot.mapId)
	local queuedNames = {}
	for uid, queued in pairs(publicQueueUsers) do
		if queued then
			local plr = Players:GetPlayerByUserId(uid)
			if plr then
				table.insert(queuedNames, plr.DisplayName ~= "" and plr.DisplayName or plr.Name)
			end
		end
	end
	LobbySyncRE:FireAllClients({
		activeMode = activeMode,
		nextMapId = slot.mapId,
		nextMapName = mapDef.name,
		nextMode = slot.mode,
		nextNumTeams = slot.numTeams,
		countdown = lobbyCountdown,
		queuedPlayers = queuedNames,
		onlineCount = #Players:GetPlayers(),
	})
end

local function sanitizeConfig(raw: any): any
	local base = Config.DefaultGameConfig(false)
	if type(raw) ~= "table" then
		return base
	end
	if type(raw.mapId) == "string" and MapRegistry.ById[raw.mapId] ~= nil then
		base.mapId = raw.mapId
	end
	if raw.mode == "FFA" or raw.mode == "Teams" then
		base.mode = raw.mode
	end
	base.numTeams = math.floor(Config.SafeClampNumber(raw.numTeams, -1, 7, base.numTeams))
	if raw.difficulty == "Easy" or raw.difficulty == "Medium" or raw.difficulty == "Hard" or raw.difficulty == "Impossible" then
		base.difficulty = raw.difficulty
	end
	base.bots = math.floor(Config.SafeClampNumber(raw.bots, 0, 180, base.bots))
	if type(raw.spawnNations) == "boolean" then
		base.spawnNations = raw.spawnNations
	end
	if type(raw.instantBuild) == "boolean" then
		base.instantBuild = raw.instantBuild
	end
	if type(raw.infiniteGold) == "boolean" then
		base.infiniteGold = raw.infiniteGold
	end
	if type(raw.infiniteTroops) == "boolean" then
		base.infiniteTroops = raw.infiniteTroops
	end
	base.startingGold = math.floor(Config.SafeClampNumber(raw.startingGold, 0, 50_000_000, base.startingGold))
	base.goldMultiplier = Config.SafeClampNumber(raw.goldMultiplier, 0.5, 20, base.goldMultiplier)
	if type(raw.disableAlliances) == "boolean" then
		base.disableAlliances = raw.disableAlliances
	end
	base.allianceDurationMinutes = math.floor(Config.SafeClampNumber(raw.allianceDurationMinutes, 1, 15, base.allianceDurationMinutes))
	if type(raw.donateGold) == "boolean" then
		base.donateGold = raw.donateGold
	end
	if type(raw.donateTroops) == "boolean" then
		base.donateTroops = raw.donateTroops
	end
	if type(raw.randomSpawn) == "boolean" then
		base.randomSpawn = raw.randomSpawn
	end
	if type(raw.waterNukes) == "boolean" then
		base.waterNukes = raw.waterNukes
	end
	if type(raw.doomsdayEnabled) == "boolean" then
		base.doomsdayEnabled = raw.doomsdayEnabled
	end
	if raw.doomsdaySpeed == "slow" or raw.doomsdaySpeed == "normal" or raw.doomsdaySpeed == "fast" or raw.doomsdaySpeed == "veryfast" then
		base.doomsdaySpeed = raw.doomsdaySpeed
	end
	if type(raw.overtimeEnabled) == "boolean" then
		base.overtimeEnabled = raw.overtimeEnabled
	end
	if type(raw.singleplayer) == "boolean" then
		base.singleplayer = raw.singleplayer
	end
	base.seed = math.floor(Config.SafeClampNumber(raw.seed, 1, 2_147_483_647, math.floor(os.clock() * 1000) % 1_000_000 + 1337))
	return base
end

GetInitialStateRF.OnServerInvoke = function(plr: Player)
	local prof = DataService.LoadProfile(plr.UserId)
	return {
		profile = prof,
		snapshot = if activeEngine ~= nil then activeEngine:BuildTickPayload(true) else nil,
	}
end

ClientIntentRE.OnServerEvent:Connect(function(plr: Player, intentType: any, payload: any)
	if type(intentType) ~= "string" then
		return
	end
	local uid = plr.UserId
	if not allowIntentRate(uid) then
		return
	end

	if intentType == "UpdateProfile" and type(payload) == "table" then
		local updated = DataService.UpdatePreferences(uid, payload)
		ProfileSyncRE:FireClient(plr, updated)
		return
	elseif intentType == "ToggleQueue" then
		publicQueueUsers[uid] = not publicQueueUsers[uid]
		broadcastLobbyState()
		return
	elseif intentType == "StartMatchNow" then
		if not isHostAuthorized(plr) then
			return
		end
		local cfg = sanitizeConfig(payload)
		local participants = Players:GetPlayers()
		startLiveMatch(cfg, participants)
		broadcastLobbyState()
		return
	elseif intentType == "SimControl" and type(payload) == "table" then
		if activeEngine ~= nil and isHostAuthorized(plr) then
			if type(payload.paused) == "boolean" then
				activeEngine.paused = payload.paused
			end
			local spd = payload.speed or payload.simSpeed
			if Config.IsFiniteNumber(spd) then
				activeEngine.simSpeed = math.clamp(math.floor(spd), 1, 4)
			end
		end
		return
	elseif intentType == "StartSpawnNow" then
		if activeEngine ~= nil and activeEngine.inSpawnPhase and isHostAuthorized(plr) then
			activeEngine.ticks = activeEngine.spawnPhaseTicks - 1
		end
		return
	elseif intentType == "ReturnToLobby" then
		if activeMode == "LiveMatch" and activeEngine ~= nil then
			local otherAliveHumans = false
			for _, p in ipairs(activeEngine.playersList) do
				if p.playerType == "Human" and p.userId ~= uid and p.alive then
					otherAliveHumans = true
					break
				end
			end
			if not otherAliveHumans or activeEngine.gameOver then
				startPreviewBattle()
				broadcastLobbyState()
			end
		end
		return
	end

	if activeMode ~= "LiveMatch" or activeEngine == nil or type(payload) ~= "table" then
		return
	end

	if intentType == "ChooseSpawn" then
		if Config.IsFiniteNumber(payload.x) and Config.IsFiniteNumber(payload.y) then
			activeEngine:ChooseSpawn(uid, payload.x, payload.y)
		end
		return
	end

	local me = activeEngine.playersByUserId[uid]
	if me == nil or not me.alive then
		return
	end

	if intentType == "AttackLand" then
		if Config.IsFiniteNumber(payload.targetSmallId) then
			local targetSmallId = math.floor(payload.targetSmallId)
			local ratio = Config.SafeClampNumber(payload.ratio, 0.01, 1.0, 0.25)
			activeEngine:StartLandAttack(me, targetSmallId, me.troops * ratio, nil)
		end
	elseif intentType == "BoatAttack" then
		if Config.IsFiniteNumber(payload.x) and Config.IsFiniteNumber(payload.y) then
			local x = math.clamp(math.floor(payload.x), 0, activeEngine.map.width - 1)
			local y = math.clamp(math.floor(payload.y), 0, activeEngine.map.height - 1)
			local ratio = Config.SafeClampNumber(payload.ratio, 0.01, 1.0, 0.25)
			activeEngine:LaunchBoatAttack(me, y * activeEngine.map.width + x, me.troops * ratio)
		end
	elseif intentType == "Retreat" then
		local atkId = if Config.IsFiniteNumber(payload.attackId) then math.floor(payload.attackId) else nil
		activeEngine:RetreatAttack(me, atkId)
	elseif intentType == "RetreatBoats" then
		activeEngine:RetreatBoats(me)
	elseif intentType == "BuildUnit" then
		if type(payload.unitType) == "string" and Config.IsFiniteNumber(payload.x) and Config.IsFiniteNumber(payload.y) then
			local x = math.clamp(math.floor(payload.x), 0, activeEngine.map.width - 1)
			local y = math.clamp(math.floor(payload.y), 0, activeEngine.map.height - 1)
			activeEngine:BuildUnit(me, payload.unitType :: any, y * activeEngine.map.width + x)
		end
	elseif intentType == "UpgradeStructure" then
		if Config.IsFiniteNumber(payload.unitId) then
			activeEngine:UpgradeStructure(me, math.floor(payload.unitId))
		end
	elseif intentType == "DeleteStructure" then
		if Config.IsFiniteNumber(payload.unitId) then
			activeEngine:DeleteStructure(me, math.floor(payload.unitId))
		end
	elseif intentType == "MoveWarship" then
		if Config.IsFiniteNumber(payload.unitId) and Config.IsFiniteNumber(payload.x) and Config.IsFiniteNumber(payload.y) then
			activeEngine:MoveWarship(me, math.floor(payload.unitId), payload.x, payload.y)
		end
	elseif intentType == "AllianceRequest" then
		if Config.IsFiniteNumber(payload.targetSmallId) then
			local other = activeEngine.playersBySmallId[math.floor(payload.targetSmallId)]
			if other ~= nil then
				activeEngine:SendAllianceRequest(me, other)
			end
		end
	elseif intentType == "RespondAlliance" then
		if Config.IsFiniteNumber(payload.fromSmallId) then
			local fromId = math.floor(payload.fromSmallId)
			local other = activeEngine.playersBySmallId[fromId]
			local alerts = activeEngine.alertsByPlayer[me.smallId] or {}
			local foundValid = false
			for i = #alerts, 1, -1 do
				if alerts[i].fromSmallId == fromId and alerts[i].kind ~= "NukeInbound" then
					foundValid = true
					table.remove(alerts, i)
				end
			end
			if other ~= nil and foundValid and payload.accept == true then
				activeEngine:FormAlliance(me, other)
			end
		end
	elseif intentType == "DismissAlert" then
		if Config.IsFiniteNumber(payload.alertId) then
			local alertId = math.floor(payload.alertId)
			local alerts = activeEngine.alertsByPlayer[me.smallId] or {}
			for i = #alerts, 1, -1 do
				if alerts[i].id == alertId then
					table.remove(alerts, i)
				end
			end
		end
	elseif intentType == "BreakAlliance" then
		if Config.IsFiniteNumber(payload.targetSmallId) then
			local other = activeEngine.playersBySmallId[math.floor(payload.targetSmallId)]
			if other ~= nil then
				activeEngine:BreakAlliance(me, other)
			end
		end
	elseif intentType == "ToggleEmbargo" then
		if Config.IsFiniteNumber(payload.targetSmallId) then
			local targetId = math.floor(payload.targetSmallId)
			if targetId == -1 then
				local hasAny = next(me.embargoes) ~= nil
				table.clear(me.embargoes)
				if not hasAny then
					for _, other in ipairs(activeEngine.playersList) do
						if other ~= me and not activeEngine:AreFriendly(me, other) then
							me.embargoes[other.smallId] = true
						end
					end
				end
			elseif targetId &gt; 0 then
				if me.embargoes[targetId] then
					me.embargoes[targetId] = nil
				else
					me.embargoes[targetId] = true
				end
			end
		end
	elseif intentType == "Donate" then
		if Config.IsFiniteNumber(payload.targetSmallId) and Config.IsFiniteNumber(payload.amount) then
			local other = activeEngine.playersBySmallId[math.floor(payload.targetSmallId)]
			if other ~= nil then
				local kind: "gold" | "troops" = if payload.kind == "gold" then "gold" else "troops"
				activeEngine:DonateResources(me, other, kind, payload.amount)
			end
		end
	elseif intentType == "TargetPlayer" then
		if Config.IsFiniteNumber(payload.targetSmallId) then
			local other = activeEngine.playersBySmallId[math.floor(payload.targetSmallId)]
			if other ~= nil and activeEngine.ticks - me.lastTargetTick &gt;= Config.TARGET_COOLDOWN_TICKS then
				me.lastTargetTick = activeEngine.ticks
				other.targetedBy[me.smallId] = activeEngine.ticks + Config.TARGET_DURATION_TICKS
				activeEngine:PushEvent("chat", "🎯 " .. me.name .. " marked " .. other.name .. " as a target!", "#ef4444", other.labelX, other.labelY)
			end
		end
	elseif intentType == "SendEmoji" then
		local em = tostring(payload.emoji or "🫡")
		if Config.AllowedEmojis[em] then
			activeEngine:SetEmoji(me, em)
		end
	elseif intentType == "QuickChat" then
		local qcId = tostring(payload.id or "")
		for _, qc in ipairs(Config.QuickChats) do
			if qc.id == qcId then
				activeEngine:PushEvent("chat", "[" .. me.name .. "]: " .. qc.text, qc.color, me.labelX, me.labelY)
				break
			end
		end
	end
end)

Players.PlayerAdded:Connect(function(plr: Player)
	if hostUserId == 0 then
		hostUserId = plr.UserId
	end
	local prof = DataService.LoadProfile(plr.UserId)
	ProfileSyncRE:FireClient(plr, prof)
	broadcastLobbyState()
end)

Players.PlayerRemoving:Connect(function(plr: Player)
	publicQueueUsers[plr.UserId] = nil
	rateWindowStart[plr.UserId] = nil
	rateCount[plr.UserId] = nil
	if plr.UserId == hostUserId then
		local rem = Players:GetPlayers()
		hostUserId = if #rem &gt; 0 then rem[1].UserId else 0
	end
	DataService.ReleaseProfile(plr.UserId)
end)

startPreviewBattle()

local tickCounter = 0
local tickAccumulator = 0.0

local function runAuthoritativeTick()
	tickCounter += 1

	if activeEngine ~= nil then
		local subSteps = if activeEngine.paused then 0 else math.clamp(activeEngine.simSpeed or 1, 1, 4)
		for _ = 1, subSteps do
			activeEngine:Step()
		end

		if activeMode == "LiveMatch" then
			for _, p in ipairs(activeEngine.playersList) do
				if p.playerType == "Human" and not activeEngine.inSpawnPhase and p.hasSpawned and not p.alive and not p.deathNotified then
					p.deathNotified = true
					local plr = Players:GetPlayerByUserId(p.userId)
					if plr ~= nil then
						local peakShare = p.tilesPeak / math.max(1, activeEngine.map.numLandTiles)
						local reward = DataService.RecordMatchResult(
							p.userId,
							false,
							p.tilesPeak,
							peakShare,
							p.nukesSent,
							p.goldEarned,
							p.survivedTicks / Config.TICKS_PER_SECOND,
							xpEligible
						)
						ProfileSyncRE:FireClient(plr, DataService.GetProfile(p.userId))
						MatchResultRE:FireClient(plr, {
							kind = "Eliminated",
							winnerName = activeEngine.winnerName,
							tilesPeak = p.tilesPeak,
							landPctPeak = peakShare * 100,
							nukesSent = p.nukesSent,
							reward = reward,
						})
					end
				end
			end

			if activeEngine.gameOver and postGameCooldown == 0 then
				postGameCooldown = 1
				for _, p in ipairs(activeEngine.playersList) do
					if p.playerType == "Human" and not p.deathNotified then
						p.deathNotified = true
						local isWinner = (activeEngine.winnerSmallId == p.smallId)
							or (p.team ~= nil and activeEngine.winnerTeam == p.team)
						local plr = Players:GetPlayerByUserId(p.userId)
						if plr ~= nil then
							local peakShare = p.tilesPeak / math.max(1, activeEngine.map.numLandTiles)
							local reward = DataService.RecordMatchResult(
								p.userId,
								isWinner,
								p.tilesPeak,
								peakShare,
								p.nukesSent,
								p.goldEarned,
								p.survivedTicks / Config.TICKS_PER_SECOND,
								xpEligible
							)
							ProfileSyncRE:FireClient(plr, DataService.GetProfile(p.userId))
							MatchResultRE:FireClient(plr, {
								kind = if isWinner then "Victory" else "Defeat",
								winnerName = activeEngine.winnerName or p.name,
								tilesPeak = p.tilesPeak,
								landPctPeak = peakShare * 100,
								nukesSent = p.nukesSent,
								reward = reward,
							})
						end
					end
				end
			end
		elseif activeMode == "Preview" and activeEngine.ticks &gt; 1400 then
			rotationIndex = (rotationIndex % #FEATURED_ROTATION) + 1
			startPreviewBattle()
		end

		StateSyncRE:FireAllClients(activeEngine:BuildTickPayload(false))
	end

	if tickCounter % 10 == 0 then
		if activeMode == "Preview" then
			local hasQueued = false
			for _, q in pairs(publicQueueUsers) do
				if q then
					hasQueued = true
					break
				end
			end
			if hasQueued then
				lobbyCountdown -= 1
				if lobbyCountdown &lt;= 0 then
					local slot = FEATURED_ROTATION[rotationIndex]
					local cfg = Config.DefaultGameConfig(false)
					cfg.mapId = slot.mapId
					cfg.mode = slot.mode :: any
					cfg.numTeams = slot.numTeams
					lobbyCountdown = 15
					rotationIndex = (rotationIndex % #FEATURED_ROTATION) + 1
					startLiveMatch(cfg, Players:GetPlayers())
				end
			else
				lobbyCountdown = 12
			end
		end
		broadcastLobbyState()
	end
end

RunService.Heartbeat:Connect(function(dt: number)
	tickAccumulator = math.min(tickAccumulator + dt, 0.5)
	while tickAccumulator &gt;= 0.0999 do
		tickAccumulator -= 0.10
		runAuthoritativeTick()
	end
end)
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="ModuleScript" referent="RBX000112"><Properties><string name="Name">DataService</string><ProtectedString name="Source">--!native
--!strict
-- Hardened Persistent DataStore Profile Manager (`DataService.luau`)
-- Upgraded with:
--   - Exponential retry on `GetAsync` (`3` attempts)
--   - Atomic `UpdateAsync` instead of racy `SetAsync` (`zero concurrent write clobbers!`)
--   - Strict `Config.IsFiniteNumber` sanitization on load, preference update, and match rewards
--   - `game:BindToClose` clean flush so zero XP/Wins are ever lost on shutdown!

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Types = require(Shared:WaitForChild("Types"))

type PlayerProfileSave = Types.PlayerProfileSave

local DataService = {}

local STORE_NAME = "OpenFront_PlayerData_v1"
local profileStore: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		profileStore = result
	end
end

local Profiles: { [number]: PlayerProfileSave } = {}
local DirtyUsers: { [number]: boolean } = {}

function DataService.DefaultProfile(userId: number): PlayerProfileSave
	local colorIdx = ((math.abs(userId) % #Theme.HumanColors) + 1)
	return {
		xp = 0,
		level = 1,
		prestige = 0,
		wins = 0,
		gamesPlayed = 0,
		tilesConquered = 0,
		nukesLaunched = 0,
		goldEarnedTotal = 0,
		flag = "in",
		colorIndex = colorIdx,
		patternId = "none",
		defaultAttackRatio = 0.25,
		colorblindMode = false,
		preferScanline2D = false,
		showNames = true,
		soundVolume = 0.7,
	}
end

function DataService.LoadProfile(userId: number): PlayerProfileSave
	if Profiles[userId] then
		return Profiles[userId]
	end
	local base = DataService.DefaultProfile(userId)
	if profileStore ~= nil and userId &gt; 0 then
		for attempt = 1, 3 do
			local ok, saved = pcall(function()
				return (profileStore :: DataStore):GetAsync("u_" .. tostring(userId))
			end)
			if ok then
				if type(saved) == "table" then
					for k, v in pairs(saved) do
						if (base :: any)[k] ~= nil and type(v) == type((base :: any)[k]) then
							if type(v) ~= "number" or Config.IsFiniteNumber(v) then
								(base :: any)[k] = v
							end
						end
					end
				end
				break
			end
			if attempt &lt; 3 then
				task.wait(0.2 * attempt)
			end
		end
	end
	Profiles[userId] = base
	return base
end

function DataService.GetProfile(userId: number): PlayerProfileSave
	return Profiles[userId] or DataService.LoadProfile(userId)
end

function DataService.UpdatePreferences(userId: number, patch: { [string]: any }): PlayerProfileSave
	local prof = DataService.GetProfile(userId)
	if type(patch) ~= "table" then
		return prof
	end
	if type(patch.flag) == "string" and #patch.flag &lt;= 12 then
		prof.flag = patch.flag
	end
	if Config.IsFiniteNumber(patch.colorIndex) then
		prof.colorIndex = math.clamp(math.floor(patch.colorIndex), 1, #Theme.HumanColors)
	end
	if type(patch.patternId) == "string" and #patch.patternId &lt;= 16 then
		prof.patternId = patch.patternId
	end
	if Config.IsFiniteNumber(patch.defaultAttackRatio) then
		prof.defaultAttackRatio = math.clamp(patch.defaultAttackRatio, 0.05, 1.0)
	end
	if type(patch.colorblindMode) == "boolean" then
		prof.colorblindMode = patch.colorblindMode
	end
	if type(patch.preferScanline2D) == "boolean" then
		prof.preferScanline2D = patch.preferScanline2D
	end
	if type(patch.showNames) == "boolean" then
		prof.showNames = patch.showNames
	end
	if Config.IsFiniteNumber(patch.soundVolume) then
		prof.soundVolume = math.clamp(patch.soundVolume, 0, 1)
	end
	DirtyUsers[userId] = true
	return prof
end

export type MatchRewardResult = {
	xpGained: number,
	prevLevel: number,
	newLevel: number,
	prestige: number,
	isVictory: boolean,
}

function DataService.RecordMatchResult(
	userId: number,
	isVictory: boolean,
	tilesPeak: number,
	landPercentPeak: number,
	nukesSent: number,
	goldEarned: number,
	secondsSurvived: number,
	xpEligible: boolean?
): MatchRewardResult
	local prof = DataService.GetProfile(userId)
	local prevLevel = prof.level
	local safeTiles = math.max(0, math.floor(Config.SafeClampNumber(tilesPeak, 0, 100_000_000, 0)))
	local safeShare = Config.SafeClampNumber(landPercentPeak, 0, 1.0, 0)
	local safeNukes = math.max(0, math.floor(Config.SafeClampNumber(nukesSent, 0, 100_000, 0)))
	local safeGold = math.max(0, math.floor(Config.SafeClampNumber(goldEarned, 0, 1_000_000_000_000, 0)))
	local safeSecs = Config.SafeClampNumber(secondsSurvived, 0, 86_400, 0)

	prof.gamesPlayed += 1
	prof.tilesConquered += safeTiles
	prof.nukesLaunched += safeNukes
	prof.goldEarnedTotal += safeGold
	if isVictory and xpEligible ~= false then
		prof.wins += 1
	end

	local rawXp = 0
	if xpEligible ~= false then
		rawXp = 120
			+ math.floor(math.min(600, safeSecs * 0.8))
			+ math.floor(safeShare * 850)
			+ safeNukes * 45
		if isVictory then
			rawXp = math.floor(rawXp * 2.25 + 500)
		end

		prof.xp += rawXp
		while prof.xp &gt;= Config.XpForNextLevel(prof.level) do
			prof.xp -= Config.XpForNextLevel(prof.level)
			prof.level += 1
			if prof.level &gt; 25 and prof.prestige &lt; 10 then
				prof.level = 1
				prof.prestige += 1
			end
		end
	end

	DataService.SaveProfileAsync(userId)
	return {
		xpGained = rawXp,
		prevLevel = prevLevel,
		newLevel = prof.level,
		prestige = prof.prestige,
		isVictory = isVictory,
	}
end

function DataService.SaveProfileSync(userId: number)
	local prof = Profiles[userId]
	if prof == nil or profileStore == nil or userId &lt;= 0 then
		return
	end
	local copy = table.clone(prof)
	pcall(function()
		(profileStore :: DataStore):UpdateAsync("u_" .. tostring(userId), function(_old)
			return copy
		end)
	end)
	DirtyUsers[userId] = nil
end

function DataService.SaveProfileAsync(userId: number)
	local prof = Profiles[userId]
	if prof == nil or profileStore == nil or userId &lt;= 0 then
		return
	end
	local copy = table.clone(prof)
	DirtyUsers[userId] = nil
	task.spawn(function()
		pcall(function()
			(profileStore :: DataStore):UpdateAsync("u_" .. tostring(userId), function(_old)
				return copy
			end)
		end)
	end)
end

function DataService.ReleaseProfile(userId: number)
	DataService.SaveProfileAsync(userId)
	Profiles[userId] = nil
	DirtyUsers[userId] = nil
end

function DataService.FlushAll()
	for userId, _ in pairs(Profiles) do
		DataService.SaveProfileSync(userId)
	end
end

pcall(function()
	game:BindToClose(function()
		DataService.FlushAll()
	end)
end)

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000113"><Properties><string name="Name">Heap</string><ProtectedString name="Source">--!native
--!strict
-- Exact `--!native` port of OpenFront's FlatBinaryHeap.ts with O(1) `peekPriority()`,
-- empty-dequeue safety, and memory trim on `clear()`.

local Heap = {}
Heap.__index = Heap

export type MinHeap = typeof(setmetatable(
	{} :: {
		tiles: { number },
		pri: { number },
		len: number,
	},
	Heap
))

function Heap.new(): MinHeap
	return setmetatable({
		tiles = table.create(512, 0),
		pri = table.create(512, 0),
		len = 0,
	}, Heap)
end

function Heap.size(self: MinHeap): number
	return self.len
end

function Heap.peekPriority(self: MinHeap): number?
	if self.len &lt;= 0 then
		return nil
	end
	return self.pri[1]
end

function Heap.clear(self: MinHeap)
	self.len = 0
	if #self.tiles &gt; 4096 then
		self.tiles = table.create(512, 0)
		self.pri = table.create(512, 0)
	end
end

function Heap.enqueue(self: MinHeap, tile: number, priority: number)
	local idx = self.len + 1
	self.len = idx
	local tiles = self.tiles
	local pri = self.pri
	tiles[idx] = tile
	pri[idx] = priority
	while idx &gt; 1 do
		local parent = bit32.rshift(idx, 1)
		if pri[parent] &lt;= priority then
			break
		end
		tiles[idx] = tiles[parent]
		pri[idx] = pri[parent]
		tiles[parent] = tile
		pri[parent] = priority
		idx = parent
	end
end

function Heap.dequeue(self: MinHeap): number?
	local n = self.len
	if n &lt;= 0 then
		return nil
	end
	local tiles = self.tiles
	local pri = self.pri
	local top = tiles[1]
	local lastTile = tiles[n]
	local lastPri = pri[n]
	n -= 1
	self.len = n
	if n &gt; 0 then
		local idx = 1
		local half = bit32.rshift(n, 1)
		while idx &lt;= half do
			local left = bit32.lshift(idx, 1)
			local right = left + 1
			local smallest = left
			local smallPri = pri[left]
			if right &lt;= n and pri[right] &lt; smallPri then
				smallest = right
				smallPri = pri[right]
			end
			if lastPri &lt;= smallPri then
				break
			end
			tiles[idx] = tiles[smallest]
			pri[idx] = smallPri
			idx = smallest
		end
		tiles[idx] = lastTile
		pri[idx] = lastPri
	end
	return top
end

return Heap
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000114"><Properties><string name="Name">SimEngine</string><ProtectedString name="Source">--!native
--!strict
-- Authoritative Full-Scale 1:1 OpenFront 10Hz Simulation Engine (`SimEngine.luau`)
-- Engineered for ALL 24 full-resolution maps (`1000x1000` .. `4108x1948` = `8,002,384` tiles &amp; up to `107` nations!):
--   - Deterministic `Mulberry32` seeded PRNG (`self:_Rand()`, `self:_RandInt()`) — 0 unseeded `math.random` calls!
--   - Iterative non-recursive concave border fill (`zero stack overflow on huge continents!`)
--   - `32x32` Spatial Hash `UnitGrid` + `SharedWaterCache` (`O(1)` range combat &amp; sea lanes!)
--   - Sparse `activeFalloutRefs` list (`O(crater)` fallout recovery + full `falloutSnapshot` sync!)
--   - Warship TradeShip piracy, Coastal DefensePost shelling, SAM lock reservation, Nuke betrayal!

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")

local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local MapCodec = require(Shared:WaitForChild("MapCodec"))
local MapRegistry = require(Shared:WaitForChild("Maps"):WaitForChild("MapRegistry"))
local NetCodec = require(Shared:WaitForChild("NetCodec"))
local Theme = require(Shared:WaitForChild("Theme"))
local Types = require(Shared:WaitForChild("Types"))

local AiBrain = require(script.Parent:WaitForChild("AiBrain"))
local Heap = require(script.Parent:WaitForChild("Heap"))

type GameConfig = Types.GameConfig
type UnitType = Types.UnitType

local SimEngine = {}
SimEngine.__index = SimEngine

local TRIBE_PREFIXES = {
	"Iron", "Golden", "Crimson", "Northern", "Eastern", "Western", "Southern", "Alpine",
	"Coastal", "Highland", "Emerald", "Silver", "Obsidian", "Solar", "Azure", "Amber",
	"Granite", "Verdant", "Storm", "Cedar", "Steppe", "Delta", "Canyon", "Cobalt",
}
local TRIBE_SUFFIXES = {
	"Pact", "League", "Duchy", "March", "Clan", "Union", "Guard", "Freehold",
	"Republic", "Order", "Realm", "Barony", "Commune", "Front", "Dominion", "Hold",
}

local CAPTURABLE_STRUCTURES: { [string]: boolean } = {
	City = true,
	Port = true,
	Factory = true,
	DefensePost = true,
	MissileSilo = true,
	SAMLauncher = true,
}

local GRID_SHIFT = 5 -- 32x32 tile spatial buckets!

export type EngineInstance = typeof(setmetatable({} :: any, SimEngine))

function SimEngine:_Rand(): number
	local s = bit32.band((self.rngState :: number) + 0x6D2B79F5, 0xFFFFFFFF)
	self.rngState = s
	local t = bit32.bxor(s, bit32.rshift(s, 15))
	t = bit32.band(t * bit32.bor(1, s), 0xFFFFFFFF)
	t = bit32.band(t + bit32.bxor(t, bit32.band(bit32.bxor(t, bit32.rshift(t, 7)) * bit32.bor(61, t), 0xFFFFFFFF)), 0xFFFFFFFF)
	return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296.0
end

function SimEngine:_RandInt(lo: number, hi: number): number
	if hi &lt;= lo then
		return lo
	end
	return lo + math.floor(self:_Rand() * (hi - lo + 1))
end

function SimEngine.new(cfg: GameConfig, humanConfigs: { any }, isPreview: boolean?): EngineInstance
	local rawDef = MapRegistry.Get(cfg.mapId)
	local map = MapCodec.DecodeMap(rawDef)

	local initSeed = bit32.band(math.floor(cfg.seed or 133701), 0xFFFFFFFF)
	if initSeed == 0 then
		initSeed = 0x9E3779B9
	end

	local self = setmetatable({}, SimEngine) :: any
	self.config = cfg
	self.rngState = initSeed
	self.paused = false
	self.simSpeed = 1
	self.isPreview = isPreview == true
	self.map = map
	self.rawMap = rawDef
	self.ticks = 0
	self.spawnPhaseTicks = if self.isPreview then 1 else Config.SpawnPhaseTicks(cfg)
	self.inSpawnPhase = true
	self.gameOver = false
	self.winnerName = nil :: string?
	self.winnerSmallId = nil :: number?
	self.winnerTeam = nil :: string?
	self.mirvsLaunched = 0

	self.playersList = {}
	self.playersBySmallId = {}
	self.playersByUserId = {}
	self.nextSmallId = 0

	self.attacks = {}
	self.nextAttackId = 0

	self.units = {}
	self.unitsByTile = {} :: { [number]: any }
	self.nextUnitId = 0

	self.gridCols = math.ceil(map.width / 32)
	self.gridRows = math.ceil(map.height / 32)
	self.unitGrid = {} :: { [number]: { any } }
	self.sharedWaterCache = {} :: { [string]: { number } }
	self.waterCacheCount = 0

	self.activeFalloutRefs = {} :: { number }
	self.inFalloutSet = {} :: { [number]: boolean }

	self.railEdges = {} :: { { number } }
	self.railNetworkDirty = false

	self.allianceRequests = {}
	self.nextAlertId = 0
	self.alertsByPlayer = {} :: { [number]: { Types.ActionableAlert } }
	self.events = {} :: { Types.EventFeedItem }
	self.nextEventId = 0
	self.explosions = {} :: { { x: number, y: number, radius: number, kind: string } }

	self.deltaRefs = {} :: { number }
	self.deltaOwners = {} :: { number }
	self.deltaCount = 0

	self.falloutDeltaRefs = {} :: { number }
	self.falloutDeltaStates = {} :: { number }
	self.falloutDeltaCount = 0

	self:_InitParticipants(humanConfigs)
	return self
end

function SimEngine:_GridCellIndex(x: number, y: number): number
	local gx = math.clamp(bit32.rshift(math.max(0, math.floor(x)), GRID_SHIFT), 0, self.gridCols - 1)
	local gy = math.clamp(bit32.rshift(math.max(0, math.floor(y)), GRID_SHIFT), 0, self.gridRows - 1)
	return gy * self.gridCols + gx + 1
end

function SimEngine:_GridInsert(u: any)
	local c = self:_GridCellIndex(u.x, u.y)
	u._gridCell = c
	local bucket = self.unitGrid[c]
	if bucket == nil then
		bucket = {}
		self.unitGrid[c] = bucket
	end
	table.insert(bucket, u)
end

function SimEngine:_GridRemove(u: any)
	local c = u._gridCell or 0
	if c &lt;= 0 then
		return
	end
	local bucket = self.unitGrid[c]
	if bucket ~= nil then
		for i = #bucket, 1, -1 do
			if bucket[i] == u then
				local n = #bucket
				bucket[i] = bucket[n]
				bucket[n] = nil
				break
			end
		end
	end
	u._gridCell = 0
end

function SimEngine:_GridUpdatePos(u: any, nx: number, ny: number)
	u.x = nx
	u.y = ny
	local nc = self:_GridCellIndex(nx, ny)
	if nc ~= u._gridCell then
		self:_GridRemove(u)
		u._gridCell = nc
		local bucket = self.unitGrid[nc]
		if bucket == nil then
			bucket = {}
			self.unitGrid[nc] = bucket
		end
		table.insert(bucket, u)
	end
end

function SimEngine:_ForUnitsInRadius(cx: number, cy: number, radius: number, fn: (any) -&gt; boolean?)
	local minGX = math.clamp(bit32.rshift(math.max(0, math.floor(cx - radius)), GRID_SHIFT), 0, self.gridCols - 1)
	local maxGX = math.clamp(bit32.rshift(math.max(0, math.ceil(cx + radius)), GRID_SHIFT), 0, self.gridCols - 1)
	local minGY = math.clamp(bit32.rshift(math.max(0, math.floor(cy - radius)), GRID_SHIFT), 0, self.gridRows - 1)
	local maxGY = math.clamp(bit32.rshift(math.max(0, math.ceil(cy + radius)), GRID_SHIFT), 0, self.gridRows - 1)
	local rSq = radius * radius
	for gy = minGY, maxGY do
		local base = gy * self.gridCols
		for gx = minGX, maxGX do
			local bucket = self.unitGrid[base + gx + 1]
			if bucket ~= nil then
				for i = 1, #bucket do
					local u = bucket[i]
					if u ~= nil and u.active then
						local dx = u.x - cx
						local dy = u.y - cy
						if dx * dx + dy * dy &lt;= rSq then
							if fn(u) == true then
								return
							end
						end
					end
				end
			end
		end
	end
end

function SimEngine:_CachedWaterPath(startRef: number, goalRef: number, maxNodes: number): { number }?
	local key = tostring(startRef) .. ":" .. tostring(goalRef)
	local cached = self.sharedWaterCache[key]
	if cached ~= nil then
		return cached
	end
	local map = self.map
	local path = MapCodec.FindWaterPath(map, startRef, goalRef, math.min(maxNodes, 2600))
	if path == nil then
		local sw = if MapCodec.IsWater(map, startRef) then startRef else MapCodec.AdjacentWater(map, startRef)
		local dw = if MapCodec.IsWater(map, goalRef) then goalRef else MapCodec.AdjacentWater(map, goalRef)
		if sw ~= nil and dw ~= nil and MapCodec.SameWaterBody(map, sw, dw) then
			local w, h = map.width, map.height
			local sx, sy = sw % w, math.floor(sw / w)
			local gx, gy = dw % w, math.floor(dw / w)
			local dx = gx - sx
			if map.wrapX then
				if dx &gt; w * 0.5 then
					dx -= w
				elseif dx &lt; -w * 0.5 then
					dx += w
				end
			end
			local dy = gy - sy
			local steps = math.max(2, math.ceil(math.sqrt(dx * dx + dy * dy)))
			local built = table.create(steps + 2)
			table.insert(built, startRef)
			for s = 1, steps - 1 do
				local t = s / steps
				local px = sx + dx * t
				if map.wrapX then
					px = px % w
				end
				local ix = math.clamp(math.floor(px + 0.5), 0, w - 1)
				local iy = math.clamp(math.floor(sy + dy * t + 0.5), 0, h - 1)
				table.insert(built, iy * w + ix)
			end
			table.insert(built, goalRef)
			path = built
		end
	end
	if path ~= nil then
		if self.waterCacheCount &gt;= 512 then
			table.clear(self.sharedWaterCache)
			self.waterCacheCount = 0
		end
		self.sharedWaterCache[key] = path
		self.waterCacheCount += 1
	end
	return path
end

function SimEngine:_AssignTeam(index: number, playerType: Types.PlayerType): string?
	local cfg: GameConfig = self.config
	if cfg.mode ~= "Teams" then
		return nil
	end
	if cfg.numTeams == -1 then
		return if playerType == "Human" then "Humans" else "Nations"
	end
	local count = math.clamp(cfg.numTeams, 2, #Theme.TeamOrder)
	return Theme.TeamOrder[((index - 1) % count) + 1]
end

function SimEngine:_AddParticipant(info: {
	userId: number,
	playerType: Types.PlayerType,
	name: string,
	flag: string,
	colorHex: string,
	patternId: string,
	prefX: number,
	prefY: number,
	teamIndex: number,
})
	self.nextSmallId += 1
	local sid = self.nextSmallId
	local team = self:_AssignTeam(info.teamIndex, info.playerType)
	local finalColor = info.colorHex
	if team ~= nil and Theme.TeamColors[team] ~= nil then
		finalColor = Theme.TeamColors[team]
	end

	local aiCadence = 12
	if info.playerType == "Bot" then
		aiCadence = 18
	elseif self.config.difficulty == "Easy" then
		aiCadence = 16
	elseif self.config.difficulty == "Medium" then
		aiCadence = 12
	elseif self.config.difficulty == "Hard" then
		aiCadence = 9
	else
		aiCadence = 6
	end

	local startGold = if info.playerType == "Bot" then 0 else self.config.startingGold
	if info.playerType == "Human" and self.config.infiniteGold then
		startGold = 999_999_999
	end

	local p = {
		smallId = sid,
		userId = info.userId,
		playerType = info.playerType,
		name = info.name,
		flag = info.flag,
		colorHex = finalColor,
		patternId = info.patternId,
		team = team,
		alive = true,
		hasSpawned = false,
		spawnX = info.prefX,
		spawnY = info.prefY,
		labelX = math.max(0, info.prefX),
		labelY = math.max(0, info.prefY),
		labelSpan = 16,
		tilesOwned = 0,
		tilesPeak = 0,
		troops = Config.StartingManpower(info.playerType, self.config),
		gold = startGold,
		goldEarned = startGold,
		isTraitor = false,
		traitorUntilTick = -1,
		isDoomed = false,
		doomWarnStartTick = -1,
		spawnImmunityUntil = 0,
		allies = {} :: { [number]: number },
		embargoes = {} :: { [number]: boolean },
		relations = {} :: { [number]: number },
		targetedBy = {} :: { [number]: number },
		emoji = nil :: string?,
		emojiUntilTick = -1,
		lastDonateTick = -999,
		lastTargetTick = -999,
		lastDeleteTick = -999,
		lastAllianceReqTick = -999,
		lastEmojiTick = -999,
		nukesSent = 0,
		deathNotified = false,
		survivedTicks = 0,
		borderSet = {} :: { [number]: number },
		borderList = {} :: { number },
		unitCounts = {} :: { [string]: number },
		cityLevels = 0,
		portLevels = 0,
		factoryLevels = 0,
		defensePosts = {} :: { any },
		aiCadence = aiCadence,
		aiOffset = sid % aiCadence,
		aiTriggerRatio = 0.50 + ((sid * 7) % 15) / 100,
	}

	table.insert(self.playersList, p)
	self.playersBySmallId[sid] = p
	if info.userId &gt; 0 then
		self.playersByUserId[info.userId] = p
	end
	self.alertsByPlayer[sid] = {}
	return p
end

function SimEngine:_FindRandomUnclaimedLand(minDistSq: number): (number, number)
	local map = self.map
	local w, h = map.width, map.height
	for attempt = 1, 260 do
		local x = self:_RandInt(4, math.max(4, w - 5))
		local y = self:_RandInt(4, math.max(4, h - 5))
		local ref = y * w + x
		if MapCodec.IsPlayableLand(map, ref) and MapCodec.GetOwner(map, ref) == 0 then
			local ok = true
			if attempt &lt; 180 and minDistSq &gt; 0 then
				for _, other in ipairs(self.playersList) do
					if other.spawnX &gt;= 0 then
						local dx = other.spawnX - x
						local dy = other.spawnY - y
						if dx * dx + dy * dy &lt; minDistSq then
							ok = false
							break
						end
					end
				end
			end
			if ok then
				return x, y
			end
		end
	end
	local startRef = self:_RandInt(0, map.size - 1)
	for step = 0, map.size - 1, 7 do
		local ref = (startRef + step) % map.size
		if MapCodec.IsPlayableLand(map, ref) and MapCodec.GetOwner(map, ref) == 0 then
			return ref % w, math.floor(ref / w)
		end
	end
	return math.floor(w / 2), math.floor(h / 2)
end

function SimEngine:_InitParticipants(humanConfigs: { any })
	local teamIdx = 0
	local sf = Config.MapScaleFactor(self.map.width)
	local baseSep = math.max(18, math.floor(26 * sf))

	for _, hc in ipairs(humanConfigs) do
		teamIdx += 1
		local sx, sy = -1, -1
		if self.config.randomSpawn then
			sx, sy = self:_FindRandomUnclaimedLand(baseSep * baseSep)
		end
		self:_AddParticipant({
			userId = hc.userId,
			playerType = "Human",
			name = hc.name,
			flag = hc.flag or "in",
			colorHex = hc.colorHex or Theme.HumanColors[1],
			patternId = hc.patternId or "none",
			prefX = sx,
			prefY = sy,
			teamIndex = teamIdx,
		})
	end

	-- Full-Scale Sovereign Nations (`ALL 72` on World, `71` on NorthAmerica, up to `90` on GiantWorldMap!)
	if self.config.spawnNations then
		local nations = self.rawMap.nations or {}
		local ordered = table.clone(nations)
		table.sort(ordered, function(a, b)
			return (a.strength or 1) &gt; (b.strength or 1)
		end)
		local minSepSq = math.max(100, math.floor(16 * sf) ^ 2)
		local maxNations = if self.isPreview then 48 else 90
		local addedNations = 0
		for _, nat in ipairs(ordered) do
			if addedNations &gt;= maxNations then
				break
			end
			local nx, ny = nat.x, nat.y
			if self.config.randomSpawn or nx &lt; 0 or ny &lt; 0 then
				nx, ny = self:_FindRandomUnclaimedLand(minSepSq)
			end
			local tooClose = false
			for _, existing in ipairs(self.playersList) do
				if existing.spawnX &gt;= 0 then
					local dx = existing.spawnX - nx
					local dy = existing.spawnY - ny
					if dx * dx + dy * dy &lt; minSepSq then
						tooClose = true
						break
					end
				end
			end
			if not tooClose then
				addedNations += 1
				teamIdx += 1
				self:_AddParticipant({
					userId = -addedNations,
					playerType = "Nation",
					name = nat.name,
					flag = nat.flag or "",
					colorHex = Theme.NationColors[((addedNations - 1) % #Theme.NationColors) + 1],
					patternId = "none",
					prefX = nx,
					prefY = ny,
					teamIndex = teamIdx,
				})
			end
		end
	end

	local botTarget = if self.isPreview then 14 else math.clamp(self.config.bots, 0, 120)
	local botSepSq = math.max(400, math.floor(42 * sf) ^ 2)
	for b = 1, botTarget do
		local bx, by = self:_FindRandomUnclaimedLand(botSepSq)
		local bName = TRIBE_PREFIXES[((b - 1) % #TRIBE_PREFIXES) + 1]
			.. " "
			.. TRIBE_SUFFIXES[(math.floor((b - 1) / #TRIBE_PREFIXES) % #TRIBE_SUFFIXES) + 1]
		if b &gt; #TRIBE_PREFIXES then
			bName = bName .. " " .. tostring(math.ceil(b / #TRIBE_PREFIXES))
		end
		teamIdx += 1
		self:_AddParticipant({
			userId = -(1000 + b),
			playerType = "Bot",
			name = bName,
			flag = "",
			colorHex = Theme.BotColors[((b - 1) % #Theme.BotColors) + 1],
			patternId = "none",
			prefX = bx,
			prefY = by,
			teamIndex = teamIdx,
		})
	end
end

function SimEngine:ChooseSpawn(userId: number, x: number, y: number): boolean
	if not self.inSpawnPhase or self.config.randomSpawn then
		return false
	end
	if not Config.IsFiniteNumber(x) or not Config.IsFiniteNumber(y) then
		return false
	end
	local p = self.playersByUserId[userId]
	if p == nil then
		return false
	end
	local ix = math.clamp(math.floor(x), 0, self.map.width - 1)
	local iy = math.clamp(math.floor(y), 0, self.map.height - 1)
	local ref = iy * self.map.width + ix
	if not MapCodec.IsPlayableLand(self.map, ref) then
		return false
	end
	p.spawnX = ix
	p.spawnY = iy
	p.labelX = ix
	p.labelY = iy
	return true
end

local _ENQ_STACK = table.create(32, 0)
local _ENQ_NBUF1 = { 0, 0, 0, 0 }
local _ENQ_NBUF2 = { 0, 0, 0, 0 }

function SimEngine:_UpdateBorderForTile(ref: number)
	local map = self.map
	local ownerBuf = map.owner
	local oid = buffer.readu16(ownerBuf, ref * 2)
	if oid == 0 then
		return
	end
	local p = self.playersBySmallId[oid]
	if p == nil then
		return
	end
	local w = map.width
	local x = ref % w
	local y = (ref - x) / w
	local isBorder = false
	if y == 0 or y == map.height - 1 then
		isBorder = true
	else
		local lx = if x &gt; 0 then x - 1 elseif map.wrapX then w - 1 else -1
		local rx = if x &lt; w - 1 then x + 1 elseif map.wrapX then 0 else -1
		if lx &lt; 0 or rx &lt; 0 then
			isBorder = true
		elseif
			buffer.readu16(ownerBuf, (ref - w) * 2) ~= oid
			or buffer.readu16(ownerBuf, (ref + w) * 2) ~= oid
			or buffer.readu16(ownerBuf, (y * w + lx) * 2) ~= oid
			or buffer.readu16(ownerBuf, (y * w + rx) * 2) ~= oid
		then
			isBorder = true
		end
	end
	local curIdx = p.borderSet[ref]
	if isBorder and curIdx == nil then
		local newIdx = #p.borderList + 1
		p.borderList[newIdx] = ref
		p.borderSet[ref] = newIdx
	elseif (not isBorder) and curIdx ~= nil then
		local lastIdx = #p.borderList
		local lastRef = p.borderList[lastIdx]
		p.borderList[curIdx] = lastRef
		p.borderSet[lastRef] = curIdx
		p.borderList[lastIdx] = nil
		p.borderSet[ref] = nil
	end
end

function SimEngine:ConquerTile(newOwnerId: number, ref: number)
	local map = self.map
	if not MapCodec.IsPlayableLand(map, ref) then
		return
	end
	local oldOwnerId = MapCodec.GetOwner(map, ref)
	if oldOwnerId == newOwnerId then
		return
	end

	if oldOwnerId &gt; 0 then
		local oldP = self.playersBySmallId[oldOwnerId]
		if oldP ~= nil then
			oldP.tilesOwned = math.max(0, oldP.tilesOwned - 1)
			local bIdx = oldP.borderSet[ref]
			if bIdx ~= nil then
				local lastIdx = #oldP.borderList
				local lastRef = oldP.borderList[lastIdx]
				oldP.borderList[bIdx] = lastRef
				oldP.borderSet[lastRef] = bIdx
				oldP.borderList[lastIdx] = nil
				oldP.borderSet[ref] = nil
			end
			if oldP.tilesOwned == 0 and oldP.hasSpawned and oldP.alive then
				oldP.alive = false
			end
		end
	end

	MapCodec.SetOwner(map, ref, newOwnerId)

	if newOwnerId &gt; 0 then
		local newP = self.playersBySmallId[newOwnerId]
		if newP ~= nil then
			newP.tilesOwned += 1
			if newP.tilesOwned &gt; newP.tilesPeak then
				newP.tilesPeak = newP.tilesOwned
			end
		end
		if MapCodec.HasFallout(map, ref) and MapCodec.SetFallout(map, ref, false) then
			self.falloutDeltaCount += 1
			self.falloutDeltaRefs[self.falloutDeltaCount] = ref
			self.falloutDeltaStates[self.falloutDeltaCount] = 0
		end
	end

	local unitOnTile = self.unitsByTile[ref]
	if unitOnTile ~= nil and unitOnTile.active then
		if newOwnerId == 0 then
			self:_RemoveUnit(unitOnTile)
		elseif CAPTURABLE_STRUCTURES[unitOnTile.unitType] then
			self:_TransferStructureOwner(unitOnTile, newOwnerId)
		end
	end

	self.deltaCount += 1
	self.deltaRefs[self.deltaCount] = ref
	self.deltaOwners[self.deltaCount] = newOwnerId

	self:_UpdateBorderForTile(ref)
	local w = map.width
	local x = ref % w
	local y = (ref - x) / w
	local lx = if x &gt; 0 then x - 1 elseif map.wrapX then w - 1 else -1
	if lx &gt;= 0 then
		self:_UpdateBorderForTile(y * w + lx)
	end
	local rx = if x &lt; w - 1 then x + 1 elseif map.wrapX then 0 else -1
	if rx &gt;= 0 then
		self:_UpdateBorderForTile(y * w + rx)
	end
	if y &gt; 0 then
		self:_UpdateBorderForTile(ref - w)
	end
	if y &lt; map.height - 1 then
		self:_UpdateBorderForTile(ref + w)
	end
end

function SimEngine:_FinalizeSpawns()
	local map = self.map
	local w, h = map.width, map.height
	local r = math.max(5, math.floor(7 * Config.MapScaleFactor(w) + 0.5))
	local rSq = r * r

	for _, p in ipairs(self.playersList) do
		if p.spawnX &lt; 0 or p.spawnY &lt; 0 or MapCodec.GetOwner(map, p.spawnY * w + p.spawnX) ~= 0 then
			p.spawnX, p.spawnY = self:_FindRandomUnclaimedLand(160)
		end
		p.labelX = p.spawnX
		p.labelY = p.spawnY
		p.labelSpan = r * 2
		p.hasSpawned = true
		p.spawnImmunityUntil = self.ticks + Config.SPAWN_IMMUNITY_TICKS

		for dy = -r, r do
			for dx = -r, r do
				if dx * dx + dy * dy &lt;= rSq then
					local tx = if map.wrapX then ((p.spawnX + dx) % w) else (p.spawnX + dx)
					local ty = p.spawnY + dy
					if tx &gt;= 0 and tx &lt; w and ty &gt;= 0 and ty &lt; h then
						local ref = ty * w + tx
						if MapCodec.IsPlayableLand(map, ref) and MapCodec.GetOwner(map, ref) == 0 then
							self:ConquerTile(p.smallId, ref)
						end
					end
				end
			end
		end

		if p.tilesOwned == 0 then
			p.alive = false
		end
	end
end

function SimEngine:AreFriendly(a: any, b: any): boolean
	if a == nil or b == nil then
		return false
	end
	if a.smallId == b.smallId then
		return true
	end
	if a.team ~= nil and a.team == b.team then
		return true
	end
	local expTick = a.allies[b.smallId]
	return expTick ~= nil and expTick &gt; self.ticks
end

function SimEngine:GetMaxTroops(p: any): number
	return Config.MaxTroops(p.tilesOwned, p.cityLevels, p.playerType, self.config, self.map.width)
end

function SimEngine:PushEvent(kind: string, text: string, colorHex: string, x: number?, y: number?)
	self.nextEventId += 1
	table.insert(self.events, {
		id = self.nextEventId,
		kind = kind :: any,
		text = text,
		colorHex = colorHex,
		targetX = x,
		targetY = y,
		tick = self.ticks,
	})
	if #self.events &gt; 28 then
		table.remove(self.events, 1)
	end
end

function SimEngine:PushAlert(recipientSmallId: number, alert: Types.ActionableAlert)
	local list = self.alertsByPlayer[recipientSmallId]
	if list == nil then
		return
	end
	for _, existing in ipairs(list) do
		if existing.kind == alert.kind and existing.fromSmallId == alert.fromSmallId and alert.kind ~= "NukeInbound" then
			return
		end
	end
	table.insert(list, alert)
	if #list &gt; 8 then
		table.remove(list, 1)
	end
end

-- Iterative, zero-allocation concave-pocket frontier enqueue (`ZERO GC churn or stack overflow on 8M-pixel maps!`)
function SimEngine:_EnqueueAttackNeighbors(atk: any, rootTile: number, basePrio: number?)
	local map = self.map
	local ownerBuf = map.owner
	local terrainBuf = map.terrain
	local stack = _ENQ_STACK
	local nbuf = _ENQ_NBUF1
	local nbuf2 = _ENQ_NBUF2
	stack[1] = rootTile
	local stackTop = 1
	local iterGuard = 0
	local targetId = atk.targetSmallId
	local attackerId = atk.attackerSmallId
	local pBase = basePrio or self.ticks

	while stackTop &gt; 0 and iterGuard &lt; 24 do
		iterGuard += 1
		local tile = stack[stackTop]
		stackTop -= 1

		local n = MapCodec.Neighbors4(map, tile, nbuf)
		for i = 1, n do
			local nb = nbuf[i]
			if buffer.readu16(ownerBuf, nb * 2) == targetId then
				local tb = buffer.readu8(terrainBuf, nb)
				if bit32.band(tb, 0x80) ~= 0 then
					local ownedByMe = 0
					local nonEnemySides = 0
					local n2 = MapCodec.Neighbors4(map, nb, nbuf2)
					for j = 1, n2 do
						local nb2 = nbuf2[j]
						local o2 = buffer.readu16(ownerBuf, nb2 * 2)
						if o2 == attackerId then
							ownedByMe += 1
							nonEnemySides += 1
						elseif bit32.band(buffer.readu8(terrainBuf, nb2), 0x80) == 0 then
							nonEnemySides += 1
						end
					end
					-- True surrounded 1-tile enclave pocket only (`nonEnemySides &gt;= 4`); never square-fill diagonal arcs!
					if nonEnemySides &gt;= 4 and ownedByMe &gt;= 1 and atk.troops &gt;= 2 then
						self:ConquerTile(attackerId, nb)
						stackTop += 1
						stack[stackTop] = nb
						continue
					end
					local elev = bit32.band(tb, 0x1F)
					local stepCost = if elev &gt;= 20 then 4.2 elseif elev &gt;= 11 then 2.1 else 1.0
					local prio = pBase + stepCost + self:_Rand() * 2.4 - (ownedByMe - 1) * 0.35
					if not atk.inHeap[nb] then
						atk.inHeap[nb] = true
						atk.borderCount += 1
						atk.heap:enqueue(nb, prio)
					elseif ownedByMe &gt;= 3 then
						atk.heap:enqueue(nb, prio)
					end
				end
			end
		end
	end
end

function SimEngine:StartLandAttack(attacker: any, targetSmallId: number, requestedTroops: number, sourceTile: number?)
	if self.inSpawnPhase or not attacker.alive or not Config.IsFiniteNumber(requestedTroops) then
		return
	end
	if targetSmallId == attacker.smallId then
		return
	end
	local targetPlayer = if targetSmallId &gt; 0 then self.playersBySmallId[targetSmallId] else nil
	if targetPlayer ~= nil then
		if not targetPlayer.alive or self:AreFriendly(attacker, targetPlayer) then
			return
		end
		if self.ticks &lt; targetPlayer.spawnImmunityUntil then
			return
		end
	end

	local sendTroops = math.floor(math.min(attacker.troops, math.max(0, requestedTroops)))
	if sendTroops &lt; 5 then
		return
	end
	attacker.troops -= sendTroops

	if targetPlayer ~= nil then
		targetPlayer.embargoes[attacker.smallId] = true
		targetPlayer.relations[attacker.smallId] = math.max(-100, (targetPlayer.relations[attacker.smallId] or 0) - 70)
	end

	for _, existing in ipairs(self.attacks) do
		if existing.active and existing.attackerSmallId == targetSmallId and existing.targetSmallId == attacker.smallId then
			if existing.troops &gt; sendTroops then
				existing.troops -= sendTroops
				return
			else
				sendTroops -= existing.troops
				existing.troops = 0
				existing.active = false
			end
		end
	end

	if sendTroops &lt; 1 then
		return
	end

	if sourceTile == nil then
		for _, existing in ipairs(self.attacks) do
			if
				existing.active
				and not existing.isBoat
				and existing.attackerSmallId == attacker.smallId
				and existing.targetSmallId == targetSmallId
			then
				existing.troops += sendTroops
				for idx = #attacker.borderList, 1, -1 do
					local bRef = attacker.borderList[idx]
					if bRef ~= nil then
						self:_EnqueueAttackNeighbors(existing, bRef)
					end
				end
				return
			end
		end
	end

	self.nextAttackId += 1
	local atk = {
		id = self.nextAttackId,
		attackerSmallId = attacker.smallId,
		targetSmallId = targetSmallId,
		troops = sendTroops,
		active = true,
		retreating = false,
		isBoat = sourceTile ~= nil,
		inHeap = {} :: { [number]: boolean },
		borderCount = 0,
		heap = Heap.new(),
	}

	if sourceTile ~= nil then
		if MapCodec.GetOwner(self.map, sourceTile) == targetSmallId then
			atk.inHeap[sourceTile] = true
			atk.borderCount = 1
			atk.heap:enqueue(sourceTile, self.ticks)
		end
		self:_EnqueueAttackNeighbors(atk, sourceTile)
	else
		for idx = #attacker.borderList, 1, -1 do
			local bRef = attacker.borderList[idx]
			if bRef ~= nil then
				self:_EnqueueAttackNeighbors(atk, bRef)
			end
		end
	end

	if atk.heap:size() == 0 then
		attacker.troops = math.min(self:GetMaxTroops(attacker), attacker.troops + sendTroops)
		return
	end

	table.insert(self.attacks, atk)
end

function SimEngine:RetreatAttack(attacker: any, attackId: number?)
	for _, atk in ipairs(self.attacks) do
		if atk.active and atk.attackerSmallId == attacker.smallId and (attackId == nil or atk.id == attackId) then
			local malus = if atk.targetSmallId &gt; 0 then (Config.RETREAT_MALUS_PERCENT / 100) else 0
			local survivors = math.floor(atk.troops * (1 - malus))
			attacker.troops = math.min(self:GetMaxTroops(attacker), attacker.troops + survivors)
			atk.troops = 0
			atk.active = false
		end
	end
end

function SimEngine:_TileProtectedByDefensePost(defender: any, ref: number): boolean
	local w = self.map.width
	local tx = ref % w
	local ty = math.floor(ref / w)
	local r = Config.DefensePostRangeScaled(w)
	local rSq = r * r
	for _, dp in ipairs(defender.defensePosts) do
		if dp.active and not dp.underConstruction then
			local dx = dp.x - tx
			local dy = dp.y - ty
			if dx * dx + dy * dy &lt;= rSq then
				return true
			end
		end
	end
	return false
end

function SimEngine:_CheckEliminatePocketDefender(attacker: any, defender: any)
	local pocketCap = math.max(60, math.floor(140 * Config.MapScaleFactor(self.map.width)))
	if not defender.alive or defender.tilesOwned &gt;= pocketCap then
		return
	end
	local plunder = if defender.playerType == "Human"
		then math.floor(defender.gold * 0.5)
		else math.floor(defender.gold)
	defender.gold = math.max(0, defender.gold - plunder)
	attacker.gold += plunder
	attacker.goldEarned += plunder

	local map = self.map
	-- Fast O(pocketSize) onion-peel border sweep instead of full 8M pixel scan!
	local guard = 0
	while defender.tilesOwned &gt; 0 and #defender.borderList &gt; 0 and guard &lt; 4096 do
		guard += 1
		local bRef = defender.borderList[1]
		if MapCodec.GetOwner(map, bRef) == defender.smallId then
			self:ConquerTile(attacker.smallId, bRef)
		else
			self:_UpdateBorderForTile(bRef)
		end
	end
	if defender.tilesOwned &gt; 0 then
		for ref = 0, map.size - 1 do
			if MapCodec.GetOwner(map, ref) == defender.smallId then
				self:ConquerTile(attacker.smallId, ref)
			end
		end
	end
	defender.troops = 0
	defender.alive = false

	if defender.playerType ~= "Bot" or attacker.playerType == "Human" then
		local goldTxt = if plunder &gt; 0 then (" (+" .. Format.Gold(plunder) .. "g)") else ""
		self:PushEvent(
			"conquest",
			attacker.name .. " conquered " .. defender.name .. "!" .. goldTxt,
			attacker.colorHex,
			defender.labelX,
			defender.labelY
		)
	end
end

function SimEngine:_TickAttacks()
	local map = self.map
	local nbuf = { 0, 0, 0, 0 }
	local falloutShare = map.numFalloutTiles / math.max(1, map.numLandTiles)

	local writeIdx = 0
	for i = 1, #self.attacks do
		local atk = self.attacks[i]
		if atk.active then
			local attacker = self.playersBySmallId[atk.attackerSmallId]
			local defender = if atk.targetSmallId &gt; 0 then self.playersBySmallId[atk.targetSmallId] else nil

			if attacker == nil or not attacker.alive then
				atk.active = false
			elseif defender ~= nil and (not defender.alive or self:AreFriendly(attacker, defender)) then
				attacker.troops = math.min(self:GetMaxTroops(attacker), attacker.troops + atk.troops)
				atk.active = false
			else
				local borderSize = math.max(8, atk.borderCount + self:_RandInt(0, 5))
				local tickBudget = 1.0
				local safety = 0

				-- Full-Scale 1x Frontier Expansion Throughput (`safety &lt; 3600`!)
				while tickBudget &gt; 0 and safety &lt; 3600 do
					safety += 1
					if atk.troops &lt; 1 then
						atk.active = false
						break
					end
					if atk.heap:size() == 0 then
						attacker.troops = math.min(self:GetMaxTroops(attacker), attacker.troops + atk.troops)
						atk.active = false
						break
					end

					local parentPrio = atk.heap:peekPriority() or self.ticks
					local tile = atk.heap:dequeue()
					if tile == nil then
						break
					end
					atk.inHeap[tile] = nil
					atk.borderCount = math.max(0, atk.borderCount - 1)

					if MapCodec.GetOwner(map, tile) ~= atk.targetSmallId or not MapCodec.IsPlayableLand(map, tile) then
						continue
					end

					local onBorder = atk.isBoat
					if not onBorder then
						local n = MapCodec.Neighbors4(map, tile, nbuf)
						for k = 1, n do
							if MapCodec.GetOwner(map, nbuf[k]) == attacker.smallId then
								onBorder = true
								break
							end
						end
					end
					if not onBorder then
						continue
					end
					atk.isBoat = false

					local hasDP = if defender ~= nil then self:_TileProtectedByDefensePost(defender, tile) else false
					local fRatio = if MapCodec.HasFallout(map, tile) then falloutShare else nil
					local atkLoss, defLoss, frac = Config.AttackLogic(
						MapCodec.TerrainKind(map, tile),
						atk.troops,
						attacker.playerType,
						attacker.tilesOwned,
						if defender ~= nil then defender.playerType else nil,
						if defender ~= nil then defender.tilesOwned else 0,
						if defender ~= nil then defender.troops else 0,
						if defender ~= nil then defender.isTraitor else false,
						hasDP,
						fRatio,
						borderSize,
						map.width
					)

					tickBudget -= math.max(0.0008, frac)
					atk.troops -= atkLoss
					if defender ~= nil then
						defender.troops = math.max(0, defender.troops - defLoss)
					end
					self:ConquerTile(attacker.smallId, tile)
					self:_EnqueueAttackNeighbors(atk, tile, parentPrio)

					if defender ~= nil then
						self:_CheckEliminatePocketDefender(attacker, defender)
						if not defender.alive then
							attacker.troops = math.min(self:GetMaxTroops(attacker), attacker.troops + math.max(0, atk.troops))
							atk.active = false
							break
						end
					end
				end
			end
		end

		if atk.active then
			writeIdx += 1
			self.attacks[writeIdx] = atk
		end
	end
	for j = #self.attacks, writeIdx + 1, -1 do
		self.attacks[j] = nil
	end
end

function SimEngine:LaunchBoatAttack(attacker: any, dstRef: number, requestedTroops: number): boolean
	if self.inSpawnPhase or not attacker.alive or not Config.IsFiniteNumber(requestedTroops) then
		return false
	end
	local map = self.map
	local w = map.width
	if dstRef &lt; 0 or dstRef &gt;= map.size then
		return false
	end
	if MapCodec.IsWater(map, dstRef) then
		local nbuf = { 0, 0, 0, 0 }
		local n = MapCodec.Neighbors4(map, dstRef, nbuf)
		for i = 1, n do
			if MapCodec.IsPlayableLand(map, nbuf[i]) then
				dstRef = nbuf[i]
				break
			end
		end
	end
	if not MapCodec.IsPlayableLand(map, dstRef) then
		return false
	end
	local dstOwnerId = MapCodec.GetOwner(map, dstRef)
	if dstOwnerId == attacker.smallId then
		return false
	end
	local dstPlayer = if dstOwnerId &gt; 0 then self.playersBySmallId[dstOwnerId] else nil
	if dstPlayer ~= nil and self:AreFriendly(attacker, dstPlayer) then
		return false
	end
	if (attacker.unitCounts["TransportShip"] or 0) &gt;= Config.BOAT_MAX_NUMBER then
		return false
	end

	local dstWater = MapCodec.AdjacentWater(map, dstRef)
	if dstWater == nil then
		return false
	end

	local tx, ty = dstRef % w, math.floor(dstRef / w)
	local bestShore: number? = nil
	local bestDistSq = math.huge
	for _, bRef in ipairs(attacker.borderList) do
		if MapCodec.IsShoreLand(map, bRef) then
			local sw = MapCodec.AdjacentWater(map, bRef)
			if sw ~= nil and MapCodec.SameWaterBody(map, sw, dstWater) then
				local bx, by = bRef % w, math.floor(bRef / w)
				local dSq = (bx - tx) * (bx - tx) + (by - ty) * (by - ty)
				if dSq &lt; bestDistSq then
					bestDistSq = dSq
					bestShore = bRef
				end
			end
		end
	end
	if bestShore == nil then
		return false
	end

	local path = self:_CachedWaterPath(bestShore, dstRef, 60_000)
	if path == nil or #path &lt; 2 then
		return false
	end

	local troops = math.floor(math.min(attacker.troops, math.max(0, requestedTroops)))
	if troops &lt; 10 then
		return false
	end
	attacker.troops -= troops

	self:_CreateUnit(attacker, "TransportShip", bestShore % w, math.floor(bestShore / w), {
		dstX = tx,
		dstY = ty,
		dstRef = dstRef,
		path = path,
		pathIdx = 1,
		troops = troops,
		hp = 250,
		maxHp = 250,
	})
	return true
end

function SimEngine:RetreatBoats(attacker: any)
	for _, u in ipairs(self.units) do
		if u.active and u.ownerSmallId == attacker.smallId and u.unitType == "TransportShip" and not u.retreating then
			u.retreating = true
			local rev = {}
			for idx = u.pathIdx, 1, -1 do
				table.insert(rev, u.path[idx])
			end
			u.path = rev
			u.pathIdx = 1
		end
	end
end

function SimEngine:CanPlaceStructureNear(p: any, ref: number): boolean
	if MapCodec.GetOwner(self.map, ref) ~= p.smallId or not MapCodec.IsPlayableLand(self.map, ref) then
		return false
	end
	if self.unitsByTile[ref] ~= nil then
		return false
	end
	local w = self.map.width
	local x, y = ref % w, math.floor(ref / w)
	local minDist = Config.StructureMinDistScaled(w)
	local blocked = false
	self:_ForUnitsInRadius(x, y, minDist, function(u: any)
		if CAPTURABLE_STRUCTURES[u.unitType] then
			blocked = true
			return true
		end
		return false
	end)
	return not blocked
end

function SimEngine:FindFirstOwnedUnit(ownerSmallId: number, unitType: UnitType): any
	for _, u in ipairs(self.units) do
		if u.active and u.ownerSmallId == ownerSmallId and u.unitType == unitType and not u.underConstruction then
			return u
		end
	end
	return nil
end

function SimEngine:_AdjustPlayerStructureStats(p: any, unitType: string, levelDelta: number, unitObj: any, adding: boolean)
	if unitType == "City" then
		p.cityLevels = math.max(0, p.cityLevels + levelDelta)
	elseif unitType == "Port" then
		p.portLevels = math.max(0, p.portLevels + levelDelta)
	elseif unitType == "Factory" then
		p.factoryLevels = math.max(0, p.factoryLevels + levelDelta)
	elseif unitType == "DefensePost" then
		if adding then
			table.insert(p.defensePosts, unitObj)
		else
			for i, dp in ipairs(p.defensePosts) do
				if dp == unitObj then
					table.remove(p.defensePosts, i)
					break
				end
			end
		end
	end
end

function SimEngine:_CreateUnit(owner: any, unitType: UnitType, x: number, y: number, extra: { [string]: any }?): any
	self.nextUnitId += 1
	local buildTicks = Config.ConstructionTicks(unitType, self.config.instantBuild)
	local u: any = {
		id = self.nextUnitId,
		unitType = unitType,
		ownerSmallId = owner.smallId,
		x = x,
		y = y,
		_gridCell = 0,
		srcX = x,
		srcY = y,
		dstX = x,
		dstY = y,
		level = 1,
		hp = 100,
		maxHp = 100,
		veterancy = 0,
		kills = 0,
		underConstruction = buildTicks &gt; 0,
		buildStartTick = self.ticks,
		buildEndTick = self.ticks + buildTicks,
		cooldownUntilTick = 0,
		lastShotTick = 0,
		troops = 0,
		progress = 0,
		active = true,
	}
	if extra ~= nil then
		for k, v in pairs(extra) do
			u[k] = v
		end
	end
	owner.unitCounts[unitType] = (owner.unitCounts[unitType] or 0) + 1
	if CAPTURABLE_STRUCTURES[unitType] then
		local ref = y * self.map.width + x
		self.unitsByTile[ref] = u
		if not u.underConstruction then
			self:_AdjustPlayerStructureStats(owner, unitType, u.level, u, true)
			if unitType == "City" or unitType == "Port" or unitType == "Factory" then
				self.railNetworkDirty = true
			end
		end
	end
	self:_GridInsert(u)
	table.insert(self.units, u)
	return u
end

function SimEngine:_RemoveUnit(u: any)
	if not u.active then
		return
	end
	u.active = false
	self:_GridRemove(u)
	local owner = self.playersBySmallId[u.ownerSmallId]
	if owner ~= nil then
		owner.unitCounts[u.unitType] = math.max(0, (owner.unitCounts[u.unitType] or 1) - 1)
		if CAPTURABLE_STRUCTURES[u.unitType] and not u.underConstruction then
			self:_AdjustPlayerStructureStats(owner, u.unitType, -u.level, u, false)
		end
	end
	if CAPTURABLE_STRUCTURES[u.unitType] then
		local ref = u.y * self.map.width + u.x
		if self.unitsByTile[ref] == u then
			self.unitsByTile[ref] = nil
		end
		if u.unitType == "City" or u.unitType == "Port" or u.unitType == "Factory" then
			self.railNetworkDirty = true
		end
	end
end

function SimEngine:_TransferStructureOwner(u: any, newOwnerId: number)
	local oldOwner = self.playersBySmallId[u.ownerSmallId]
	local newOwner = self.playersBySmallId[newOwnerId]
	if oldOwner == newOwner or newOwner == nil then
		return
	end
	if oldOwner ~= nil then
		oldOwner.unitCounts[u.unitType] = math.max(0, (oldOwner.unitCounts[u.unitType] or 1) - 1)
		if not u.underConstruction then
			self:_AdjustPlayerStructureStats(oldOwner, u.unitType, -u.level, u, false)
		end
	end
	u.ownerSmallId = newOwnerId
	newOwner.unitCounts[u.unitType] = (newOwner.unitCounts[u.unitType] or 0) + 1
	if not u.underConstruction then
		self:_AdjustPlayerStructureStats(newOwner, u.unitType, u.level, u, true)
	end
end

function SimEngine:UpgradeStructure(player: any, unitId: number): boolean
	for _, u in ipairs(self.units) do
		if u.active and u.id == unitId and u.ownerSmallId == player.smallId and CAPTURABLE_STRUCTURES[u.unitType] then
			if u.unitType == "DefensePost" or u.underConstruction or u.level &gt;= 5 then
				return false
			end
			local cost = Config.UnitCost(
				u.unitType,
				player.unitCounts,
				self.mirvsLaunched,
				self.config.infiniteGold,
				player.playerType == "Human"
			)
			if player.gold &lt; cost then
				return false
			end
			player.gold -= cost
			u.level += 1
			self:_AdjustPlayerStructureStats(player, u.unitType, 1, u, false)
			return true
		end
	end
	return false
end

function SimEngine:DeleteStructure(player: any, unitId: number): boolean
	if self.ticks - player.lastDeleteTick &lt; Config.DELETE_UNIT_COOLDOWN_TICKS then
		return false
	end
	for _, u in ipairs(self.units) do
		if u.active and u.id == unitId and u.ownerSmallId == player.smallId and CAPTURABLE_STRUCTURES[u.unitType] then
			player.lastDeleteTick = self.ticks
			self:_RemoveUnit(u)
			return true
		end
	end
	return false
end

function SimEngine:BuildUnit(player: any, unitType: UnitType, targetRef: number): boolean
	if self.inSpawnPhase or not player.alive or not Config.IsFiniteNumber(targetRef) then
		return false
	end
	local map = self.map
	local w, h = map.width, map.height
	targetRef = math.floor(targetRef)
	if targetRef &lt; 0 or targetRef &gt;= map.size then
		return false
	end
	local tx, ty = targetRef % w, math.floor(targetRef / w)
	local cost = Config.UnitCost(
		unitType,
		player.unitCounts,
		self.mirvsLaunched,
		self.config.infiniteGold,
		player.playerType == "Human"
	)
	if player.gold &lt; cost then
		return false
	end

	-- 1. Nuclear Missiles (AtomBomb, HydrogenBomb, MIRV)
	if unitType == "AtomBomb" or unitType == "HydrogenBomb" or unitType == "MIRV" then
		local bestSilo: any = nil
		local bestDist = math.huge
		for _, u in ipairs(self.units) do
			if
				u.active
				and u.ownerSmallId == player.smallId
				and u.unitType == "MissileSilo"
				and not u.underConstruction
				and self.ticks &gt;= u.cooldownUntilTick
			then
				local dx, dy = u.x - tx, u.y - ty
				local d = dx * dx + dy * dy
				if d &lt; bestDist then
					bestDist = d
					bestSilo = u
				end
			end
		end
		if bestSilo == nil then
			return false
		end
		if not self.config.waterNukes and not MapCodec.IsPlayableLand(map, targetRef) then
			local snapped: number? = nil
			for r = 1, 8 do
				for dy = -r, r do
					for dx = -r, r do
						local nx, ny = tx + dx, ty + dy
						if nx &gt;= 0 and nx &lt; w and ny &gt;= 0 and ny &lt; h then
							local cand = ny * w + nx
							if MapCodec.IsPlayableLand(map, cand) then
								snapped = cand
								break
							end
						end
					end
					if snapped ~= nil then
						break
					end
				end
				if snapped ~= nil then
					break
				end
			end
			if snapped == nil then
				return false
			end
			targetRef = snapped
			tx, ty = snapped % w, math.floor(snapped / w)
		end

		player.gold -= cost
		player.nukesSent += 1
		bestSilo.cooldownUntilTick = self.ticks + math.max(15, math.floor(Config.SILO_COOLDOWN_TICKS / bestSilo.level))

		local dist = math.sqrt((bestSilo.x - tx) * (bestSilo.x - tx) + (bestSilo.y - ty) * (bestSilo.y - ty))
		local speed = (if unitType == "MIRV" then 11.0 else 8.0) * Config.MapScaleFactor(w)
		local flightTicks = math.clamp(math.ceil(dist / math.max(3.5, speed)), 20, 140)

		if unitType == "MIRV" then
			self.mirvsLaunched += 1
			local sepY = math.max(4, ty - math.floor(65 * Config.MapScaleFactor(w)))
			local sepX = math.floor((bestSilo.x + tx) * 0.5)
			local nukeUnit = self:_CreateUnit(player, "MIRV", bestSilo.x, bestSilo.y, {
				srcX = bestSilo.x,
				srcY = bestSilo.y,
				dstX = sepX,
				dstY = sepY,
				realTargetX = tx,
				realTargetY = ty,
				targetSmallId = MapCodec.GetOwner(map, targetRef),
				startTick = self.ticks,
				endTick = self.ticks + flightTicks,
			})
			local victimId = MapCodec.GetOwner(map, targetRef)
			local victim = if victimId &gt; 0 then self.playersBySmallId[victimId] else nil
			self:PushEvent(
				"nuke",
				"☄️ " .. player.name .. " LAUNCHED A MIRV" .. (if victim then (" AT " .. victim.name) else "") .. "!",
				"#ef4444",
				tx,
				ty
			)
			if victim ~= nil and victim.smallId ~= player.smallId then
				if player.allies[victim.smallId] ~= nil then
					self:BreakAlliance(player, victim)
				end
				self.nextAlertId += 1
				self:PushAlert(victim.smallId, {
					id = self.nextAlertId,
					kind = "NukeInbound",
					fromSmallId = player.smallId,
					fromName = player.name,
					unitType = "MIRV",
					targetX = tx,
					targetY = ty,
					expiresTick = nukeUnit.endTick,
				})
			end
			return true
		else
			local nukeUnit = self:_CreateUnit(player, unitType, bestSilo.x, bestSilo.y, {
				srcX = bestSilo.x,
				srcY = bestSilo.y,
				dstX = tx,
				dstY = ty,
				startTick = self.ticks,
				endTick = self.ticks + flightTicks,
			})
			local victimId = MapCodec.GetOwner(map, targetRef)
			local victim = if victimId &gt; 0 then self.playersBySmallId[victimId] else nil
			local icon = if unitType == "HydrogenBomb" then "💥" else "☢️"
			local prettyUnit = if unitType == "HydrogenBomb" then "a Hydrogen Bomb" else "an Atom Bomb"
			self:PushEvent(
				"nuke",
				icon .. " " .. player.name .. " launched " .. prettyUnit .. (if victim then (" at " .. victim.name) else "") .. "!",
				"#f97316",
				tx,
				ty
			)
			if victim ~= nil and victim.smallId ~= player.smallId then
				if player.allies[victim.smallId] ~= nil then
					self:BreakAlliance(player, victim)
				end
				self.nextAlertId += 1
				self:PushAlert(victim.smallId, {
					id = self.nextAlertId,
					kind = "NukeInbound",
					fromSmallId = player.smallId,
					fromName = player.name,
					unitType = unitType,
					targetX = tx,
					targetY = ty,
					expiresTick = nukeUnit.endTick,
				})
			end
			return true
		end
	end

	-- 2. Warship
	if unitType == "Warship" then
		local bestPort: any = nil
		local bestDist = math.huge
		for _, u in ipairs(self.units) do
			if u.active and u.ownerSmallId == player.smallId and u.unitType == "Port" and not u.underConstruction then
				local dx, dy = u.x - tx, u.y - ty
				local d = dx * dx + dy * dy
				if d &lt; bestDist then
					bestDist = d
					bestPort = u
				end
			end
		end
		if bestPort == nil then
			return false
		end
		local spawnWater = MapCodec.AdjacentWater(map, bestPort.y * w + bestPort.x)
		if spawnWater == nil then
			return false
		end
		local patrolRef = if MapCodec.IsWater(map, targetRef) then targetRef else spawnWater
		player.gold -= cost
		local wx, wy = spawnWater % w, math.floor(spawnWater / w)
		local path = self:_CachedWaterPath(spawnWater, patrolRef, 30_000) or { spawnWater }
		self:_CreateUnit(player, "Warship", wx, wy, {
			patrolX = patrolRef % w,
			patrolY = math.floor(patrolRef / w),
			path = path,
			pathIdx = 1,
			hp = Config.WARSHIP_BASE_HP,
			maxHp = Config.WARSHIP_BASE_HP,
		})
		return true
	end

	-- 3. Port
	if unitType == "Port" then
		local chosenRef: number? = nil
		if MapCodec.GetOwner(map, targetRef) == player.smallId and MapCodec.IsShoreLand(map, targetRef) then
			chosenRef = targetRef
		else
			for r = 1, 10 do
				for dy = -r, r do
					for dx = -r, r do
						local nx, ny = tx + dx, ty + dy
						if nx &gt;= 0 and nx &lt; w and ny &gt;= 0 and ny &lt; h then
							local cand = ny * w + nx
							if MapCodec.GetOwner(map, cand) == player.smallId and MapCodec.IsShoreLand(map, cand) then
								chosenRef = cand
								break
							end
						end
					end
					if chosenRef ~= nil then
						break
					end
				end
				if chosenRef ~= nil then
					break
				end
			end
		end
		if chosenRef == nil or not self:CanPlaceStructureNear(player, chosenRef) then
			return false
		end
		player.gold -= cost
		self:_CreateUnit(player, "Port", chosenRef % w, math.floor(chosenRef / w), nil)
		return true
	end

	-- 4. Land Structures
	if CAPTURABLE_STRUCTURES[unitType] then
		local chosenRef: number? = nil
		if self:CanPlaceStructureNear(player, targetRef) then
			chosenRef = targetRef
		else
			for r = 1, 18 do
				for dy = -r, r, 2 do
					for dx = -r, r, 2 do
						local nx, ny = tx + dx, ty + dy
						if nx &gt;= 0 and nx &lt; w and ny &gt;= 0 and ny &lt; h then
							local cand = ny * w + nx
							if self:CanPlaceStructureNear(player, cand) then
								chosenRef = cand
								break
							end
						end
					end
					if chosenRef ~= nil then
						break
					end
				end
				if chosenRef ~= nil then
					break
				end
			end
		end
		if chosenRef == nil then
			return false
		end
		player.gold -= cost
		self:_CreateUnit(player, unitType, chosenRef % w, math.floor(chosenRef / w), nil)
		return true
	end

	return false
end

function SimEngine:MoveWarship(player: any, unitId: number, dstX: number, dstY: number): boolean
	local map = self.map
	local ix = math.clamp(math.floor(dstX), 0, map.width - 1)
	local iy = math.clamp(math.floor(dstY), 0, map.height - 1)
	local dstRef = iy * map.width + ix
	if not MapCodec.IsWater(map, dstRef) then
		return false
	end
	for _, u in ipairs(self.units) do
		if u.active and u.id == unitId and u.ownerSmallId == player.smallId and u.unitType == "Warship" then
			local curRef = math.floor(u.y) * map.width + math.floor(u.x)
			local path = self:_CachedWaterPath(curRef, dstRef, 30_000)
			if path ~= nil then
				u.patrolX = ix
				u.patrolY = iy
				u.path = path
				u.pathIdx = 1
				return true
			end
		end
	end
	return false
end

function SimEngine:_DetonateNuke(nuke: any)
	local map = self.map
	local w, h = map.width, map.height
	local cx, cy = math.clamp(math.floor(nuke.dstX), 0, w - 1), math.clamp(math.floor(nuke.dstY), 0, h - 1)
	local innerR, outerR = Config.NukeRadii(nuke.unitType, w)
	local innerSq = innerR * innerR
	local outerSq = outerR * outerR

	table.insert(self.explosions, {
		x = cx,
		y = cy,
		radius = outerR,
		kind = nuke.unitType,
	})

	local hitCountByOwner: { [number]: number } = {}
	local y0 = math.max(0, cy - outerR)
	local y1 = math.min(h - 1, cy + outerR)

	for py = y0, y1 do
		local dy = py - cy
		local rowOff = py * w
		for dxx = -outerR, outerR do
			local dSq = dxx * dxx + dy * dy
			if dSq &lt;= outerSq then
				local px = if map.wrapX then ((cx + dxx) % w) else (cx + dxx)
				if px &gt;= 0 and px &lt; w and (dSq &lt;= innerSq or self:_Rand() &lt; 0.55) then
					local ref = rowOff + px
					if not MapCodec.IsImpassable(map, ref) then
						local prevOwner = MapCodec.GetOwner(map, ref)
						if prevOwner &gt; 0 then
							hitCountByOwner[prevOwner] = (hitCountByOwner[prevOwner] or 0) + 1
							self:ConquerTile(0, ref)
						end
						if MapCodec.IsPlayableLand(map, ref) and MapCodec.SetFallout(map, ref, true) then
							if not self.inFalloutSet[ref] then
								self.inFalloutSet[ref] = true
								table.insert(self.activeFalloutRefs, ref)
							end
							self.falloutDeltaCount += 1
							self.falloutDeltaRefs[self.falloutDeltaCount] = ref
							self.falloutDeltaStates[self.falloutDeltaCount] = 1
						end
					end
				end
			end
		end
	end

	for oid, lostTiles in pairs(hitCountByOwner) do
		local victim = self.playersBySmallId[oid]
		if victim ~= nil and victim.alive then
			local prevTotal = math.max(1, victim.tilesOwned + lostTiles)
			local killFrac = math.min(0.85, (lostTiles / prevTotal) * 3.5)
			victim.troops = math.max(0, math.floor(victim.troops * (1 - killFrac)))
			local sender = self.playersBySmallId[nuke.ownerSmallId]
			if sender ~= nil and sender ~= victim then
				victim.relations[sender.smallId] = -100
			end
		end
	end
end

function SimEngine:_SeparateMIRV(mirvUnit: any)
	local map = self.map
	local w, h = map.width, map.height
	local sender = self.playersBySmallId[mirvUnit.ownerSmallId]
	if sender == nil then
		return
	end
	local targetId = mirvUnit.targetSmallId
	local candidateRefs = {}

	if targetId &gt; 0 then
		local step = math.max(1, math.floor(map.size / 8000))
		for ref = 0, map.size - 1, step do
			if MapCodec.GetOwner(map, ref) == targetId then
				table.insert(candidateRefs, ref)
			end
		end
	end
	if #candidateRefs == 0 then
		local spread = math.max(45, math.floor(90 * Config.MapScaleFactor(w)))
		for _ = 1, 32 do
			local rx = math.clamp(mirvUnit.realTargetX + self:_RandInt(-spread, spread), 0, w - 1)
			local ry = math.clamp(mirvUnit.realTargetY + self:_RandInt(-spread, spread), 0, h - 1)
			if MapCodec.IsPlayableLand(map, ry * w + rx) then
				table.insert(candidateRefs, ry * w + rx)
			end
		end
	end

	if #candidateRefs &gt; 0 then
		local warheadTotal = math.min(36, math.max(10, #candidateRefs))
		for k = 1, warheadTotal do
			local pick = candidateRefs[self:_RandInt(1, #candidateRefs)]
			local wx, wy = pick % w, math.floor(pick / w)
			self:_CreateUnit(sender, "MIRVWarhead", mirvUnit.x, mirvUnit.y, {
				srcX = mirvUnit.x,
				srcY = mirvUnit.y,
				dstX = wx,
				dstY = wy,
				startTick = self.ticks + (k % 8),
				endTick = self.ticks + 18 + (k % 14),
			})
		end
	end
end

function SimEngine:_RebuildRailNetwork()
	self.railNetworkDirty = false
	table.clear(self.railEdges)
	local stations = {}
	for _, u in ipairs(self.units) do
		if
			u.active
			and not u.underConstruction
			and (u.unitType == "City" or u.unitType == "Port" or u.unitType == "Factory")
		then
			table.insert(stations, u)
		end
	end
	for i = 1, #stations do
		stations[i].railLinks = {}
	end
	local sf = Config.MapScaleFactor(self.map.width)
	local minR = math.max(6, math.floor(Config.TRAIN_STATION_MIN_RANGE * sf))
	local maxR = math.max(60, math.floor(Config.TRAIN_STATION_MAX_RANGE * sf))
	local edgeBudget = 0
	for i = 1, #stations do
		if edgeBudget &gt;= 45 then
			break
		end
		local a = stations[i]
		for j = i + 1, #stations do
			local b = stations[j]
			local dx, dy = a.x - b.x, a.y - b.y
			local dSq = dx * dx + dy * dy
			if dSq &gt;= minR * minR and dSq &lt;= maxR * maxR and #a.railLinks &lt; 3 and #b.railLinks &lt; 3 then
				local ownerA = self.playersBySmallId[a.ownerSmallId]
				local ownerB = self.playersBySmallId[b.ownerSmallId]
				if ownerA ~= nil and ownerB ~= nil and not ownerA.embargoes[ownerB.smallId] and not ownerB.embargoes[ownerA.smallId] then
					local path = MapCodec.FindLandRailPath(
						self.map,
						a.y * self.map.width + a.x,
						b.y * self.map.width + b.x,
						maxR
					)
					if path ~= nil and #path &gt;= 2 then
						edgeBudget += 1
						table.insert(self.railEdges, path)
						table.insert(a.railLinks, { dest = b, path = path, forward = true })
						table.insert(b.railLinks, { dest = a, path = path, forward = false })
						if edgeBudget &gt;= 45 then
							break
						end
					end
				end
			end
		end
	end
end

function SimEngine:_TickEconomySpawns()
	if self.ticks % 12 == 0 then
		local openPorts = {}
		for _, u in ipairs(self.units) do
			if u.active and not u.underConstruction and u.unitType == "Port" then
				table.insert(openPorts, u)
			end
		end
		if #openPorts &gt;= 2 then
			for _ = 1, math.min(4, math.ceil(#openPorts / 3)) do
				local srcPort = openPorts[self:_RandInt(1, #openPorts)]
				local dstPort = openPorts[self:_RandInt(1, #openPorts)]
				if srcPort ~= dstPort and self.playersBySmallId[srcPort.ownerSmallId] ~= nil then
					local ownerA = self.playersBySmallId[srcPort.ownerSmallId]
					local ownerB = self.playersBySmallId[dstPort.ownerSmallId]
					if
						ownerA ~= nil
						and ownerB ~= nil
						and not ownerA.embargoes[ownerB.smallId]
						and not ownerB.embargoes[ownerA.smallId]
						and (ownerA.unitCounts["TradeShip"] or 0) &lt; 8
					then
						local w = self.map.width
						local path = self:_CachedWaterPath(srcPort.y * w + srcPort.x, dstPort.y * w + dstPort.x, 45_000)
						if path ~= nil and #path &gt;= 3 then
							local dist = math.sqrt((srcPort.x - dstPort.x) ^ 2 + (srcPort.y - dstPort.y) ^ 2)
							self:_CreateUnit(ownerA, "TradeShip", srcPort.x, srcPort.y, {
								dstX = dstPort.x,
								dstY = dstPort.y,
								dstPort = dstPort,
								dist = dist,
								path = path,
								pathIdx = 1,
								hp = 100,
								maxHp = 100,
							})
						end
					end
				end
			end
		end
	end

	if self.ticks % 16 == 4 then
		for _, u in ipairs(self.units) do
			if
				u.active
				and not u.underConstruction
				and u.unitType == "Factory"
				and u.railLinks ~= nil
				and #u.railLinks &gt; 0
			then
				local owner = self.playersBySmallId[u.ownerSmallId]
				if owner ~= nil and (owner.unitCounts["Train"] or 0) &lt; 6 and self:_Rand() &lt; 0.45 then
					local link = u.railLinks[self:_RandInt(1, #u.railLinks)]
					local orderedPath = {}
					if link.forward then
						for i = 1, #link.path do
							orderedPath[i] = link.path[i]
						end
					else
						for i = #link.path, 1, -1 do
							table.insert(orderedPath, link.path[i])
						end
					end
					self:_CreateUnit(owner, "Train", u.x, u.y, {
						dstX = link.dest.x,
						dstY = link.dest.y,
						destStation = link.dest,
						path = orderedPath,
						pathIdx = 1,
						stops = 1,
					})
				end
			end
		end
	end
end

function SimEngine:_TickUnits()
	local map = self.map
	local w = map.width
	local sf = Config.MapScaleFactor(w)
	local warshipRange = Config.WarshipRangeScaled(w)
	local dpShellRange = Config.DefensePostShellRangeScaled(w)

	for _, u in ipairs(self.units) do
		if not u.active then
			continue
		end
		local owner = self.playersBySmallId[u.ownerSmallId]
		if owner == nil or not owner.alive then
			self:_RemoveUnit(u)
			continue
		end

		if u.underConstruction and self.ticks &gt;= u.buildEndTick then
			u.underConstruction = false
			self:_AdjustPlayerStructureStats(owner, u.unitType, u.level, u, true)
			if u.unitType == "City" or u.unitType == "Port" or u.unitType == "Factory" then
				self.railNetworkDirty = true
			end
		end

		if u.unitType == "TransportShip" then
			local boatStep = math.max(2, math.floor(2.6 * sf + 0.5))
			u.pathIdx = math.min(#u.path, u.pathIdx + boatStep)
			local curRef = u.path[u.pathIdx]
			self:_GridUpdatePos(u, curRef % w, math.floor(curRef / w))
			if u.pathIdx &gt;= #u.path then
				local survivors = u.troops
				self:_RemoveUnit(u)
				if u.retreating then
					owner.troops = math.min(self:GetMaxTroops(owner), owner.troops + survivors)
				else
					local dstOwnerId = MapCodec.GetOwner(map, u.dstRef)
					owner.troops += survivors
					self:StartLandAttack(owner, dstOwnerId, survivors, u.dstRef)
				end
			end
		elseif u.unitType == "TradeShip" then
			local shipStep = math.max(2, math.floor(2.0 * sf + 0.5))
			u.pathIdx = math.min(#u.path, u.pathIdx + shipStep)
			local curRef = u.path[u.pathIdx]
			self:_GridUpdatePos(u, curRef % w, math.floor(curRef / w))
			if u.pathIdx &gt;= #u.path then
				local dstPort = u.dstPort
				local payout = Config.TradeShipGold(u.dist, w, self.config.goldMultiplier)
				owner.gold += payout
				owner.goldEarned += payout
				if dstPort ~= nil and dstPort.active then
					local dstOwner = self.playersBySmallId[dstPort.ownerSmallId]
					if dstOwner ~= nil and dstOwner.alive then
						dstOwner.gold += payout
						dstOwner.goldEarned += payout
					end
				end
				self:_RemoveUnit(u)
			end
		elseif u.unitType == "Train" then
			local stepN = math.max(2, math.floor(3.0 * sf + 0.5))
			u.pathIdx = math.min(#u.path, u.pathIdx + stepN)
			local curRef = u.path[u.pathIdx]
			self:_GridUpdatePos(u, curRef % w, math.floor(curRef / w))
			if u.pathIdx &gt;= #u.path then
				local st = u.destStation
				if st ~= nil and st.active then
					local stOwner = self.playersBySmallId[st.ownerSmallId]
					if stOwner ~= nil and stOwner.alive then
						local rel: "self" | "team" | "ally" | "other" = "other"
						if stOwner.smallId == owner.smallId then
							rel = "self"
						elseif owner.team ~= nil and owner.team == stOwner.team then
							rel = "team"
						elseif self:AreFriendly(owner, stOwner) then
							rel = "ally"
						end
						local gold = Config.TrainGold(rel, u.stops, self.config.goldMultiplier)
						owner.gold += gold
						owner.goldEarned += gold
						if stOwner ~= owner then
							stOwner.gold += gold
							stOwner.goldEarned += gold
						end
					end
				end
				self:_RemoveUnit(u)
			end
		elseif u.unitType == "Warship" then
			local warStep = math.max(2, math.floor(3.0 * sf + 0.5))
			if u.path ~= nil and u.pathIdx &lt; #u.path then
				u.pathIdx = math.min(#u.path, u.pathIdx + warStep)
				local curRef = u.path[u.pathIdx]
				self:_GridUpdatePos(u, curRef % w, math.floor(curRef / w))
			elseif self.ticks % 25 == (u.id % 25) then
				local angle = (self.ticks * 0.09 + u.id) % (math.pi * 2)
				local orbitR = math.max(12, math.floor(24 * sf))
				local ox = math.clamp(math.floor(u.patrolX + math.cos(angle) * orbitR), 0, w - 1)
				local oy = math.clamp(math.floor(u.patrolY + math.sin(angle) * orbitR), 0, map.height - 1)
				local oRef = oy * w + ox
				if MapCodec.IsWater(map, oRef) then
					local pth = MapCodec.FindWaterPath(map, math.floor(u.y) * w + math.floor(u.x), oRef, 1200)
					if pth ~= nil then
						u.path = pth
						u.pathIdx = 1
					end
				end
			end

			if u.hp &lt; u.maxHp and owner.portLevels &gt; 0 then
				u.hp = math.min(u.maxHp, u.hp + Config.WARSHIP_PASSIVE_HEAL)
			end

			-- Spatial O(1) Warship Piracy + Naval Combat!
			if self.ticks - u.lastShotTick &gt;= Config.WARSHIP_SHELL_RATE_TICKS then
				local pirateR2 = math.max(256, (22 * sf) ^ 2)
				self:_ForUnitsInRadius(u.x, u.y, warshipRange, function(target: any)
					if target.ownerSmallId ~= owner.smallId then
						local tOwner = self.playersBySmallId[target.ownerSmallId]
						if tOwner ~= nil and not self:AreFriendly(owner, tOwner) then
							local dx, dy = target.x - u.x, target.y - u.y
							local dSq = dx * dx + dy * dy
							if target.unitType == "TradeShip" and dSq &lt;= pirateR2 then
								local loot = Config.TradeShipGold(target.dist or 100, w, self.config.goldMultiplier)
								owner.gold += loot
								owner.goldEarned += loot
								self:_GrantVeterancyProgress(u, 2)
								self:_RemoveUnit(target)
								return true
							elseif target.unitType == "TransportShip" or target.unitType == "Warship" then
								u.lastShotTick = self.ticks
								local dmg = math.floor(Config.WARSHIP_SHELL_DAMAGE * (1 + u.veterancy * 0.2))
								target.hp -= dmg
								if target.hp &lt;= 0 then
									self:_GrantVeterancyProgress(u, 4)
									self:_RemoveUnit(target)
								end
								return true
							end
						end
					end
					return false
				end)
			end
		elseif u.unitType == "DefensePost" and not u.underConstruction then
			-- Coastal Battery Shelling against hostile amphibious fleets!
			if self.ticks - u.lastShotTick &gt;= Config.DEFENSE_POST_SHELL_RATE then
				self:_ForUnitsInRadius(u.x, u.y, dpShellRange, function(target: any)
					if target.ownerSmallId ~= owner.smallId and (target.unitType == "TransportShip" or target.unitType == "Warship") then
						local tOwner = self.playersBySmallId[target.ownerSmallId]
						if tOwner == nil or not self:AreFriendly(owner, tOwner) then
							u.lastShotTick = self.ticks
							target.hp -= 125
							if target.hp &lt;= 0 then
								self:_RemoveUnit(target)
							end
							return true
						end
					end
					return false
				end)
			end
		elseif u.unitType == "SAMLauncher" and not u.underConstruction then
			-- Spatial O(1) SAM Lock Reservation (`targetedBySam` prevents duplicate interceptor waste!)
			if self.ticks &gt;= u.cooldownUntilTick then
				local samR = Config.SamRangeScaled(u.level, w)
				self:_ForUnitsInRadius(u.x, u.y, samR, function(missile: any)
					if
						not missile.targetedBySam
						and (
							missile.unitType == "AtomBomb"
							or missile.unitType == "HydrogenBomb"
							or missile.unitType == "MIRVWarhead"
						)
					then
						local mOwner = self.playersBySmallId[missile.ownerSmallId]
						if mOwner == nil or not self:AreFriendly(owner, mOwner) then
							missile.targetedBySam = true
							u.cooldownUntilTick = self.ticks + Config.SAM_COOLDOWN_TICKS
							self:_CreateUnit(owner, "SAMMissile", u.x, u.y, {
								srcX = u.x,
								srcY = u.y,
								targetMissile = missile,
								startTick = self.ticks,
								endTick = self.ticks + 8,
							})
							return true
						end
					end
					return false
				end)
			end
		elseif u.unitType == "SAMMissile" then
			local m = u.targetMissile
			if m == nil or not m.active then
				self:_RemoveUnit(u)
			else
				local t = math.clamp((self.ticks - u.startTick) / math.max(1, u.endTick - u.startTick), 0, 1)
				u.progress = t
				self:_GridUpdatePos(u, u.srcX + (m.x - u.srcX) * t, u.srcY + (m.y - u.srcY) * t)
				if t &gt;= 1 then
					self:_RemoveUnit(m)
					self:_RemoveUnit(u)
				end
			end
		elseif
			u.unitType == "AtomBomb"
			or u.unitType == "HydrogenBomb"
			or u.unitType == "MIRV"
			or u.unitType == "MIRVWarhead"
		then
			if self.ticks &gt;= u.startTick then
				local dur = math.max(1, u.endTick - u.startTick)
				local t = math.clamp((self.ticks - u.startTick) / dur, 0, 1)
				u.progress = t
				local arcLift = math.sin(t * math.pi) * (if u.unitType == "MIRV" then 48 else 28)
				self:_GridUpdatePos(
					u,
					u.srcX + (u.dstX - u.srcX) * t,
					math.clamp(u.srcY + (u.dstY - u.srcY) * t - arcLift, 0, map.height - 1)
				)
				if t &gt;= 1 then
					if u.unitType == "MIRV" then
						self:_SeparateMIRV(u)
					else
						self:_DetonateNuke(u)
					end
					self:_RemoveUnit(u)
				end
			end
		end
	end

	if self.ticks % 20 == 0 then
		local writeIdx = 0
		for i = 1, #self.units do
			local u = self.units[i]
			if u.active then
				writeIdx += 1
				self.units[writeIdx] = u
			end
		end
		for j = #self.units, writeIdx + 1, -1 do
			self.units[j] = nil
		end
	end
end

function SimEngine:_GrantVeterancyProgress(warship: any, pts: number)
	warship.kills = (warship.kills or 0) + pts
	local newVet = math.min(Config.WARSHIP_MAX_VETERANCY, math.floor(warship.kills / 12))
	if newVet &gt; warship.veterancy then
		warship.veterancy = newVet
		warship.maxHp = math.floor(Config.WARSHIP_BASE_HP * (1 + newVet * (Config.WARSHIP_VET_BONUS_PCT / 100)))
		warship.hp = math.min(warship.maxHp, warship.hp + 200)
	end
end

function SimEngine:SendAllianceRequest(fromP: any, toP: any): boolean
	if self.config.disableAlliances or not fromP.alive or not toP.alive or self:AreFriendly(fromP, toP) then
		return false
	end
	if self.ticks - fromP.lastAllianceReqTick &lt; 30 then
		return false
	end
	fromP.lastAllianceReqTick = self.ticks

	if toP.playerType == "Nation" then
		local rel = toP.relations[fromP.smallId] or 0
		if not fromP.isTraitor and rel &gt; -30 and self:_Rand() &lt; 0.72 then
			self:FormAlliance(fromP, toP)
			self:SetEmoji(toP, "🤝")
			return true
		else
			self:SetEmoji(toP, "👎")
			return false
		end
	elseif toP.playerType == "Bot" then
		return false
	end

	self.nextAlertId += 1
	self:PushAlert(toP.smallId, {
		id = self.nextAlertId,
		kind = "AllianceRequest",
		fromSmallId = fromP.smallId,
		fromName = fromP.name,
		expiresTick = self.ticks + Config.ALLIANCE_REQUEST_DURATION_TICKS,
	})
	return true
end

function SimEngine:FormAlliance(a: any, b: any)
	local durTicks = math.max(600, self.config.allianceDurationMinutes * 60 * Config.TICKS_PER_SECOND)
	a.allies[b.smallId] = self.ticks + durTicks
	b.allies[a.smallId] = self.ticks + durTicks
	a.embargoes[b.smallId] = nil
	b.embargoes[a.smallId] = nil
	a.relations[b.smallId] = math.min(100, (a.relations[b.smallId] or 0) + 50)
	b.relations[a.smallId] = math.min(100, (b.relations[a.smallId] or 0) + 50)
	self.railNetworkDirty = true
	self:PushEvent("alliance", "🤝 " .. a.name .. " allied with " .. b.name .. "!", "#4ade80", nil, nil)
end

function SimEngine:BreakAlliance(breaker: any, partner: any)
	if breaker.allies[partner.smallId] == nil then
		return
	end
	breaker.allies[partner.smallId] = nil
	partner.allies[breaker.smallId] = nil
	breaker.isTraitor = true
	breaker.traitorUntilTick = self.ticks + Config.TRAITOR_DURATION_TICKS
	partner.relations[breaker.smallId] = -100
	partner.embargoes[breaker.smallId] = true
	for _, other in ipairs(self.playersList) do
		if other ~= breaker then
			other.relations[breaker.smallId] = math.max(-100, (other.relations[breaker.smallId] or 0) - 45)
		end
	end
	self:PushEvent("betrayal", "💀 " .. breaker.name .. " BETRAYED " .. partner.name .. "!", "#ef4444", breaker.labelX, breaker.labelY)
end

function SimEngine:DonateResources(sender: any, recipient: any, kind: "gold" | "troops", amount: number): boolean
	if not sender.alive or not recipient.alive or sender == recipient or not Config.IsFiniteNumber(amount) then
		return false
	end
	if self.ticks - sender.lastDonateTick &lt; 15 then
		return false
	end
	sender.lastDonateTick = self.ticks
	if kind == "gold" and self.config.donateGold then
		local amt = math.floor(math.min(sender.gold, math.max(0, amount)))
		if amt &lt;= 0 then
			return false
		end
		sender.gold -= amt
		recipient.gold += amt
		recipient.relations[sender.smallId] = math.min(100, (recipient.relations[sender.smallId] or 0) + 25)
		self:PushEvent("donate", "💰 " .. sender.name .. " sent " .. Format.Gold(amt) .. " Gold to " .. recipient.name, "#f59e0b", nil, nil)
		return true
	elseif kind == "troops" and self.config.donateTroops then
		local amt = math.floor(math.min(sender.troops * 0.9, math.max(0, amount)))
		if amt &lt;= 0 then
			return false
		end
		sender.troops -= amt
		recipient.troops = math.min(self:GetMaxTroops(recipient), recipient.troops + amt)
		recipient.relations[sender.smallId] = math.min(100, (recipient.relations[sender.smallId] or 0) + 25)
		self:PushEvent("donate", "⚔️ " .. sender.name .. " sent " .. Format.Troops(amt) .. " Troops to " .. recipient.name, "#38bdf8", nil, nil)
		return true
	end
	return false
end

function SimEngine:SetEmoji(player: any, emoji: string)
	if self.ticks - player.lastEmojiTick &lt; Config.EMOJI_COOLDOWN_TICKS then
		return
	end
	player.lastEmojiTick = self.ticks
	player.emoji = emoji
	player.emojiUntilTick = self.ticks + Config.EMOJI_DURATION_TICKS
end

function SimEngine:PickHostileTargetForNuke(p: any): any
	local best: any = nil
	local bestTiles = 0
	for _, other in ipairs(self.playersList) do
		if other.alive and other ~= p and not self:AreFriendly(p, other) and other.playerType ~= "Bot" then
			local rel = p.relations[other.smallId] or 0
			if (rel &lt;= -40 or other.tilesOwned &gt; p.tilesOwned * 1.4) and other.tilesOwned &gt; bestTiles then
				bestTiles = other.tilesOwned
				best = other
			end
		end
	end
	return best
end

function SimEngine:_SweepPocketSpeckles()
	local map = self.map
	local nbuf = { 0, 0, 0, 0 }
	local nbuf2 = { 0, 0, 0, 0 }
	for _, p in ipairs(self.playersList) do
		if p.alive and #p.borderList &gt; 0 then
			local bLen = #p.borderList
			local limit = math.min(bLen, 220)
			local startIdx = ((self.ticks * 13) % bLen) + 1
			for s = 0, limit - 1 do
				local bRef = p.borderList[((startIdx + s - 1) % bLen) + 1]
				if bRef ~= nil and MapCodec.GetOwner(map, bRef) == p.smallId then
					local n = MapCodec.Neighbors4(map, bRef, nbuf)
					for i = 1, n do
						local nb = nbuf[i]
						if MapCodec.IsPlayableLand(map, nb) then
							local nbOwner = MapCodec.GetOwner(map, nb)
							if nbOwner ~= p.smallId then
								local sameCount = 0
								local waterCount = 0
								local n2 = MapCodec.Neighbors4(map, nb, nbuf2)
								for j = 1, n2 do
									local o2 = MapCodec.GetOwner(map, nbuf2[j])
									if o2 == p.smallId then
										sameCount += 1
									elseif not MapCodec.IsPlayableLand(map, nbuf2[j]) then
										waterCount += 1
									end
								end
								if sameCount &gt;= 3 or (sameCount &gt;= 2 and sameCount + waterCount &gt;= 4) then
									self:ConquerTile(p.smallId, nb)
								end
							end
						end
					end
				end
			end
		end
	end
end

function SimEngine:Step()
	if self.gameOver then
		return
	end

	if self.deltaCount &gt; self.map.size * 2 then
		self.deltaCount = 0
	end
	if self.falloutDeltaCount &gt; self.map.size * 2 then
		self.falloutDeltaCount = 0
	end
	if #self.explosions &gt; 64 then
		table.clear(self.explosions)
	end
	self.ticks += 1

	if self.inSpawnPhase then
		if self.ticks &gt;= self.spawnPhaseTicks then
			self.inSpawnPhase = false
			self:_FinalizeSpawns()
			self:PushEvent(
				"info",
				string.format("⚔️ Borders unlocked on %s (%dx%d)!", self.map.name, self.map.width, self.map.height),
				"#38bdf8",
				nil,
				nil
			)
		end
		return
	end

	local elapsedSeconds = (self.ticks - self.spawnPhaseTicks) / Config.TICKS_PER_SECOND
	local doomReqShare = Config.DoomsdayRequiredShare(self.config, elapsedSeconds)

	for _, p in ipairs(self.playersList) do
		if p.alive then
			p.survivedTicks += 1
			local maxT = self:GetMaxTroops(p)
			p.troops += Config.TroopIncreasePerTick(p.troops, maxT, p.playerType, self.config)
			local g = Config.GoldPerTick(
				p.playerType,
				self.config,
				p.troops,
				p.tilesOwned,
				p.cityLevels,
				p.portLevels,
				p.factoryLevels
			)
			p.gold += g
			p.goldEarned += g

			if p.isTraitor and self.ticks &gt;= p.traitorUntilTick then
				p.isTraitor = false
			end
			if p.emoji ~= nil and self.ticks &gt;= p.emojiUntilTick then
				p.emoji = nil
			end

			for allyId, expTick in pairs(p.allies) do
				if self.ticks &gt;= expTick then
					p.allies[allyId] = nil
				elseif expTick - self.ticks == 200 and p.playerType == "Human" then
					local allyP = self.playersBySmallId[allyId]
					if allyP ~= nil and allyP.alive then
						self.nextAlertId += 1
						self:PushAlert(p.smallId, {
							id = self.nextAlertId,
							kind = "AllianceExpiring",
							fromSmallId = allyId,
							fromName = allyP.name,
							expiresTick = expTick,
						})
					end
				end
			end

			for tid, expTick in pairs(p.targetedBy) do
				if self.ticks &gt;= expTick then
					p.targetedBy[tid] = nil
				end
			end

			if doomReqShare &gt; 0 then
				local share = p.tilesOwned / math.max(1, self.map.numLandTiles)
				if share &lt; doomReqShare then
					p.isDoomed = true
					if p.doomWarnStartTick &lt; 0 then
						p.doomWarnStartTick = self.ticks
					elseif self.ticks - p.doomWarnStartTick &gt; 150 then
						local floorT = maxT * 0.05
						if p.troops &gt; floorT then
							p.troops = math.max(floorT, p.troops - maxT * 0.004)
						end
					end
				else
					p.isDoomed = false
					p.doomWarnStartTick = -1
				end
			end
		end
	end

	AiBrain.StepAll(self, self.ticks)

	self:_TickAttacks()
	if self.ticks % 8 == 0 then
		self:_SweepPocketSpeckles()
	end

	if self.railNetworkDirty and self.ticks % 10 == 0 then
		self:_RebuildRailNetwork()
	end
	self:_TickEconomySpawns()
	self:_TickUnits()

	-- Sparse Active Fallout Decay (`O(activeCraters)` instead of scanning `8,002,384` tiles!)
	if #self.activeFalloutRefs &gt; 0 and self.ticks % 12 == 0 then
		local active = self.activeFalloutRefs
		local samples = math.min(#active, 24)
		for _ = 1, samples do
			local idx = self:_RandInt(1, #active)
			local ref = active[idx]
			if MapCodec.HasFallout(self.map, ref) then
				if self:_Rand() &lt; 0.14 and MapCodec.SetFallout(self.map, ref, false) then
					self.falloutDeltaCount += 1
					self.falloutDeltaRefs[self.falloutDeltaCount] = ref
					self.falloutDeltaStates[self.falloutDeltaCount] = 0
					self.inFalloutSet[ref] = nil
					local last = active[#active]
					active[idx] = last
					active[#active] = nil
					if #active == 0 then
						break
					end
				end
			else
				self.inFalloutSet[ref] = nil
				local last = active[#active]
				active[idx] = last
				active[#active] = nil
				if #active == 0 then
					break
				end
			end
		end
	end

	if self.ticks % 10 == 2 then
		local bx, by, bspan = MapCodec.ComputeAllLabelBoxes(self.map, self.nextSmallId)
		for sid = 1, self.nextSmallId do
			local p = self.playersBySmallId[sid]
			if p ~= nil and p.alive and bspan[sid] &gt; 0 then
				p.labelX = bx[sid]
				p.labelY = by[sid]
				p.labelSpan = bspan[sid]
			end
		end
	end

	if self.ticks % 10 == 5 and not self.isPreview then
		local reqPct = Config.WinPercentageRequired(self.config, elapsedSeconds)
		local totalLand = math.max(1, self.map.numLandTiles)
		local aliveCount = 0
		local lastAlive: any = nil
		local teamTiles: { [string]: number } = {}

		for _, p in ipairs(self.playersList) do
			if p.alive and p.tilesOwned &gt; 0 then
				aliveCount += 1
				lastAlive = p
				if p.team ~= nil then
					teamTiles[p.team] = (teamTiles[p.team] or 0) + p.tilesOwned
				else
					local pct = (p.tilesOwned / totalLand) * 100
					if pct &gt;= reqPct then
						self.gameOver = true
						self.winnerSmallId = p.smallId
						self.winnerName = p.name
						break
					end
				end
			end
		end

		if not self.gameOver and self.config.mode == "Teams" then
			for teamName, tCount in pairs(teamTiles) do
				if (tCount / totalLand) * 100 &gt;= reqPct then
					self.gameOver = true
					self.winnerTeam = teamName
					self.winnerName = "Team " .. teamName
					break
				end
			end
		end

		if not self.gameOver and aliveCount &lt;= 1 and self.ticks &gt; self.spawnPhaseTicks + 30 then
			self.gameOver = true
			if lastAlive ~= nil then
				self.winnerSmallId = lastAlive.smallId
				self.winnerTeam = lastAlive.team
				self.winnerName = if lastAlive.team then ("Team " .. lastAlive.team) else lastAlive.name
			else
				self.winnerName = "Stalemate"
			end
		end
	end
end

function SimEngine:BuildTickPayload(includeFullMap: boolean)
	local tileBuf = if includeFullMap
		then NetCodec.EncodeFullOwnerSnapshot(self.map.owner, self.map.size)
		else NetCodec.EncodeTileDeltas(self.deltaRefs, self.deltaOwners, self.deltaCount)
	local falloutBuf = if self.falloutDeltaCount &gt; 0
		then NetCodec.EncodeFalloutDeltas(self.falloutDeltaRefs, self.falloutDeltaStates, self.falloutDeltaCount)
		else nil
	local falloutSnapshot = if includeFullMap
		then NetCodec.EncodeFullFalloutSnapshot(self.map.fallout, self.map.size)
		else nil
	local explosionsOut = table.clone(self.explosions)
	if not includeFullMap then
		self.deltaCount = 0
		self.falloutDeltaCount = 0
		table.clear(self.explosions)
	end

	local outTroops: { [number]: number } = {}
	local activeAttacksList = {}
	for _, atk in ipairs(self.attacks) do
		if atk.active then
			outTroops[atk.attackerSmallId] = (outTroops[atk.attackerSmallId] or 0) + atk.troops
			local ap = self.playersBySmallId[atk.attackerSmallId]
			if ap ~= nil and ap.playerType == "Human" then
				table.insert(activeAttacksList, {
					id = atk.id,
					attackerSmallId = atk.attackerSmallId,
					targetSmallId = atk.targetSmallId,
					troops = math.floor(atk.troops),
					retreating = atk.retreating == true,
					isBoat = atk.isBoat,
				})
			end
		end
	end

	local playersOut = table.create(#self.playersList)
	for i, p in ipairs(self.playersList) do
		local alliesArr = {}
		for aid, _ in pairs(p.allies) do
			table.insert(alliesArr, aid)
		end
		local embArr = {}
		for eid, _ in pairs(p.embargoes) do
			table.insert(embArr, eid)
		end
		local targArr = {}
		for tid, _ in pairs(p.targetedBy) do
			table.insert(targArr, tid)
		end
		local maxT = self:GetMaxTroops(p)
		playersOut[i] = {
			smallId = p.smallId,
			userId = p.userId,
			playerType = p.playerType,
			name = p.name,
			flag = p.flag,
			colorHex = p.colorHex,
			patternId = p.patternId,
			team = p.team,
			alive = p.alive,
			hasSpawned = p.hasSpawned,
			spawnX = p.spawnX,
			spawnY = p.spawnY,
			labelX = p.labelX,
			labelY = p.labelY,
			labelSpan = p.labelSpan,
			tilesOwned = p.tilesOwned,
			troops = math.floor(p.troops),
			maxTroops = maxT,
			troopRatePerSec = math.floor(Config.TroopIncreasePerTick(p.troops, maxT, p.playerType, self.config) * 10),
			attackingTroops = math.floor(outTroops[p.smallId] or 0),
			gold = math.floor(p.gold),
			isTraitor = p.isTraitor,
			isDoomed = p.isDoomed,
			allies = alliesArr,
			embargoes = embArr,
			emoji = p.emoji,
			targetedBy = targArr,
			unitCounts = p.unitCounts,
		}
	end

	local unitsOut = table.create(#self.units)
	for _, u in ipairs(self.units) do
		if u.active then
			local buildProg = 1.0
			if u.underConstruction then
				local dur = math.max(1, u.buildEndTick - u.buildStartTick)
				buildProg = math.clamp((self.ticks - u.buildStartTick) / dur, 0, 1)
			end
			table.insert(unitsOut, {
				id = u.id,
				unitType = u.unitType,
				ownerSmallId = u.ownerSmallId,
				x = u.x,
				y = u.y,
				srcX = u.srcX,
				srcY = u.srcY,
				dstX = u.dstX,
				dstY = u.dstY,
				patrolX = u.patrolX,
				patrolY = u.patrolY,
				level = u.level,
				hp = u.hp,
				maxHp = u.maxHp,
				veterancy = u.veterancy or 0,
				underConstruction = u.underConstruction,
				constructionProgress = buildProg,
				onCooldown = self.ticks &lt; (u.cooldownUntilTick or 0),
				troops = math.floor(u.troops or 0),
				progress = u.progress or 0,
			})
		end
	end

	local elapsedSeconds = math.max(0, (self.ticks - self.spawnPhaseTicks) / Config.TICKS_PER_SECOND)
	return {
		isFullSnapshot = includeFullMap,
		isPreview = self.isPreview,
		mapId = self.map.id,
		ticks = self.ticks,
		inSpawnPhase = self.inSpawnPhase,
		spawnSecondsLeft = math.max(0, (self.spawnPhaseTicks - self.ticks) / Config.TICKS_PER_SECOND),
		elapsedSeconds = elapsedSeconds,
		winPercentRequired = Config.WinPercentageRequired(self.config, elapsedSeconds),
		doomsdayShare = Config.DoomsdayRequiredShare(self.config, elapsedSeconds),
		mirvsLaunched = self.mirvsLaunched,
		simSpeed = self.simSpeed,
		paused = self.paused,
		config = self.config,
		tileBuffer = tileBuf,
		falloutBuffer = falloutBuf,
		falloutSnapshot = falloutSnapshot,
		players = playersOut,
		units = unitsOut,
		attacks = activeAttacksList,
		railEdges = self.railEdges,
		events = self.events,
		explosions = explosionsOut,
		alertsByPlayer = self.alertsByPlayer,
		gameOver = self.gameOver,
		winnerName = self.winnerName,
		winnerSmallId = self.winnerSmallId,
		winnerTeam = self.winnerTeam,
	}
end

return SimEngine
</ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX000115"><Properties><string name="Name">StarterGui</string></Properties></Item><Item class="StarterPack" referent="RBX000116"><Properties><string name="Name">StarterPack</string></Properties></Item><Item class="StarterPlayer" referent="RBX000117"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000118"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000119"><Properties><string name="Name">OpenFrontClient</string></Properties><Item class="ModuleScript" referent="RBX000120"><Properties><string name="Name">Camera2D</string><ProtectedString name="Source">--!native
--!strict
-- Pure 2D Browser-Exact Viewport Transform (exact port of OpenFront TransformHandler.ts)
-- Upgraded for Full-Scale 1:1 Maps (1000x1000 .. 4108x1948):
--   - Smooth inertial zoom (`targetScale` exponential easing + instant cursor anchor)
--   - Immersive Regional Spawn Framing (`FrameSpawnView` fills 100% of screen cleanly — zero tiny postage stamp!)
--   - Centered viewport bounds clamping (`_ClampBounds`) + NaN safety

local Camera2D = {}
Camera2D.__index = Camera2D

export type Camera2DInstance = typeof(setmetatable(
	{} :: {
		mapW: number,
		mapH: number,
		viewW: number,
		viewH: number,
		centerX: number,
		centerY: number,
		scale: number,
		targetScale: number,
		zoomAnchorX: number,
		zoomAnchorY: number,
		minScale: number,
		maxScale: number,
		panVelX: number,
		panVelY: number,
	},
	Camera2D
))

local function finiteOr(v: number, fallback: number): number
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return fallback
	end
	return v
end

function Camera2D.new(mapW: number, mapH: number, viewW: number, viewH: number): Camera2DInstance
	local vw = math.max(1, finiteOr(viewW, 1280))
	local vh = math.max(1, finiteOr(viewH, 720))
	local mw = math.max(1, finiteOr(mapW, 2000))
	local mh = math.max(1, finiteOr(mapH, 1000))
	-- Fill screen cleanly by default instead of shrinking map inside big margins!
	local coverScale = math.max(vw / mw, vh / mh)
	local fitScale = math.min(vw / mw, vh / mh) * 0.96
	local self = setmetatable({
		mapW = mw,
		mapH = mh,
		viewW = vw,
		viewH = vh,
		centerX = mw * 0.52,
		centerY = mh * 0.44,
		scale = coverScale,
		targetScale = coverScale,
		zoomAnchorX = vw * 0.5,
		zoomAnchorY = vh * 0.5,
		minScale = math.max(0.18, fitScale * 0.85),
		maxScale = 28.0,
		panVelX = 0,
		panVelY = 0,
	}, Camera2D)
	return self
end

function Camera2D:SetMapSize(mapW: number, mapH: number)
	self.mapW = math.max(1, finiteOr(mapW, 2000))
	self.mapH = math.max(1, finiteOr(mapH, 1000))
	self:FrameSpawnView()
end

function Camera2D:SetViewportSize(viewW: number, viewH: number)
	self.viewW = math.max(1, finiteOr(viewW, 1280))
	self.viewH = math.max(1, finiteOr(viewH, 720))
	local fitScale = math.min(self.viewW / self.mapW, self.viewH / self.mapH) * 0.96
	self.minScale = math.max(0.18, fitScale * 0.85)
	self.scale = math.clamp(self.scale, self.minScale, self.maxScale)
	self.targetScale = math.clamp(self.targetScale, self.minScale, self.maxScale)
	self:_ClampBounds()
end

-- Full-bleed edge-to-edge world framing (zero ugly empty ocean borders on spawn!)
function Camera2D:FrameSpawnView()
	local fitScale = math.min(self.viewW / self.mapW, self.viewH / self.mapH) * 0.96
	local coverScale = math.max(self.viewW / self.mapW, self.viewH / self.mapH)
	self.minScale = math.max(0.18, fitScale * 0.85)
	self.scale = math.clamp(coverScale, self.minScale, self.maxScale)
	self.targetScale = self.scale
	self.centerX = self.mapW * 0.52
	self.centerY = self.mapH * 0.44
	self:_ClampBounds()
end

-- Full planetary overview hotkey (`0` / `Fit` button)
function Camera2D:FitWorld()
	local fitScale = math.min(self.viewW / self.mapW, self.viewH / self.mapH) * 0.96
	self.minScale = math.max(0.18, fitScale * 0.85)
	self.scale = math.max(self.minScale, fitScale)
	self.targetScale = self.scale
	self.centerX = self.mapW * 0.5
	self.centerY = self.mapH * 0.5
	self:_ClampBounds()
end

function Camera2D:FocusOn(tileX: number, tileY: number, desiredScale: number?)
	self.centerX = math.clamp(finiteOr(tileX, self.mapW * 0.5), 0, self.mapW)
	self.centerY = math.clamp(finiteOr(tileY, self.mapH * 0.5), 0, self.mapH)
	if desiredScale ~= nil then
		local s = math.clamp(finiteOr(desiredScale, self.scale), self.minScale, self.maxScale)
		self.scale = s
		self.targetScale = s
	end
	self:_ClampBounds()
end

function Camera2D:_ClampBounds()
	local halfVisW = (self.viewW * 0.5) / self.scale
	local halfVisH = (self.viewH * 0.5) / self.scale
	if self.mapW * self.scale &lt;= self.viewW * 0.98 then
		self.centerX = math.clamp(self.centerX, self.mapW * 0.25, self.mapW * 0.75)
	else
		local minX = math.min(self.mapW * 0.5, halfVisW * 0.45)
		local maxX = math.max(self.mapW * 0.5, self.mapW - halfVisW * 0.45)
		self.centerX = math.clamp(self.centerX, minX, maxX)
	end
	if self.mapH * self.scale &lt;= self.viewH * 0.98 then
		self.centerY = math.clamp(self.centerY, self.mapH * 0.25, self.mapH * 0.75)
	else
		local minY = math.min(self.mapH * 0.5, halfVisH * 0.45)
		local maxY = math.max(self.mapH * 0.5, self.mapH - halfVisH * 0.45)
		self.centerY = math.clamp(self.centerY, minY, maxY)
	end
end

-- Cursor-anchored zoom (supports smooth `StepZoom(dt)` AND immediate responsive zoom!)
function Camera2D:ZoomAtScreenPoint(factor: number, screenX: number, screenY: number, smooth: boolean?)
	local sx = finiteOr(screenX, self.viewW * 0.5)
	local sy = finiteOr(screenY, self.viewH * 0.5)
	local f = finiteOr(factor, 1.0)
	if smooth then
		self.targetScale = math.clamp(self.targetScale * f, self.minScale, self.maxScale)
		self.zoomAnchorX = sx
		self.zoomAnchorY = sy
	else
		local beforeWX, beforeWY = self:ScreenToWorldFloat(sx, sy)
		self.scale = math.clamp(self.scale * f, self.minScale, self.maxScale)
		self.targetScale = self.scale
		local afterWX, afterWY = self:ScreenToWorldFloat(sx, sy)
		self.centerX += beforeWX - afterWX
		self.centerY += beforeWY - afterWY
		self:_ClampBounds()
	end
end

function Camera2D:StepZoom(dt: number)
	if math.abs(self.targetScale - self.scale) &gt; 0.0005 then
		local sx = self.zoomAnchorX
		local sy = self.zoomAnchorY
		local beforeWX, beforeWY = self:ScreenToWorldFloat(sx, sy)
		local alpha = 1 - math.exp(-math.max(0.001, dt) * 16.0)
		self.scale = self.scale + (self.targetScale - self.scale) * alpha
		local afterWX, afterWY = self:ScreenToWorldFloat(sx, sy)
		self.centerX += beforeWX - afterWX
		self.centerY += beforeWY - afterWY
		self:_ClampBounds()
	end
end

function Camera2D:PanByScreenDelta(dxPx: number, dyPx: number)
	self.centerX -= finiteOr(dxPx, 0) / self.scale
	self.centerY -= finiteOr(dyPx, 0) / self.scale
	self:_ClampBounds()
end

function Camera2D:StepKeyboard(moveX: number, moveY: number, dt: number)
	self:StepZoom(dt)
	if moveX ~= 0 or moveY ~= 0 then
		local speedPxPerSec = 760
		self.centerX += (moveX * speedPxPerSec * dt) / self.scale
		self.centerY += (moveY * speedPxPerSec * dt) / self.scale
		self:_ClampBounds()
	end
end

function Camera2D:ScreenToWorldFloat(screenX: number, screenY: number): (number, number)
	local wx = self.centerX + (finiteOr(screenX, 0) - self.viewW * 0.5) / self.scale
	local wy = self.centerY + (finiteOr(screenY, 0) - self.viewH * 0.5) / self.scale
	return wx, wy
end

function Camera2D:ScreenToTile(screenX: number, screenY: number): (number, number, boolean)
	local wx, wy = self:ScreenToWorldFloat(screenX, screenY)
	local tx = math.floor(wx)
	local ty = math.floor(wy)
	local inside = tx &gt;= 0 and tx &lt; self.mapW and ty &gt;= 0 and ty &lt; self.mapH
	return tx, ty, inside
end

function Camera2D:WorldToScreen(worldX: number, worldY: number): (number, number)
	local sx = self.viewW * 0.5 + (worldX - self.centerX) * self.scale
	local sy = self.viewH * 0.5 + (worldY - self.centerY) * self.scale
	return sx, sy
end

function Camera2D:GetCanvasRect(): (number, number, number, number)
	local leftPx = math.floor(self.viewW * 0.5 - self.centerX * self.scale + 0.5)
	local topPx = math.floor(self.viewH * 0.5 - self.centerY * self.scale + 0.5)
	local widthPx = math.floor(self.mapW * self.scale + 0.5)
	local heightPx = math.floor(self.mapH * self.scale + 0.5)
	return leftPx, topPx, widthPx, heightPx
end

return Camera2D
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000121"><Properties><string name="Name">HudUI</string><ProtectedString name="Source">--!strict
-- Complete Browser-Exact In-Game OpenFront HUD:
--   1. Spawn Phase Top Banner + Instant Start
--   2. Bottom-Left ControlPanel (Troops/Max + Rate/s, Gold + Floating Gain, Active Attacks Retreat,
--      Attack Ratio Slider 1%..100%, Quick Action Hotbar)
--   3. Top-Right Collapsible Leaderboard + Timer + Win % / Overtime / Doomsday Status
--   4. Bottom-Right Interactive Minimap + Clickable Event Feed + Actionable Alerts (Alliance &amp; Nuke Siren!)
--   5. Circular Radial Menu (Attack, Boat, Build, Ally/Break, Inspect/Donate, Emoji, Upgrade, Delete)
--   6. Floating Build Menu (All 10 OpenFront Units with live dynamic Gold costs &amp; armed placement mode)
--   7. Player Inspector &amp; Donate Gold/Troops Modal + Emoji Wheel + Quick Chat + Victory/XP Ceremony Modal!

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")

local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local MapRegistry = require(Shared:WaitForChild("Maps"):WaitForChild("MapRegistry"))
local Theme = require(Shared:WaitForChild("Theme"))

local SoundFX = require(script.Parent:WaitForChild("SoundFX"))
local UiWidgets = require(script.Parent:WaitForChild("UiWidgets"))

local HudUI = {}
HudUI.__index = HudUI

local BUILD_ITEMS: { { unitType: string, icon: string, label: string, desc: string, countable: boolean } } = {
	{ unitType = "City", icon = "🏙️", label = "City", desc = "+250K Max Troops", countable = true },
	{ unitType = "Port", icon = "⚓", label = "Port", desc = "Coastal Trade Ships", countable = true },
	{ unitType = "Factory", icon = "🏭", label = "Factory", desc = "Railroads &amp; Gold Trains", countable = true },
	{ unitType = "DefensePost", icon = "🛡️", label = "Defense Post", desc = "5x Border Defense", countable = true },
	{ unitType = "Warship", icon = "🚢", label = "Warship", desc = "Sinks Boats &amp; Pirates Gold", countable = true },
	{ unitType = "MissileSilo", icon = "🚀", label = "Missile Silo", desc = "Launches Nukes &amp; MIRVs", countable = true },
	{ unitType = "SAMLauncher", icon = "📡", label = "SAM Launcher", desc = "Intercepts Nukes", countable = true },
	{ unitType = "AtomBomb", icon = "☢️", label = "Atom Bomb", desc = "Tactical Nuclear Strike", countable = false },
	{ unitType = "HydrogenBomb", icon = "💥", label = "Hydrogen Bomb", desc = "Massive 90-Tile Blast", countable = false },
	{ unitType = "MIRV", icon = "☄️", label = "MIRV", desc = "Carpet Warheads Over Empire", countable = false },
}

export type HudInstance = typeof(setmetatable({} :: any, HudUI))

function HudUI.new(parentGui: ScreenGui, camera: any, mapCanvas: any, callbacks: {
	onSendIntent: (intent: string, payload: any) -&gt; (),
	onExitToMenu: () -&gt; (),
}): HudInstance
	local self = setmetatable({}, HudUI) :: any
	self.camera = camera
	self.canvas = mapCanvas
	self.callbacks = callbacks
	self.attackRatio = 0.25
	self.boatModeArmed = false
	self.leaderboardOpen = true
	self.mySmallId = 0
	self.latestState = nil :: any
	self.lastGold = -1
	self.seenAlertIds = {} :: { [number]: boolean }
	self.inspectedSmallId = nil :: number?

	local root = Instance.new("Frame")
	root.Name = "InGameHUD"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.Visible = false
	root.ZIndex = 15
	root.Parent = parentGui
	self.root = root

	local uiScale = Instance.new("UIScale")
	uiScale.Name = "ResponsiveUIScale"
	uiScale.Scale = 1
	uiScale.Parent = root
	self.uiScale = uiScale

	-- Fullscreen modal backdrop scrim so Build / Inspector / Victory modals NEVER collide with background map text!
	local modalScrim = Instance.new("TextButton")
	modalScrim.Name = "HudModalScrim"
	modalScrim.Size = UDim2.fromScale(1, 1)
	modalScrim.BackgroundColor3 = Color3.fromRGB(4, 9, 20)
	modalScrim.BackgroundTransparency = 0.36
	modalScrim.BorderSizePixel = 0
	modalScrim.Text = ""
	modalScrim.AutoButtonColor = false
	modalScrim.Visible = false
	modalScrim.ZIndex = 33
	modalScrim.Parent = root
	self.modalScrim = modalScrim
	modalScrim.Activated:Connect(function()
		self.buildPopup.Visible = false
		self.inspectorModal.Visible = false
		self.emojiPopup.Visible = false
		self.chatPopup.Visible = false
		self.radialRoot.Visible = false
		if not self.resultModal.Visible then
			modalScrim.Visible = false
		end
	end)

	self:_BuildTopBanners()
	self:_BuildControlPanel()
	self:_BuildLeaderboard()
	self:_BuildMinimapAndFeed()
	self:_BuildRadialMenu()
	self:_BuildMenuPopup()
	self:_BuildPlayerInspectorModal()
	self:_BuildEmojiAndChatPopups()
	self:_BuildResultModal()

	return self
end

function HudUI:_BuildTopBanners()
	-- Spawn Phase Banner
	local spawnBanner = Instance.new("Frame")
	spawnBanner.AnchorPoint = Vector2.new(0.5, 0)
	spawnBanner.Position = UDim2.new(0.5, 0, 0, 14)
	spawnBanner.Size = UDim2.fromOffset(470, 56)
	spawnBanner.BackgroundColor3 = Color3.fromRGB(24, 32, 48)
	spawnBanner.BackgroundTransparency = 0.08
	spawnBanner.BorderSizePixel = 0
	spawnBanner.Visible = false
	spawnBanner.ZIndex = 20
	UiWidgets.AddCorner(spawnBanner, 10)
	UiWidgets.AddStroke(spawnBanner, Color3.fromRGB(250, 204, 21), 2, 0.15)
	spawnBanner.Parent = self.root
	self.spawnBanner = spawnBanner

	local spawnLbl = Instance.new("TextLabel")
	spawnLbl.Position = UDim2.fromOffset(14, 6)
	spawnLbl.Size = UDim2.new(1, -28, 1, -12)
	spawnLbl.BackgroundTransparency = 1
	spawnLbl.Font = Enum.Font.GothamBlack
	spawnLbl.TextSize = 15
	spawnLbl.TextWrapped = true
	spawnLbl.TextColor3 = Color3.fromRGB(254, 240, 138)
	spawnLbl.Text = "📍 CLICK ANY LAND TO PICK YOUR SPAWN — Starting in 10.0s"
	spawnLbl.ZIndex = 21
	spawnLbl.Parent = spawnBanner
	self.spawnLbl = spawnLbl

	-- Armed Mode Indicator Pill (when placing a building/nuke or launching a Boat!)
	local armedPill = Instance.new("Frame")
	armedPill.AnchorPoint = Vector2.new(0.5, 0)
	armedPill.Position = UDim2.new(0.5, 0, 0, 14)
	armedPill.Size = UDim2.fromOffset(430, 40)
	armedPill.BackgroundColor3 = Color3.fromRGB(124, 45, 18)
	armedPill.BorderSizePixel = 0
	armedPill.Visible = false
	armedPill.ZIndex = 22
	UiWidgets.AddCorner(armedPill, 99)
	UiWidgets.AddStroke(armedPill, Color3.fromRGB(251, 191, 36), 2, 0.1)
	armedPill.Parent = self.root
	self.armedPill = armedPill

	local armedTxt = Instance.new("TextLabel")
	armedTxt.Position = UDim2.fromOffset(16, 0)
	armedTxt.Size = UDim2.new(1, -106, 1, 0)
	armedTxt.BackgroundTransparency = 1
	armedTxt.Font = Enum.Font.GothamBold
	armedTxt.TextSize = 13
	armedTxt.TextXAlignment = Enum.TextXAlignment.Left
	armedTxt.TextColor3 = Color3.new(1, 1, 1)
	armedTxt.ZIndex = 23
	armedTxt.Parent = armedPill
	self.armedTxt = armedTxt

	local cancelArmedBtn = UiWidgets.MakeButton(
		armedPill,
		"✕ Cancel",
		Theme.UI.AccentRed,
		UDim2.fromOffset(78, 28),
		UDim2.new(1, -86, 0.5, -14)
	)
	cancelArmedBtn.ZIndex = 23
	cancelArmedBtn.Activated:Connect(function()
		self:ClearArmedModes()
	end)
end

function HudUI:ClearArmedModes()
	self.canvas.armedBuildType = nil
	self.boatModeArmed = false
	self.canvas.selectedWarshipId = nil
	self.armedPill.Visible = false
end

function HudUI:ArmBuildUnit(unitType: string)
	self.boatModeArmed = false
	self.canvas.selectedWarshipId = nil
	self.canvas.armedBuildType = unitType
	self.armedTxt.Text = "🏗️ Click map to place/launch " .. unitType .. "  (Esc to cancel)"
	self.armedPill.Visible = true
end

function HudUI:ArmBoatMode()
	self.canvas.armedBuildType = nil
	self.canvas.selectedWarshipId = nil
	self.boatModeArmed = true
	self.armedTxt.Text = "⛴️ BOAT INVASION: Click target coast/island!"
	self.armedPill.Visible = true
end

function HudUI:_BuildControlPanel()
	local panel = Instance.new("Frame")
	panel.Name = "ControlPanel"
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.Position = UDim2.new(0, 14, 1, -14)
	panel.Size = UDim2.fromOffset(356, 168)
	panel.BackgroundColor3 = Theme.UI.BgPanel
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.ZIndex = 20
	UiWidgets.AddCorner(panel, 12)
	UiWidgets.AddStroke(panel, Theme.UI.Border, 1.5, 0.3)
	panel.Parent = self.root
	self.controlPanel = panel

	-- Row 1: Troops + Growth Rate
	local troopLbl = Instance.new("TextLabel")
	troopLbl.Position = UDim2.fromOffset(12, 8)
	troopLbl.Size = UDim2.fromOffset(226, 24)
	troopLbl.BackgroundTransparency = 1
	troopLbl.Font = Enum.Font.GothamBlack
	troopLbl.TextSize = 15
	troopLbl.TextTruncate = Enum.TextTruncate.AtEnd
	troopLbl.TextWrapped = false
	troopLbl.TextXAlignment = Enum.TextXAlignment.Left
	troopLbl.TextColor3 = Color3.new(1, 1, 1)
	troopLbl.Text = "🪖 25.0K / 100K"
	troopLbl.ZIndex = 21
	troopLbl.Parent = panel
	self.troopLbl = troopLbl

	local rateLbl = Instance.new("TextLabel")
	rateLbl.Position = UDim2.fromOffset(242, 8)
	rateLbl.Size = UDim2.fromOffset(102, 24)
	rateLbl.BackgroundTransparency = 1
	rateLbl.Font = Enum.Font.GothamBold
	rateLbl.TextSize = 13
	rateLbl.TextTruncate = Enum.TextTruncate.AtEnd
	rateLbl.TextWrapped = false
	rateLbl.TextXAlignment = Enum.TextXAlignment.Right
	rateLbl.TextColor3 = Color3.fromRGB(74, 222, 128)
	rateLbl.Text = "+420/s"
	rateLbl.ZIndex = 21
	rateLbl.Parent = panel
	self.rateLbl = rateLbl

	-- Row 2: Gold + Outgoing Attacks
	local goldLbl = Instance.new("TextLabel")
	goldLbl.Position = UDim2.fromOffset(12, 34)
	goldLbl.Size = UDim2.fromOffset(186, 22)
	goldLbl.BackgroundTransparency = 1
	goldLbl.Font = Enum.Font.GothamBlack
	goldLbl.TextSize = 15
	goldLbl.TextTruncate = Enum.TextTruncate.AtEnd
	goldLbl.TextWrapped = false
	goldLbl.TextXAlignment = Enum.TextXAlignment.Left
	goldLbl.TextColor3 = Color3.fromRGB(250, 204, 21)
	goldLbl.Text = "💰 0"
	goldLbl.ZIndex = 21
	goldLbl.Parent = panel
	self.goldLbl = goldLbl

	local atkStatusBtn = UiWidgets.MakeButton(
		panel,
		"⚔️ Idle",
		Color3.fromRGB(51, 65, 85),
		UDim2.fromOffset(142, 24),
		UDim2.fromOffset(202, 33)
	)
	atkStatusBtn.TextSize = 11
	atkStatusBtn.ZIndex = 21
	atkStatusBtn.Activated:Connect(function()
		SoundFX.Play("click")
		self.callbacks.onSendIntent("Retreat", {})
	end)
	self.atkStatusBtn = atkStatusBtn

	-- Row 3: Interactive Attack Ratio Slider
	local ratioTitle = Instance.new("TextLabel")
	ratioTitle.Position = UDim2.fromOffset(12, 64)
	ratioTitle.Size = UDim2.fromOffset(198, 18)
	ratioTitle.BackgroundTransparency = 1
	ratioTitle.Font = Enum.Font.GothamBold
	ratioTitle.TextSize = 12
	ratioTitle.TextTruncate = Enum.TextTruncate.AtEnd
	ratioTitle.TextWrapped = false
	ratioTitle.TextXAlignment = Enum.TextXAlignment.Left
	ratioTitle.TextColor3 = Theme.UI.TextMuted
	ratioTitle.Text = "Attack Ratio: 25%"
	ratioTitle.ZIndex = 21
	ratioTitle.Parent = panel
	self.ratioTitle = ratioTitle

	local minusBtn = UiWidgets.MakeButton(panel, "-10%", Theme.UI.BgCard, UDim2.fromOffset(58, 20), UDim2.fromOffset(220, 63))
	minusBtn.TextSize = 11
	minusBtn.ZIndex = 21
	local plusBtn = UiWidgets.MakeButton(panel, "+10%", Theme.UI.BgCard, UDim2.fromOffset(58, 20), UDim2.fromOffset(286, 63))
	plusBtn.TextSize = 11
	plusBtn.ZIndex = 21

	local sliderTrack = Instance.new("TextButton")
	sliderTrack.Position = UDim2.fromOffset(12, 88)
	sliderTrack.Size = UDim2.new(1, -24, 0, 16)
	sliderTrack.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
	sliderTrack.BorderSizePixel = 0
	sliderTrack.Text = ""
	sliderTrack.AutoButtonColor = false
	sliderTrack.ZIndex = 21
	UiWidgets.AddCorner(sliderTrack, 99)
	sliderTrack.Parent = panel

	local sliderFill = Instance.new("Frame")
	sliderFill.Size = UDim2.fromScale(0.25, 1)
	sliderFill.BackgroundColor3 = Theme.UI.AccentRed
	sliderFill.BorderSizePixel = 0
	sliderFill.ZIndex = 22
	UiWidgets.AddCorner(sliderFill, 99)
	sliderFill.Parent = sliderTrack
	self.sliderFill = sliderFill

	sliderTrack.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			local rel = (inp.Position.X - sliderTrack.AbsolutePosition.X) / math.max(1, sliderTrack.AbsoluteSize.X)
			self:SetAttackRatio(rel)
		end
	end)
	minusBtn.Activated:Connect(function()
		self:SetAttackRatio(self.attackRatio - 0.10)
	end)
	plusBtn.Activated:Connect(function()
		self:SetAttackRatio(self.attackRatio + 0.10)
	end)

	-- Row 4: Quick Hotbar Buttons
	local hotbar = Instance.new("Frame")
	hotbar.Position = UDim2.fromOffset(12, 114)
	hotbar.Size = UDim2.new(1, -24, 0, 42)
	hotbar.BackgroundTransparency = 1
	hotbar.ZIndex = 21
	hotbar.Parent = panel

	local hbLayout = Instance.new("UIGridLayout")
	hbLayout.CellSize = UDim2.fromOffset(51, 40)
	hbLayout.CellPadding = UDim2.fromOffset(5, 0)
	hbLayout.Parent = hotbar

	local actions = {
		{ txt = "🏗️\nBuild", col = Color3.fromRGB(180, 120, 20), fn = function()
			self:ToggleBuildMenu(nil, nil)
		end },
		{ txt = "⛴️\nBoat", col = Color3.fromRGB(30, 105, 175), fn = function()
			self:ArmBoatMode()
		end },
		{ txt = "🏳️\nRetreat", col = Color3.fromRGB(153, 27, 27), fn = function()
			self.callbacks.onSendIntent("Retreat", {})
			self.callbacks.onSendIntent("RetreatBoats", {})
		end },
		{ txt = "😊\nEmoji", col = Color3.fromRGB(51, 65, 85), fn = function()
			self.emojiPopup.Visible = not self.emojiPopup.Visible
			self.chatPopup.Visible = false
		end },
		{ txt = "💬\nChat", col = Color3.fromRGB(51, 65, 85), fn = function()
			self.chatPopup.Visible = not self.chatPopup.Visible
			self.emojiPopup.Visible = false
		end },
		{ txt = "👁️\nAlt", col = Color3.fromRGB(51, 65, 85), fn = function()
			self.canvas.altView = not self.canvas.altView
			self.canvas:MarkAllDirty()
		end },
	}
	for _, act in ipairs(actions) do
		local b = UiWidgets.MakeButton(hotbar, act.txt, act.col, UDim2.fromOffset(47, 40), nil)
		b.TextSize = 10
		b.ZIndex = 22
		b.Activated:Connect(function()
			SoundFX.Play("click")
			act.fn()
		end)
	end
end

function HudUI:SetAttackRatio(val: number)
	self.attackRatio = math.clamp(math.floor(val * 100 + 0.5) / 100, 0.01, 1.0)
	self.ratioTitle.Text = string.format("Attack Ratio: %d%%", math.floor(self.attackRatio * 100 + 0.5))
	self.sliderFill.Size = UDim2.fromScale(self.attackRatio, 1)
end

function HudUI:_BuildLeaderboard()
	local box = Instance.new("Frame")
	box.Name = "LeaderboardPanel"
	box.AnchorPoint = Vector2.new(1, 0)
	box.Position = UDim2.new(1, -14, 0, 14)
	box.Size = UDim2.fromOffset(296, 254)
	box.BackgroundColor3 = Theme.UI.BgPanel
	box.BackgroundTransparency = 0.10
	box.BorderSizePixel = 0
	box.ZIndex = 20
	UiWidgets.AddCorner(box, 10)
	UiWidgets.AddStroke(box, Theme.UI.Border, 1, 0.35)
	box.Parent = self.root
	self.lbBox = box

	local headerBtn = Instance.new("TextButton")
	headerBtn.Position = UDim2.fromOffset(10, 6)
	headerBtn.Size = UDim2.fromOffset(200, 26)
	headerBtn.BackgroundTransparency = 1
	headerBtn.Font = Enum.Font.GothamBlack
	headerBtn.TextSize = 12
	headerBtn.TextXAlignment = Enum.TextXAlignment.Left
	headerBtn.TextColor3 = Color3.new(1, 1, 1)
	headerBtn.Text = "⏱️ 00:00  •  Win: 80% ▾"
	headerBtn.ZIndex = 21
	headerBtn.Parent = box
	self.lbHeaderBtn = headerBtn

	local menuBtn = UiWidgets.MakeButton(
		box,
		"Menu",
		Color3.fromRGB(71, 85, 105),
		UDim2.fromOffset(66, 24),
		UDim2.new(1, -76, 0, 7)
	)
	menuBtn.TextSize = 11
	menuBtn.ZIndex = 21
	menuBtn.Activated:Connect(function()
		SoundFX.Play("click")
		self.callbacks.onExitToMenu()
	end)

	local rowsContainer = Instance.new("Frame")
	rowsContainer.Position = UDim2.fromOffset(8, 36)
	rowsContainer.Size = UDim2.new(1, -16, 1, -44)
	rowsContainer.BackgroundTransparency = 1
	rowsContainer.ZIndex = 21
	rowsContainer.Parent = box
	self.lbRowsContainer = rowsContainer

	local rLayout = Instance.new("UIListLayout")
	rLayout.Padding = UDim.new(0, 3)
	rLayout.Parent = rowsContainer

	self.lbRowPool = {} :: { any }
	for i = 1, 9 do
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, 21)
		row.BackgroundColor3 = Theme.UI.BgCard
		row.BackgroundTransparency = 0.25
		row.BorderSizePixel = 0
		row.Text = ""
		row.Visible = false
		row.ZIndex = 22
		UiWidgets.AddCorner(row, 5)
		row.Parent = rowsContainer

		local swatch = Instance.new("Frame")
		swatch.Position = UDim2.fromOffset(5, 4)
		swatch.Size = UDim2.fromOffset(8, 13)
		swatch.BorderSizePixel = 0
		swatch.ZIndex = 23
		UiWidgets.AddCorner(swatch, 2)
		swatch.Parent = row

		local txt = Instance.new("TextLabel")
		txt.Position = UDim2.fromOffset(18, 0)
		txt.Size = UDim2.new(1, -124, 1, 0)
		txt.BackgroundTransparency = 1
		txt.Font = Enum.Font.GothamBold
		txt.TextSize = 11
		txt.TextTruncate = Enum.TextTruncate.AtEnd
		txt.TextXAlignment = Enum.TextXAlignment.Left
		txt.TextColor3 = Color3.new(1, 1, 1)
		txt.ZIndex = 23
		txt.Parent = row

		local stats = Instance.new("TextLabel")
		stats.AnchorPoint = Vector2.new(1, 0)
		stats.Position = UDim2.new(1, -5, 0, 0)
		stats.Size = UDim2.fromOffset(104, 21)
		stats.BackgroundTransparency = 1
		stats.Font = Enum.Font.GothamMedium
		stats.TextSize = 10
		stats.TextXAlignment = Enum.TextXAlignment.Right
		stats.TextColor3 = Color3.fromRGB(203, 213, 225)
		stats.ZIndex = 23
		stats.Parent = row

		local boundSmallId = 0
		row.Activated:Connect(function()
			if boundSmallId &gt; 0 then
				SoundFX.Play("click")
				self:OpenPlayerInspector(boundSmallId)
			end
		end)

		self.lbRowPool[i] = {
			row = row,
			swatch = swatch,
			txt = txt,
			stats = stats,
			setTarget = function(sid: number)
				boundSmallId = sid
			end,
		}
	end

	headerBtn.Activated:Connect(function()
		self.leaderboardOpen = not self.leaderboardOpen
		rowsContainer.Visible = self.leaderboardOpen
		box.Size = if self.leaderboardOpen then UDim2.fromOffset(296, 254) else UDim2.fromOffset(296, 38)
	end)
end

function HudUI:_BuildMinimapAndFeed()
	-- Bottom-Right Interactive Minimap
	local miniCard = Instance.new("Frame")
	miniCard.Name = "MinimapCard"
	miniCard.AnchorPoint = Vector2.new(1, 1)
	miniCard.Position = UDim2.new(1, -14, 1, -14)
	miniCard.Size = UDim2.fromOffset(210, 124)
	miniCard.BackgroundColor3 = Theme.UI.BgPanel
	miniCard.BorderSizePixel = 0
	miniCard.ZIndex = 20
	UiWidgets.AddCorner(miniCard, 9)
	UiWidgets.AddStroke(miniCard, Theme.UI.Border, 1.5, 0.25)
	miniCard.Parent = self.root
	self.miniCard = miniCard

	local miniMapPreview = Instance.new("Frame")
	miniMapPreview.Position = UDim2.fromOffset(5, 5)
	miniMapPreview.Size = UDim2.new(1, -10, 1, -10)
	miniMapPreview.ZIndex = 21
	miniMapPreview.Parent = miniCard
	self.miniMapPreview = miniMapPreview
	self.lastMiniMapId = ""

	local miniLiveImg = Instance.new("ImageLabel")
	miniLiveImg.Name = "MinimapLiveTexture"
	miniLiveImg.Position = UDim2.fromOffset(5, 5)
	miniLiveImg.Size = UDim2.new(1, -10, 1, -10)
	miniLiveImg.BackgroundTransparency = 1
	miniLiveImg.BorderSizePixel = 0
	miniLiveImg.ResampleMode = Enum.ResamplerMode.Pixelated
	miniLiveImg.Visible = false
	miniLiveImg.ZIndex = 21
	UiWidgets.AddCorner(miniLiveImg, 6)
	miniLiveImg.Parent = miniCard
	self.miniLiveImg = miniLiveImg
	self.boundMiniObj = nil :: any

	-- Compact Mobile-First Quick Gear/Speed Strip (Top-Left beside Alerts, never collides with Leaderboard!)
	local quickStrip = Instance.new("Frame")
	quickStrip.Name = "QuickControlStrip"
	quickStrip.Position = UDim2.fromOffset(14, 14)
	quickStrip.Size = UDim2.fromOffset(224, 30)
	quickStrip.BackgroundColor3 = Theme.UI.BgPanel
	quickStrip.BackgroundTransparency = 0.12
	quickStrip.BorderSizePixel = 0
	quickStrip.ZIndex = 24
	UiWidgets.AddCorner(quickStrip, 7)
	UiWidgets.AddStroke(quickStrip, Theme.UI.Border, 1, 0.35)
	quickStrip.Parent = self.root
	self.quickStrip = quickStrip

	local qsLayout = Instance.new("UIListLayout")
	qsLayout.FillDirection = Enum.FillDirection.Horizontal
	qsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	qsLayout.Padding = UDim.new(0, 4)
	qsLayout.Parent = quickStrip
	local qsPad = Instance.new("UIPadding")
	qsPad.PaddingLeft = UDim.new(0, 5)
	qsPad.PaddingRight = UDim.new(0, 5)
	qsPad.Parent = quickStrip

	local gearBtn = UiWidgets.MakeButton(quickStrip, "⚙️", Theme.UI.BgCard, UDim2.fromOffset(32, 22), nil)
	gearBtn.TextSize = 11
	gearBtn.ZIndex = 25
	gearBtn.Activated:Connect(function()
		SoundFX.Play("click")
		self.canvas.altView = not self.canvas.altView
		self.canvas:MarkAllDirty()
	end)

	for _, spSpec in ipairs({
		{ label = "⏸", speed = 0 },
		{ label = "1×", speed = 1 },
		{ label = "2×", speed = 2 },
		{ label = "4×", speed = 4 },
	}) do
		local sb = UiWidgets.MakeButton(quickStrip, spSpec.label, Theme.UI.BgCard, UDim2.fromOffset(38, 22), nil)
		sb.TextSize = 11
		sb.ZIndex = 25
		local targetSpd = spSpec.speed
		sb.Activated:Connect(function()
			SoundFX.Play("click")
			if targetSpd == 0 then
				self.callbacks.onSendIntent("SimControl", { paused = true })
			else
				self.callbacks.onSendIntent("SimControl", { paused = false, speed = targetSpd })
			end
		end)
	end

	local miniDotsLayer = Instance.new("Frame")
	miniDotsLayer.Position = UDim2.fromOffset(5, 5)
	miniDotsLayer.Size = UDim2.new(1, -10, 1, -10)
	miniDotsLayer.BackgroundTransparency = 1
	miniDotsLayer.ClipsDescendants = true
	miniDotsLayer.ZIndex = 22
	miniDotsLayer.Parent = miniCard
	self.miniDotsLayer = miniDotsLayer
	self.miniDots = {} :: { [number]: Frame }

	local camRect = Instance.new("Frame")
	camRect.BackgroundTransparency = 1
	camRect.BorderSizePixel = 0
	camRect.ZIndex = 23
	UiWidgets.AddStroke(camRect, Color3.new(1, 1, 1), 1.5, 0.05)
	camRect.Parent = miniDotsLayer
	self.miniCamRect = camRect

	local miniHitbox = Instance.new("TextButton")
	miniHitbox.Size = UDim2.fromScale(1, 1)
	miniHitbox.BackgroundTransparency = 1
	miniHitbox.Text = ""
	miniHitbox.ZIndex = 24
	miniHitbox.Parent = miniDotsLayer

	local function jumpFromMiniInput(pos: Vector3)
		if self.canvas.map == nil then
			return
		end
		local rx = math.clamp((pos.X - miniDotsLayer.AbsolutePosition.X) / math.max(1, miniDotsLayer.AbsoluteSize.X), 0, 1)
		local ry = math.clamp((pos.Y - miniDotsLayer.AbsolutePosition.Y) / math.max(1, miniDotsLayer.AbsoluteSize.Y), 0, 1)
		self.camera:FocusOn(rx * self.canvas.map.width, ry * self.canvas.map.height, nil)
	end

	local draggingMini = false
	miniHitbox.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			draggingMini = true
			jumpFromMiniInput(inp.Position)
		end
	end)
	miniHitbox.InputChanged:Connect(function(inp)
		if draggingMini and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			jumpFromMiniInput(inp.Position)
		end
	end)
	miniHitbox.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			draggingMini = false
		end
	end)

	-- Event Feed right above Minimap
	local feedBox = Instance.new("Frame")
	feedBox.AnchorPoint = Vector2.new(1, 1)
	feedBox.Position = UDim2.new(1, -14, 1, -146)
	feedBox.Size = UDim2.fromOffset(296, 128)
	feedBox.BackgroundTransparency = 1
	feedBox.ZIndex = 20
	feedBox.Parent = self.root

	local fLayout = Instance.new("UIListLayout")
	fLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	fLayout.Padding = UDim.new(0, 4)
	fLayout.Parent = feedBox

	self.feedItems = {} :: { TextButton }
	self.feedCoords = {} :: { { x: number?, y: number? } }
	for i = 1, 5 do
		local fb = Instance.new("TextButton")
		fb.Size = UDim2.new(1, 0, 0, 22)
		fb.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
		fb.BackgroundTransparency = 0.22
		fb.BorderSizePixel = 0
		fb.Font = Enum.Font.GothamBold
		fb.TextSize = 11
		fb.TextTruncate = Enum.TextTruncate.AtEnd
		fb.TextXAlignment = Enum.TextXAlignment.Left
		fb.TextColor3 = Color3.new(1, 1, 1)
		fb.Visible = false
		fb.ZIndex = 21
		UiWidgets.AddCorner(fb, 5)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 8)
		p.PaddingRight = UDim.new(0, 8)
		p.Parent = fb
		fb.Parent = feedBox
		self.feedCoords[i] = { x = nil, y = nil }
		fb.Activated:Connect(function()
			local c = self.feedCoords[i]
			if c.x ~= nil and c.y ~= nil then
				self.camera:FocusOn(c.x, c.y, math.max(self.camera.scale, 6))
			end
		end)
		self.feedItems[i] = fb
	end

	-- Actionable Alerts Stack (Top-Left below QuickControlStrip — ZERO overlap!)
	local alertsBox = Instance.new("Frame")
	alertsBox.Position = UDim2.fromOffset(14, 52)
	alertsBox.Size = UDim2.fromOffset(310, 210)
	alertsBox.BackgroundTransparency = 1
	alertsBox.ZIndex = 22
	alertsBox.Parent = self.root
	self.alertsBox = alertsBox

	local aLayout = Instance.new("UIListLayout")
	aLayout.Padding = UDim.new(0, 6)
	aLayout.Parent = alertsBox
end

function HudUI:_BuildRadialMenu()
	local ring = Instance.new("Frame")
	ring.Name = "RadialMenu"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Size = UDim2.fromOffset(196, 196)
	ring.BackgroundTransparency = 1
	ring.Visible = false
	ring.ZIndex = 32
	ring.Parent = self.root
	self.radialRoot = ring

	local centerBtn = UiWidgets.MakeButton(
		ring,
		"✕",
		Color3.fromRGB(30, 41, 59),
		UDim2.fromOffset(48, 48),
		UDim2.fromScale(0.5, 0.5)
	)
	centerBtn.AnchorPoint = Vector2.new(0.5, 0.5)
	centerBtn.ZIndex = 34
	UiWidgets.AddCorner(centerBtn, 99)
	centerBtn.Activated:Connect(function()
		ring.Visible = false
	end)

	self.radialSpokes = {} :: { TextButton }
	for i = 1, 6 do
		local b = UiWidgets.MakeButton(ring, "", Theme.UI.BgCard, UDim2.fromOffset(58, 58), UDim2.fromScale(0.5, 0.5))
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.TextSize = 11
		b.ZIndex = 33
		UiWidgets.AddCorner(b, 99)
		self.radialSpokes[i] = b
	end
	self.radialCallbacks = {} :: { [number]: () -&gt; () }
	for i = 1, 6 do
		self.radialSpokes[i].Activated:Connect(function()
			local fn = self.radialCallbacks[i]
			ring.Visible = false
			if fn ~= nil then
				SoundFX.Play("click")
				fn()
			end
		end)
	end
end

-- Open Circular OpenFront Radial Menu right at (screenX, screenY) for tile (tileX, tileY)!
function HudUI:OpenRadialMenu(screenX: number, screenY: number, tileX: number, tileY: number)
	local st = self.latestState
	if st == nil or st.inSpawnPhase or self.canvas.map == nil then
		return
	end
	local map = self.canvas.map
	local ref = tileY * map.width + tileX
	local targetOwnerId = MapCodec_GetOwnerSafe(map, ref)
	local targetPlayer = self.canvas.playersById[targetOwnerId]
	local me = self.canvas.playersById[self.mySmallId]

	-- Check if user right-clicked one of their own structures!
	local myStruct: any = nil
	for _, u in ipairs(st.units or {}) do
		if u.ownerSmallId == self.mySmallId and math.abs(u.x - tileX) &lt;= 4 and math.abs(u.y - tileY) &lt;= 4 then
			myStruct = u
			break
		end
	end

	local items: { { label: string, color: Color3, fn: () -&gt; () } } = {}

	if targetOwnerId ~= self.mySmallId and MapCodec_IsLandSafe(map, ref) then
		table.insert(items, {
			label = "⚔️\nAttack",
			color = Color3.fromRGB(220, 38, 38),
			fn = function()
				SoundFX.Play("attack")
				self.callbacks.onSendIntent("AttackLand", { targetSmallId = targetOwnerId, ratio = self.attackRatio })
			end,
		})
	end

	table.insert(items, {
		label = "⛴️\nBoat",
		color = Color3.fromRGB(37, 99, 235),
		fn = function()
			SoundFX.Play("boat")
			self.callbacks.onSendIntent("BoatAttack", { x = tileX, y = tileY, ratio = self.attackRatio })
		end,
	})

	table.insert(items, {
		label = "🏗️\nBuild",
		color = Color3.fromRGB(202, 138, 4),
		fn = function()
			self:ToggleBuildMenu(tileX, tileY)
		end,
	})

	if targetPlayer ~= nil and targetOwnerId ~= self.mySmallId then
		local isAlly = self.canvas.friendlySet[targetOwnerId] == true
		table.insert(items, {
			label = if isAlly then "💀\nBetray" else "🤝\nAlly",
			color = if isAlly then Color3.fromRGB(185, 28, 28) else Color3.fromRGB(22, 163, 74),
			fn = function()
				if isAlly then
					self.callbacks.onSendIntent("BreakAlliance", { targetSmallId = targetOwnerId })
				else
					SoundFX.Play("alliance")
					self.callbacks.onSendIntent("AllianceRequest", { targetSmallId = targetOwnerId })
				end
			end,
		})
		table.insert(items, {
			label = "🔍\nInfo",
			color = Color3.fromRGB(71, 85, 105),
			fn = function()
				self:OpenPlayerInspector(targetOwnerId)
			end,
		})
	elseif myStruct ~= nil then
		table.insert(items, {
			label = "⬆️\nUpgrade",
			color = Color3.fromRGB(22, 163, 74),
			fn = function()
				self.callbacks.onSendIntent("UpgradeStructure", { unitId = myStruct.id })
			end,
		})
		table.insert(items, {
			label = "🗑️\nDelete",
			color = Color3.fromRGB(185, 28, 28),
			fn = function()
				self.callbacks.onSendIntent("DeleteStructure", { unitId = myStruct.id })
			end,
		})
	else
		table.insert(items, {
			label = "😊\nEmoji",
			color = Color3.fromRGB(124, 58, 237),
			fn = function()
				self.emojiPopup.Visible = true
			end,
		})
	end

	local count = #items
	local radius = 68
	for i = 1, 6 do
		local spoke = self.radialSpokes[i]
		if i &lt;= count then
			local angle = -math.pi * 0.5 + ((i - 1) / count) * math.pi * 2
			spoke.Position = UDim2.new(0.5, math.cos(angle) * radius, 0.5, math.sin(angle) * radius)
			spoke.Text = items[i].label
			spoke.BackgroundColor3 = items[i].color
			spoke.Visible = true
			self.radialCallbacks[i] = items[i].fn
		else
			spoke.Visible = false
			self.radialCallbacks[i] = nil
		end
	end

	local cx = math.clamp(screenX, 105, self.camera.viewW - 105)
	local cy = math.clamp(screenY, 105, self.camera.viewH - 105)
	self.radialRoot.Position = UDim2.fromOffset(cx, cy)
	self.radialRoot.Visible = true
	local _ = me
end

function MapCodec_GetOwnerSafe(map: any, ref: number): number
	if ref &lt; 0 or ref &gt;= map.size then
		return 0
	end
	return buffer.readu16(map.owner, ref * 2)
end

function MapCodec_IsLandSafe(map: any, ref: number): boolean
	if ref &lt; 0 or ref &gt;= map.size then
		return false
	end
	return bit32.band(buffer.readu8(map.terrain, ref), 0x80) ~= 0
end

function HudUI:_BuildMenuPopup()
	local popup = Instance.new("Frame")
	popup.Name = "BuildMenuModal"
	popup.AnchorPoint = Vector2.new(0.5, 0.5)
	popup.Position = UDim2.fromScale(0.5, 0.5)
	popup.Size = UDim2.fromOffset(556, 286)
	popup.BackgroundColor3 = Color3.fromRGB(20, 26, 38)
	popup.BackgroundTransparency = 0.04
	popup.BorderSizePixel = 0
	popup.Visible = false
	popup.ZIndex = 34
	UiWidgets.AddCorner(popup, 12)
	UiWidgets.AddStroke(popup, Color3.fromRGB(234, 179, 8), 2, 0.25)
	popup.Parent = self.root
	self.buildPopup = popup
	self.buildTargetTileX = nil :: number?
	self.buildTargetTileY = nil :: number?

	local hdr = Instance.new("TextLabel")
	hdr.Position = UDim2.fromOffset(16, 10)
	hdr.Size = UDim2.fromOffset(420, 26)
	hdr.BackgroundTransparency = 1
	hdr.Font = Enum.Font.GothamBlack
	hdr.TextSize = 16
	hdr.TextXAlignment = Enum.TextXAlignment.Left
	hdr.TextColor3 = Color3.new(1, 1, 1)
	hdr.Text = "🏗️ BUILD STRUCTURES, SHIPS &amp; NUCLEAR ARSENAL"
	hdr.ZIndex = 35
	hdr.Parent = popup

	local closeBtn = UiWidgets.MakeButton(
		popup,
		"✕",
		Theme.UI.AccentRed,
		UDim2.fromOffset(34, 28),
		UDim2.new(1, -46, 0, 10)
	)
	closeBtn.ZIndex = 35
	closeBtn.Activated:Connect(function()
		popup.Visible = false
		self.modalScrim.Visible = self.resultModal.Visible
	end)

	local gridHolder = Instance.new("Frame")
	gridHolder.Position = UDim2.fromOffset(14, 46)
	gridHolder.Size = UDim2.new(1, -28, 1, -58)
	gridHolder.BackgroundTransparency = 1
	gridHolder.ZIndex = 35
	gridHolder.Parent = popup

	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(100, 108)
	gl.CellPadding = UDim2.fromOffset(7, 8)
	gl.Parent = gridHolder

	self.buildCards = {} :: { any }
	for idx, info in ipairs(BUILD_ITEMS) do
		local card = Instance.new("TextButton")
		card.BackgroundColor3 = Theme.UI.BgCard
		card.BorderSizePixel = 0
		card.Text = ""
		card.ZIndex = 36
		UiWidgets.AddCorner(card, 9)
		local stroke = UiWidgets.AddStroke(card, Theme.UI.Border, 1.5, 0.25)
		card.Parent = gridHolder

		local icon = Instance.new("TextLabel")
		icon.Position = UDim2.fromOffset(0, 6)
		icon.Size = UDim2.new(1, 0, 0, 28)
		icon.BackgroundTransparency = 1
		icon.TextScaled = true
		icon.Text = info.icon
		icon.ZIndex = 37
		icon.Parent = card

		local nm = Instance.new("TextLabel")
		nm.Position = UDim2.fromOffset(4, 36)
		nm.Size = UDim2.new(1, -8, 0, 28)
		nm.BackgroundTransparency = 1
		nm.Font = Enum.Font.GothamBold
		nm.TextSize = 11
		nm.TextWrapped = true
		nm.TextColor3 = Color3.new(1, 1, 1)
		nm.Text = info.label
		nm.ZIndex = 37
		nm.Parent = card

		local costLbl = Instance.new("TextLabel")
		costLbl.Position = UDim2.fromOffset(4, 68)
		costLbl.Size = UDim2.new(1, -8, 0, 18)
		costLbl.BackgroundTransparency = 1
		costLbl.Font = Enum.Font.GothamBlack
		costLbl.TextSize = 11
		costLbl.TextColor3 = Theme.UI.AccentGold
		costLbl.Text = "💰 125K"
		costLbl.ZIndex = 37
		costLbl.Parent = card

		local cntLbl = Instance.new("TextLabel")
		cntLbl.Position = UDim2.fromOffset(4, 86)
		cntLbl.Size = UDim2.new(1, -8, 0, 16)
		cntLbl.BackgroundTransparency = 1
		cntLbl.Font = Enum.Font.Gotham
		cntLbl.TextSize = 10
		cntLbl.TextColor3 = Theme.UI.TextMuted
		cntLbl.Text = ""
		cntLbl.ZIndex = 37
		cntLbl.Parent = card

		card.Activated:Connect(function()
			popup.Visible = false
			if self.buildTargetTileX ~= nil and self.buildTargetTileY ~= nil then
				if info.unitType == "AtomBomb" or info.unitType == "HydrogenBomb" or info.unitType == "MIRV" then
					SoundFX.Play("launch")
				else
					SoundFX.Play("build")
				end
				self.callbacks.onSendIntent("BuildUnit", {
					unitType = info.unitType,
					x = self.buildTargetTileX,
					y = self.buildTargetTileY,
				})
			else
				SoundFX.Play("click")
				self:ArmBuildUnit(info.unitType)
			end
		end)

		self.buildCards[idx] = { info = info, card = card, stroke = stroke, costLbl = costLbl, cntLbl = cntLbl }
	end
end

function HudUI:ToggleBuildMenu(tileX: number?, tileY: number?)
	self.radialRoot.Visible = false
	self.inspectorModal.Visible = false
	self.emojiPopup.Visible = false
	self.chatPopup.Visible = false
	if self.buildPopup.Visible and tileX == nil then
		self.buildPopup.Visible = false
		self.modalScrim.Visible = self.resultModal.Visible
		return
	end
	self.buildTargetTileX = tileX
	self.buildTargetTileY = tileY
	self:_RefreshBuildCosts()
	self.buildPopup.Visible = true
	self.modalScrim.Visible = true
end

function HudUI:_RefreshBuildCosts()
	local st = self.latestState
	if st == nil then
		return
	end
	local me = self.canvas.playersById[self.mySmallId]
	local counts = if me ~= nil then (me.unitCounts or {}) else {}
	local myGold = if me ~= nil then (me.gold or 0) else 0
	local cfg = st.config or Config.DefaultGameConfig(true)

	for _, bc in ipairs(self.buildCards) do
		local c = Config.UnitCost(bc.info.unitType :: any, counts, st.mirvsLaunched or 0, cfg.infiniteGold == true, true)
		local canAfford = myGold &gt;= c
		bc.costLbl.Text = "💰 " .. Format.Gold(c)
		bc.costLbl.TextColor3 = if canAfford then Theme.UI.AccentGold else Color3.fromRGB(248, 113, 113)
		bc.stroke.Color = if canAfford then Theme.UI.AccentGold else Theme.UI.Border
		bc.cntLbl.Text = if bc.info.countable
			then ("Owned: " .. tostring(counts[bc.info.unitType] or 0))
			else bc.info.desc
	end
end

function HudUI:_BuildPlayerInspectorModal()
	local modal = Instance.new("Frame")
	modal.AnchorPoint = Vector2.new(0.5, 0.5)
	modal.Position = UDim2.fromScale(0.5, 0.5)
	modal.Size = UDim2.fromOffset(390, 310)
	modal.BackgroundColor3 = Theme.UI.BgDark
	modal.BorderSizePixel = 0
	modal.Visible = false
	modal.ZIndex = 36
	UiWidgets.AddCorner(modal, 12)
	UiWidgets.AddStroke(modal, Theme.UI.AccentBlue, 2, 0.25)
	modal.Parent = self.root
	self.inspectorModal = modal

	local title = Instance.new("TextLabel")
	title.Position = UDim2.fromOffset(16, 12)
	title.Size = UDim2.fromOffset(310, 26)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 17
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.new(1, 1, 1)
	title.ZIndex = 37
	title.Parent = modal
	self.inspTitle = title

	local closeBtn = UiWidgets.MakeButton(
		modal,
		"✕",
		Theme.UI.AccentRed,
		UDim2.fromOffset(32, 26),
		UDim2.new(1, -44, 0, 12)
	)
	closeBtn.ZIndex = 37
	closeBtn.Activated:Connect(function()
		modal.Visible = false
		self.modalScrim.Visible = self.resultModal.Visible
	end)

	local info = Instance.new("TextLabel")
	info.Position = UDim2.fromOffset(16, 44)
	info.Size = UDim2.new(1, -32, 0, 44)
	info.BackgroundTransparency = 1
	info.Font = Enum.Font.GothamMedium
	info.TextSize = 13
	info.TextWrapped = true
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextColor3 = Color3.fromRGB(203, 213, 225)
	info.ZIndex = 37
	info.Parent = modal
	self.inspInfo = info

	local actionsGrid = Instance.new("Frame")
	actionsGrid.Position = UDim2.fromOffset(16, 96)
	actionsGrid.Size = UDim2.new(1, -32, 0, 196)
	actionsGrid.BackgroundTransparency = 1
	actionsGrid.ZIndex = 37
	actionsGrid.Parent = modal

	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(172, 38)
	gl.CellPadding = UDim2.fromOffset(10, 8)
	gl.Parent = actionsGrid

	local function addAct(txt: string, col: Color3, fn: (target: any, me: any) -&gt; ())
		local b = UiWidgets.MakeButton(actionsGrid, txt, col, UDim2.fromOffset(172, 38), nil)
		b.TextSize = 12
		b.ZIndex = 38
		b.Activated:Connect(function()
			local target = if self.inspectedSmallId then self.canvas.playersById[self.inspectedSmallId] else nil
			local me = self.canvas.playersById[self.mySmallId]
			if target ~= nil then
				SoundFX.Play("click")
				fn(target, me)
				modal.Visible = false
				self.modalScrim.Visible = self.resultModal.Visible
			end
		end)
		return b
	end

	addAct("🎯 Focus Camera", Theme.UI.BgCard, function(target)
		self.camera:FocusOn(target.labelX, target.labelY, math.max(self.camera.scale, 5.5))
	end)
	self.inspAllyBtn = addAct("🤝 Send Alliance", Theme.UI.AccentGreen, function(target)
		if self.canvas.friendlySet[target.smallId] then
			self.callbacks.onSendIntent("BreakAlliance", { targetSmallId = target.smallId })
		else
			self.callbacks.onSendIntent("AllianceRequest", { targetSmallId = target.smallId })
		end
	end)
	addAct("💰 Donate 25% Gold", Color3.fromRGB(180, 120, 20), function(target, me)
		if me ~= nil then
			self.callbacks.onSendIntent("Donate", { targetSmallId = target.smallId, kind = "gold", amount = math.floor(me.gold * 0.25) })
		end
	end)
	addAct("🪖 Donate 25% Troops", Theme.UI.AccentBlue, function(target, me)
		if me ~= nil then
			self.callbacks.onSendIntent("Donate", { targetSmallId = target.smallId, kind = "troops", amount = math.floor(me.troops * 0.25) })
		end
	end)
	addAct("🚫 Toggle Embargo", Theme.UI.AccentPurple, function(target)
		self.callbacks.onSendIntent("ToggleEmbargo", { targetSmallId = target.smallId })
	end)
	addAct("📍 Ping Target", Theme.UI.AccentRed, function(target)
		self.callbacks.onSendIntent("TargetPlayer", { targetSmallId = target.smallId })
	end)
	addAct("⚔️ Land Attack", Theme.UI.AccentRed, function(target)
		self.callbacks.onSendIntent("AttackLand", { targetSmallId = target.smallId, ratio = self.attackRatio })
	end)
	addAct("⛴️ Boat Invasion", Color3.fromRGB(30, 105, 175), function(target)
		self.callbacks.onSendIntent("BoatAttack", { x = target.labelX, y = target.labelY, ratio = self.attackRatio })
	end)
end

function HudUI:OpenPlayerInspector(smallId: number)
	local p = self.canvas.playersById[smallId]
	if p == nil then
		return
	end
	self.inspectedSmallId = smallId
	self.inspTitle.Text = p.name .. (if p.isTraitor then " 💀 [TRAITOR]" else "")
	local landPct = 0
	if self.canvas.map ~= nil then
		landPct = (p.tilesOwned / math.max(1, self.canvas.map.numLandTiles)) * 100
	end
	self.inspInfo.Text = string.format(
		"Type: %s  •  Land: %.1f%% (%d tiles)\nTroops: %s  •  Gold: %s",
		p.playerType,
		landPct,
		p.tilesOwned,
		Format.Troops(p.troops),
		Format.Gold(p.gold)
	)
	local isAlly = self.canvas.friendlySet[smallId] == true
	self.inspAllyBtn.Text = if isAlly then "💀 Break Alliance" else "🤝 Send Alliance"
	self.inspAllyBtn.BackgroundColor3 = if isAlly then Theme.UI.AccentRed else Theme.UI.AccentGreen
	self.radialRoot.Visible = false
	self.buildPopup.Visible = false
	self.emojiPopup.Visible = false
	self.chatPopup.Visible = false
	self.inspectorModal.Visible = true
	self.modalScrim.Visible = true
end

