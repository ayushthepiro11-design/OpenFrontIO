function HudUI:ShowMatchResult(res: any)
	self.radialRoot.Visible = false
	self.buildPopup.Visible = false
	self.inspectorModal.Visible = false
	self.emojiPopup.Visible = false
	self.chatPopup.Visible = false
	if res.kind == "Victory" then
		SoundFX.Play("victory")
		self.resTitle.Text = "🏆 WORLD CONQUERED!"
		self.resTitle.TextColor3 = Theme.UI.AccentGold
		self.resStroke.Color = Theme.UI.AccentGold
	elseif res.kind == "Eliminated" then
		SoundFX.Play("alert")
		self.resTitle.Text = "💀 TERRITORY CONQUERED"
		self.resTitle.TextColor3 = Theme.UI.AccentRed
		self.resStroke.Color = Theme.UI.AccentRed
	else
		self.resTitle.Text = "🏁 MATCH FINISHED — " .. tostring(res.winnerName or "Winner")
		self.resTitle.TextColor3 = Color3.new(1, 1, 1)
		self.resStroke.Color = Theme.UI.AccentBlue
	end

	local rw = res.reward or { xpGained = 150, prevLevel = 1, newLevel = 1 }
	local lvlNote = if rw.newLevel ~= rw.prevLevel
		then string.format("\n🎉 LEVEL UP! Lv. %d → Lv. %d!", rw.prevLevel, rw.newLevel)
		else ""
	self.resBody.Text = string.format(
		"Peak Empire: %.1f%% (%d tiles)  •  Nukes Sent: %d\n+%d XP Earned!%s",
		res.landPctPeak or 0,
		res.tilesPeak or 0,
		res.nukesSent or 0,
		rw.xpGained or 0,
		lvlNote
	)
	self.resultModal.Visible = true
	self.modalScrim.Visible = true
end

function HudUI:UpdateFromState(state: any, mySmallId: number)
	self.latestState = state
	self.mySmallId = mySmallId

	-- 1. Spawn Phase Banner
	if state.inSpawnPhase then
		self.spawnBanner.Visible = true
		self.controlPanel.Visible = false
		self.spawnLbl.Text = string.format(
			"📍 CLICK ANY LAND TO PICK YOUR SPAWN SPOT — Starting in %.1fs",
			state.spawnSecondsLeft or 0
		)
	else
		self.spawnBanner.Visible = false
		self.controlPanel.Visible = true
	end

	-- 2. My Control Panel Readouts
	local me = self.canvas.playersById[mySmallId]
	if me ~= nil and me.alive then
		local capWarn = (me.troops / math.max(1, me.maxTroops)) &gt;= 0.80
		self.troopLbl.Text = string.format("🪖 %s / %s", Format.Troops(me.troops), Format.Troops(me.maxTroops))
		self.troopLbl.TextColor3 = if capWarn then Color3.fromRGB(252, 165, 165) else Color3.new(1, 1, 1)
		self.rateLbl.Text = "+" .. Format.Troops(me.troopRatePerSec or 0) .. "/s"
		self.goldLbl.Size = UDim2.fromOffset(186, 22)
		self.goldLbl.Text = "💰 " .. Format.Gold(me.gold)
		self.atkStatusBtn.Visible = true
		if (me.attackingTroops or 0) &gt; 0 then
			self.atkStatusBtn.Text = "⚔️ " .. Format.Troops(me.attackingTroops) .. " [✕]"
			self.atkStatusBtn.BackgroundColor3 = Color3.fromRGB(185, 28, 28)
		else
			self.atkStatusBtn.Text = "⚔️ Idle"
			self.atkStatusBtn.BackgroundColor3 = Color3.fromRGB(51, 65, 85)
		end
	elseif not state.inSpawnPhase then
		self.troopLbl.Text = "👁️ SPECTATING"
		self.rateLbl.Text = ""
		self.atkStatusBtn.Visible = false
		self.goldLbl.Size = UDim2.new(1, -24, 0, 22)
		self.goldLbl.Text = "Click Leaderboard to follow"
	end

	if self.buildPopup.Visible then
		self:_RefreshBuildCosts()
	end

	-- 3. Top-Right Leaderboard &amp; Clock
	local doomTxt = if (state.doomsdayShare or 0) &gt; 0
		then string.format(" • ⏳%.1f%%", (state.doomsdayShare or 0) * 100)
		else ""
	self.lbHeaderBtn.Text = string.format(
		"⏱️ %s • Win: %d%%%s %s",
		Format.Timer(state.elapsedSeconds or 0),
		state.winPercentRequired or 80,
		doomTxt,
		if self.leaderboardOpen then "▾" else "▸"
	)

	if self.leaderboardOpen then
		local alivePlayers = {}
		for _, p in ipairs(state.players or {}) do
			if p.alive and (p.tilesOwned &gt; 0 or state.inSpawnPhase) then
				table.insert(alivePlayers, p)
			end
		end
		table.sort(alivePlayers, function(a, b)
			if a.tilesOwned ~= b.tilesOwned then
				return a.tilesOwned &gt; b.tilesOwned
			end
			return a.troops &gt; b.troops
		end)

		local totalLand = if self.canvas.map then math.max(1, self.canvas.map.numLandTiles) else 1
		local meInTop = false
		for idx = 1, 9 do
			local slot = self.lbRowPool[idx]
			local entry = alivePlayers[idx]
			if idx == 9 and not meInTop and me ~= nil and me.alive then
				entry = me
			end
			if entry ~= nil then
				if entry.smallId == mySmallId then
					meInTop = true
				end
				local relIcon = ""
				if entry.smallId == mySmallId then
					relIcon = "★ "
				elseif self.canvas.friendlySet[entry.smallId] then
					relIcon = "🤝 "
				elseif entry.isTraitor then
					relIcon = "💀 "
				elseif self.canvas.embargoSet[entry.smallId] then
					relIcon = "🚫 "
				end
				slot.swatch.BackgroundColor3 = Theme.HexToColor3(entry.colorHex)
				slot.txt.Text = string.format("%d. %s%s", idx, relIcon, entry.name)
				slot.stats.Text = string.format(
					"%s • %s",
					Format.Percent(entry.tilesOwned / totalLand),
					Format.Troops(entry.troops)
				)
				slot.row.BackgroundColor3 = if entry.smallId == mySmallId
					then Color3.fromRGB(30, 58, 95)
					else Theme.UI.BgCard
				slot.setTarget(entry.smallId)
				slot.row.Visible = true
			else
				slot.row.Visible = false
			end
		end
	end

	-- 4. Event Feed
	local evs = state.events or {}
	local nEv = #evs
	for i = 1, 5 do
		local ev = evs[nEv - 5 + i]
		local itemBtn = self.feedItems[i]
		if ev ~= nil then
			itemBtn.Text = ev.text
			itemBtn.TextColor3 = Theme.HexToColor3(ev.colorHex or "#f8fafc")
			self.feedCoords[i] = { x = ev.targetX, y = ev.targetY }
			itemBtn.Visible = true
		else
			itemBtn.Visible = false
		end
	end

	-- 5. Actionable Alerts (Incoming Nuke Siren, Alliance Requests, Alliance Expiring!)
	self.alertsBox:ClearAllChildren()
	local aLayout = Instance.new("UIListLayout")
	aLayout.Padding = UDim.new(0, 6)
	aLayout.Parent = self.alertsBox

	local myAlerts = if state.alertsByPlayer then state.alertsByPlayer[mySmallId] else nil
	if myAlerts ~= nil then
		for _, al in ipairs(myAlerts) do
			if not self.seenAlertIds[al.id] then
				self.seenAlertIds[al.id] = true
				SoundFX.Play(if al.kind == "NukeInbound" then "alert" else "alliance")
			end
			if al.kind == "NukeInbound" then
				local warnBtn = UiWidgets.MakeButton(
					self.alertsBox,
					string.format("☢️ %s INBOUND FROM %s! [JUMP]", tostring(al.unitType), al.fromName),
					Color3.fromRGB(185, 28, 28),
					UDim2.new(1, 0, 0, 38),
					nil
				)
				warnBtn.TextSize = 11
				warnBtn.ZIndex = 25
				warnBtn.Activated:Connect(function()
					if al.targetX and al.targetY then
						self.camera:FocusOn(al.targetX, al.targetY, math.max(self.camera.scale, 6.5))
					end
					self.callbacks.onSendIntent("DismissAlert", { alertId = al.id })
				end)
			else
				local card = Instance.new("Frame")
				card.Size = UDim2.new(1, 0, 0, 56)
				card.BackgroundColor3 = Theme.UI.BgPanel
				card.BorderSizePixel = 0
				card.ZIndex = 25
				UiWidgets.AddCorner(card, 8)
				UiWidgets.AddStroke(card, Theme.UI.AccentGreen, 1.5, 0.2)
				card.Parent = self.alertsBox

				local lbl = Instance.new("TextLabel")
				lbl.Position = UDim2.fromOffset(8, 4)
				lbl.Size = UDim2.new(1, -16, 0, 20)
				lbl.BackgroundTransparency = 1
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 11
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.TextColor3 = Color3.new(1, 1, 1)
				lbl.Text = if al.kind == "AllianceExpiring"
					then ("🤝 Extend alliance with " .. al.fromName .. "?")
					else ("🤝 Alliance request from " .. al.fromName)
				lbl.ZIndex = 26
				lbl.Parent = card

				local acc = UiWidgets.MakeButton(card, "✓ Accept", Theme.UI.AccentGreen, UDim2.fromOffset(92, 24), UDim2.fromOffset(8, 27))
				acc.TextSize = 11
				acc.ZIndex = 26
				acc.Activated:Connect(function()
					SoundFX.Play("alliance")
					self.callbacks.onSendIntent("RespondAlliance", { fromSmallId = al.fromSmallId, accept = true })
				end)

				local dec = UiWidgets.MakeButton(card, "✕ Ignore", Theme.UI.BgCard, UDim2.fromOffset(84, 24), UDim2.fromOffset(108, 27))
				dec.TextSize = 11
				dec.ZIndex = 26
				dec.Activated:Connect(function()
					self.callbacks.onSendIntent("RespondAlliance", { fromSmallId = al.fromSmallId, accept = false })
				end)
			end
		end
	end

	-- 6. Minimap Live EditableImage Texture + Continent Preview + Territory Dots
	local liveMini = self.canvas:GetMinimapEditableImage()
	if liveMini ~= nil then
		if self.boundMiniObj ~= liveMini then
			self.boundMiniObj = liveMini
			pcall(function()
				self.miniLiveImg.ImageContent = Content.fromObject(liveMini)
			end)
		end
		self.miniLiveImg.Visible = true
		self.miniMapPreview.Visible = false
	else
		self.miniLiveImg.Visible = false
		self.miniMapPreview.Visible = true
		if state.mapId ~= nil and state.mapId ~= self.lastMiniMapId then
			self.lastMiniMapId = state.mapId
			UiWidgets.PopulateMapPreview(self.miniMapPreview, MapRegistry.Get(state.mapId))
		end
	end
	if self.canvas.map ~= nil and liveMini == nil then
		local mw, mh = self.canvas.map.width, self.canvas.map.height
		local activeDotIds: { [number]: boolean } = {}
		for _, p in ipairs(state.players or {}) do
			if p.alive and p.tilesOwned &gt; 25 then
				activeDotIds[p.smallId] = true
				local d = self.miniDots[p.smallId]
				if d == nil then
					d = Instance.new("Frame")
					d.AnchorPoint = Vector2.new(0.5, 0.5)
					d.BorderSizePixel = 0
					d.ZIndex = 22
					UiWidgets.AddCorner(d, 99)
					d.Parent = self.miniDotsLayer
					self.miniDots[p.smallId] = d
				end
				local dotSz = math.clamp(math.sqrt(p.tilesOwned) * 0.08, 3, 12)
				d.Size = UDim2.fromOffset(dotSz, dotSz)
				d.Position = UDim2.fromScale(p.labelX / mw, p.labelY / mh)
				d.BackgroundColor3 = Theme.HexToColor3(p.colorHex)
				d.Visible = true
			end
		end
		for sid, d in pairs(self.miniDots) do
			if not activeDotIds[sid] then
				d.Visible = false
			end
		end
	end
end

function HudUI:StepMinimapViewport()
	local map = self.canvas.map
	if map == nil then
		return
	end
	local visW = (self.camera.viewW / self.camera.scale) / map.width
	local visH = (self.camera.viewH / self.camera.scale) / map.height
	local cx = self.camera.centerX / map.width
	local cy = self.camera.centerY / map.height
	local clampedW = math.clamp(visW, 0.04, 1)
	local clampedH = math.clamp(visH, 0.04, 1)
	self.miniCamRect.Size = UDim2.fromScale(clampedW, clampedH)
	self.miniCamRect.Position = UDim2.fromScale(
		math.clamp(cx - clampedW * 0.5, 0, 1 - clampedW),
		math.clamp(cy - clampedH * 0.5, 0, 1 - clampedH)
	)
end

function HudUI:SyncCanvasExclusions(inMenu: boolean)
	local anyModal = inMenu
		or self.buildPopup.Visible
		or self.inspectorModal.Visible
		or self.resultModal.Visible
	self.canvas.hideWorldLabels = anyModal
	local rects = {}
	if not inMenu then
		local sc = self.uiScale.Scale
		local vw, vh = self.camera.viewW, self.camera.viewH
		if self.controlPanel.Visible then
			rects[#rects + 1] = { 0, vh - 190 * sc, 378 * sc, vh }
		end
		local lbH = if self.leaderboardOpen then 274 * sc else 56 * sc
		rects[#rects + 1] = { vw - 318 * sc, 0, vw, lbH }
		rects[#rects + 1] = { vw - 318 * sc, vh - 286 * sc, vw, vh }
		if self.spawnBanner.Visible or self.armedPill.Visible then
			rects[#rects + 1] = { vw * 0.5 - 245 * sc, 0, vw * 0.5 + 245 * sc, 78 * sc }
		end
		rects[#rects + 1] = { 0, 0, 250 * sc, 52 * sc }
		if #self.alertsBox:GetChildren() &gt; 1 then
			rects[#rects + 1] = { 0, 50 * sc, 330 * sc, 210 * sc }
		end
		if self.radialRoot.Visible then
			local rx = self.radialRoot.Position.X.Offset * sc
			local ry = self.radialRoot.Position.Y.Offset * sc
			rects[#rects + 1] = { rx - 108 * sc, ry - 108 * sc, rx + 108 * sc, ry + 108 * sc }
		end
		if self.emojiPopup.Visible or self.chatPopup.Visible then
			rects[#rects + 1] = { 0, vh - 470 * sc, 280 * sc, vh }
		end
	end
	self.canvas.hudBlockedRects = rects
end

function HudUI:SetVisible(vis: boolean)
	self.root.Visible = vis
	if not vis then
		self.radialRoot.Visible = false
		self.buildPopup.Visible = false
		self.inspectorModal.Visible = false
		self.emojiPopup.Visible = false
		self.chatPopup.Visible = false
		self.resultModal.Visible = false
		self.modalScrim.Visible = false
		self:ClearArmedModes()
	end
end

return HudUI
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX000122"><Properties><string name="Name">Main</string><ProtectedString name="Source">--!native
--!strict
-- OpenFront Full-Scale 2D Client Entrypoint (`Main.client.luau`)
-- Pure 2D Browser-Exact Experience inside ScreenGui (`IgnoreGuiInset = true`) with:
--   - Full `ownerSnapshot` + `falloutSnapshot` decoding on join/late-join
--   - Multi-Atlas `1024x1024` `EditableImage` + Live `220x110` Minimap texture sync
--   - Mobile Pinch-vs-Pan touch guard (`zero accidental attacks on multi-finger release!`)
--   - Full Console/Gamepad Thumbstick Pan + Trigger Zoom support
--   - Clean Connection Maid lifecycle!

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

task.spawn(function()
	for _ = 1, 8 do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
		end)
		task.wait(0.5)
	end
end)

local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")
local NetCodec = require(Shared:WaitForChild("NetCodec"))
local Types = require(Shared:WaitForChild("Types"))

local Remotes = ReplicatedStorage:WaitForChild("OpenFrontRemotes")
local ClientIntentRE = Remotes:WaitForChild("ClientIntent") :: RemoteEvent
local StateSyncRE = Remotes:WaitForChild("StateSync") :: RemoteEvent
local LobbySyncRE = Remotes:WaitForChild("LobbySync") :: RemoteEvent
local MatchResultRE = Remotes:WaitForChild("MatchResult") :: RemoteEvent
local ProfileSyncRE = Remotes:WaitForChild("ProfileSync") :: RemoteEvent
local GetInitialStateRF = Remotes:WaitForChild("GetInitialState") :: RemoteFunction

local Camera2D = require(script.Parent:WaitForChild("Camera2D"))
local HudUI = require(script.Parent:WaitForChild("HudUI"))
local MapCanvas = require(script.Parent:WaitForChild("MapCanvas"))
local MenuUI = require(script.Parent:WaitForChild("MenuUI"))
local SoundFX = require(script.Parent:WaitForChild("SoundFX"))

local connections: { RBXScriptConnection } = {}

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OpenFrontApp"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
ScreenGui.DisplayOrder = 10
ScreenGui.Parent = PlayerGui

local MapViewport = Instance.new("Frame")
MapViewport.Name = "MapViewport"
MapViewport.Size = UDim2.fromScale(1, 1)
MapViewport.BackgroundColor3 = Color3.fromRGB(42, 52, 65)
MapViewport.BorderSizePixel = 0
MapViewport.ClipsDescendants = true
MapViewport.ZIndex = 1
MapViewport.Parent = ScreenGui

local cam2D = Camera2D.new(2000, 1000, 1280, 720)
local canvas = MapCanvas.new(MapViewport, cam2D)

local function sendIntent(intentType: string, payload: any)
	ClientIntentRE:FireServer(intentType, payload)
end

local latestSnapshot: any = nil
local localInMenu = true
local hasAutoCenteredThisMatch = false

local menuUI = MenuUI.new(ScreenGui, {
	onSendIntent = function(intent: string, payload: any)
		sendIntent(intent, payload)
	end,
	onLocalSettingChanged = function(prof: Types.PlayerProfileSave)
		SoundFX.Volume = prof.soundVolume or 0.7
		canvas.showNames = prof.showNames
		canvas:SetPreferScanline(prof.preferScanline2D)
		canvas:MarkAllDirty()
	end,
})

local hudUI = HudUI.new(ScreenGui, cam2D, canvas, {
	onSendIntent = function(intent: string, payload: any)
		sendIntent(intent, payload)
	end,
	onExitToMenu = function()
		localInMenu = true
		sendIntent("ReturnToLobby", {})
		menuUI:SetVisible(true)
	end,
})

local function findMySmallId(players: { any }?): number
	if players == nil then
		return 0
	end
	local uid = LocalPlayer.UserId
	for _, p in ipairs(players) do
		if p.userId == uid then
			return p.smallId
		end
	end
	return 0
end

local function applyServerPayload(payload: any)
	if type(payload) ~= "table" then
		return
	end
	latestSnapshot = payload

	if payload.mapId ~= nil and (canvas.map == nil or canvas.map.id ~= payload.mapId) then
		canvas:LoadMap(payload.mapId)
		hasAutoCenteredThisMatch = false
	end

	if payload.isPreview == true then
		localInMenu = true
		menuUI:SetVisible(true)
		hudUI:SetVisible(false)
	else
		if localInMenu and findMySmallId(payload.players) &gt; 0 then
			localInMenu = false
		end
		menuUI:SetVisible(localInMenu)
		hudUI:SetVisible(not localInMenu)
	end

	local mySid = findMySmallId(payload.players)
	canvas:UpdatePalettes(payload.players or {}, mySid, payload.units)

	if canvas.map ~= nil and payload.tileBuffer ~= nil then
		if payload.isFullSnapshot then
			NetCodec.DecodeFullOwnerSnapshot(payload.tileBuffer, canvas.map.owner, canvas.map.size)
			if payload.falloutSnapshot ~= nil then
				canvas.map.numFalloutTiles =
					NetCodec.DecodeFullFalloutSnapshot(payload.falloutSnapshot, canvas.map.fallout, canvas.map.size)
			end
			canvas:MarkAllDirty()
		else
			NetCodec.ApplyTileDeltas(
				payload.tileBuffer,
				canvas.map.owner,
				canvas.map.width,
				canvas.dirtyRows,
				canvas.dirtyTiles
			)
		end
	end
	if canvas.map ~= nil and payload.falloutBuffer ~= nil then
		NetCodec.ApplyFalloutDeltas(
			payload.falloutBuffer,
			canvas.map.fallout,
			canvas.map.width,
			canvas.dirtyRows,
			canvas.dirtyTiles
		)
	end

	if payload.railEdges ~= nil and ((payload.ticks or 0) % 10 == 1 or payload.isFullSnapshot) then
		canvas:SetRailEdges(payload.railEdges)
	end

	if payload.explosions ~= nil and #payload.explosions &gt; 0 then
		if not localInMenu then
			SoundFX.Play("boom")
		end
		for _, ex in ipairs(payload.explosions) do
			canvas:SpawnShockwave(ex.x, ex.y, ex.radius, ex.kind)
		end
	end

	-- Frame full regional continent theatre around player's homeland on full-scale 2000px..4108px maps!
	if not payload.isPreview and not payload.inSpawnPhase and not hasAutoCenteredThisMatch and mySid &gt; 0 then
		local me = canvas.playersById[mySid]
		if me ~= nil and me.alive then
			hasAutoCenteredThisMatch = true
			cam2D:FocusOn(me.labelX, me.labelY, math.max(cam2D.scale, 1.9))
		end
	end

	if not localInMenu then
		hudUI:UpdateFromState(payload, mySid)
	end
end

table.insert(connections, StateSyncRE.OnClientEvent:Connect(applyServerPayload))
table.insert(connections, LobbySyncRE.OnClientEvent:Connect(function(lobbyState: any)
	menuUI:UpdateLobbyState(lobbyState)
end))
table.insert(connections, ProfileSyncRE.OnClientEvent:Connect(function(prof: Types.PlayerProfileSave)
	SoundFX.Volume = prof.soundVolume or 0.7
	menuUI:SetProfile(prof)
	hudUI:SetAttackRatio(prof.defaultAttackRatio or 0.25)
	canvas.showNames = prof.showNames
	canvas:SetPreferScanline(prof.preferScanline2D)
end))
table.insert(connections, MatchResultRE.OnClientEvent:Connect(function(res: any)
	if not localInMenu then
		hudUI:ShowMatchResult(res)
	end
end))

task.spawn(function()
	local ok, initData = pcall(function()
		return GetInitialStateRF:InvokeServer()
	end)
	if ok and type(initData) == "table" then
		if initData.profile ~= nil then
			SoundFX.Volume = initData.profile.soundVolume or 0.7
			menuUI:SetProfile(initData.profile)
			hudUI:SetAttackRatio(initData.profile.defaultAttackRatio or 0.25)
			canvas.showNames = initData.profile.showNames
			canvas:SetPreferScanline(initData.profile.preferScanline2D)
		end
		if initData.snapshot ~= nil then
			applyServerPayload(initData.snapshot)
		end
	end
end)

-- ============================================================================
-- FULL PC MOUSE, MOBILE PINCH-GUARDED TOUCH, AND CONSOLE GAMEPAD INPUT!
-- ============================================================================
local isDragging = false
local isPinching = false
local pinchCooldownUntil = 0
local dragMovedPx = 0
local lastDragPos = Vector2.zero
local rightDownPos = Vector2.zero
local touchPressStart = 0
local gamepadStick = Vector2.zero
local gamepadZoomDir = 0

local function toScreenCoords(rawPos: Vector3 | Vector2): (number, number)
	local inset = GuiService:GetGuiInset()
	return rawPos.X, rawPos.Y + inset.Y
end

local function handleMapPrimaryClick(screenX: number, screenY: number)
	if localInMenu or latestSnapshot == nil or canvas.map == nil then
		return
	end
	hudUI.radialRoot.Visible = false
	hudUI.emojiPopup.Visible = false
	hudUI.chatPopup.Visible = false

	local tx, ty, inside = cam2D:ScreenToTile(screenX, screenY)
	if not inside then
		return
	end

	if
		UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
	then
		hudUI:ToggleBuildMenu(tx, ty)
		return
	end

	if latestSnapshot.inSpawnPhase then
		SoundFX.Play("click")
		sendIntent("ChooseSpawn", { x = tx, y = ty })
		return
	end

	if canvas.armedBuildType ~= nil then
		local unitType = canvas.armedBuildType
		if unitType == "AtomBomb" or unitType == "HydrogenBomb" or unitType == "MIRV" then
			SoundFX.Play("launch")
		else
			SoundFX.Play("build")
		end
		sendIntent("BuildUnit", { unitType = unitType, x = tx, y = ty })
		if not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			hudUI:ClearArmedModes()
		end
		return
	end

	if hudUI.boatModeArmed then
		SoundFX.Play("boat")
		sendIntent("BoatAttack", { x = tx, y = ty, ratio = hudUI.attackRatio })
		hudUI:ClearArmedModes()
		return
	end

	if canvas.selectedWarshipId ~= nil then
		SoundFX.Play("boat")
		sendIntent("MoveWarship", { unitId = canvas.selectedWarshipId, x = tx, y = ty })
		hudUI:ClearArmedModes()
		return
	end
	for _, u in ipairs(latestSnapshot.units or {}) do
		if u.unitType == "Warship" and u.ownerSmallId == canvas.mySmallId then
			if math.abs(u.x - tx) &lt;= 8 and math.abs(u.y - ty) &lt;= 8 then
				SoundFX.Play("click")
				canvas.selectedWarshipId = u.id
				hudUI.armedTxt.Text = "🚢 WARSHIP SELECTED: Click any ocean tile to patrol!"
				hudUI.armedPill.Visible = true
				return
			end
		end
	end

	local ref = ty * canvas.map.width + tx
	local tb = buffer.readu8(canvas.map.terrain, ref)
	local isLand = bit32.band(tb, 0x80) ~= 0
	if isLand then
		local targetOwnerId = buffer.readu16(canvas.map.owner, ref * 2)
		if targetOwnerId ~= canvas.mySmallId then
			SoundFX.Play("attack")
			sendIntent("AttackLand", { targetSmallId = targetOwnerId, ratio = hudUI.attackRatio })
		end
	end
end

table.insert(connections, MapViewport.InputBegan:Connect(function(inp: InputObject)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		if isPinching then
			return
		end
		local sx, sy = toScreenCoords(inp.Position)
		isDragging = true
		dragMovedPx = 0
		lastDragPos = Vector2.new(sx, sy)
		touchPressStart = os.clock()
	elseif inp.UserInputType == Enum.UserInputType.MouseButton3 then
		local sx, sy = toScreenCoords(inp.Position)
		isDragging = true
		dragMovedPx = 999
		lastDragPos = Vector2.new(sx, sy)
	elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then
		local sx, sy = toScreenCoords(inp.Position)
		rightDownPos = Vector2.new(sx, sy)
		isDragging = true
		dragMovedPx = 0
		lastDragPos = rightDownPos
	end
end))

table.insert(connections, UserInputService.InputChanged:Connect(function(inp: InputObject, gameProcessed: boolean)
	if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
		local sx, sy = toScreenCoords(inp.Position)
		local cur = Vector2.new(sx, sy)
		local tx, ty, inside = cam2D:ScreenToTile(sx, sy)
		if inside and canvas.map ~= nil then
			canvas.cursorTileX = tx
			canvas.cursorTileY = ty
			local prevHover = canvas.hoveredOwnerId
			local newHover = buffer.readu16(canvas.map.owner, (ty * canvas.map.width + tx) * 2)
			if newHover ~= prevHover then
				canvas.hoveredOwnerId = newHover
			end
		end

		if isDragging and not isPinching then
			local delta = cur - lastDragPos
			dragMovedPx += delta.Magnitude
			lastDragPos = cur
			if dragMovedPx &gt; 5 then
				cam2D:PanByScreenDelta(delta.X, delta.Y)
			end
		end
	elseif inp.UserInputType == Enum.UserInputType.MouseWheel and not gameProcessed then
		local sx, sy = toScreenCoords(inp.Position)
		local factor = if inp.Position.Z &gt; 0 then 1.22 else (1 / 1.22)
		cam2D:ZoomAtScreenPoint(factor, sx, sy)
	elseif inp.KeyCode == Enum.KeyCode.Thumbstick1 then
		local mag = Vector2.new(inp.Position.X, inp.Position.Y)
		gamepadStick = if mag.Magnitude &gt; 0.16 then Vector2.new(mag.X, -mag.Y) else Vector2.zero
	elseif inp.KeyCode == Enum.KeyCode.ButtonR2 or inp.KeyCode == Enum.KeyCode.ButtonL2 then
		if inp.KeyCode == Enum.KeyCode.ButtonR2 then
			gamepadZoomDir = if inp.Position.Z &gt; 0.15 then 1 else 0
		else
			gamepadZoomDir = if inp.Position.Z &gt; 0.15 then -1 else 0
		end
	end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(inp: InputObject)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		if isDragging then
			isDragging = false
			if isPinching or os.clock() &lt; pinchCooldownUntil then
				return
			end
			local sx, sy = toScreenCoords(inp.Position)
			local heldDuration = os.clock() - touchPressStart
			if dragMovedPx &lt;= 6 then
				if inp.UserInputType == Enum.UserInputType.Touch and heldDuration &gt;= 0.45 then
					local tx, ty, inside = cam2D:ScreenToTile(sx, sy)
					if inside then
						hudUI:OpenRadialMenu(sx, sy, tx, ty)
					end
				else
					handleMapPrimaryClick(sx, sy)
				end
			end
		end
	elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then
		isDragging = false
		if dragMovedPx &lt;= 6 and not localInMenu then
			local sx, sy = toScreenCoords(inp.Position)
			local tx, ty, inside = cam2D:ScreenToTile(sx, sy)
			if inside then
				hudUI:OpenRadialMenu(sx, sy, tx, ty)
			end
		end
	elseif inp.UserInputType == Enum.UserInputType.MouseButton3 then
		isDragging = false
	end
end))

-- Guarded Mobile Two-Finger Pinch-to-Zoom!
local lastPinchScale = 1.0
table.insert(connections, UserInputService.TouchPinch:Connect(function(touchPositions: { Vector2 }, scale: number, _vel: number, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		isPinching = true
		isDragging = false
		lastPinchScale = 1.0
	elseif state == Enum.UserInputState.Change and #touchPositions &gt;= 1 then
		isPinching = true
		local ratio = scale / math.max(0.05, lastPinchScale)
		lastPinchScale = scale
		local mid = touchPositions[1]
		if #touchPositions &gt;= 2 then
			mid = (touchPositions[1] + touchPositions[2]) * 0.5
		end
		local sx, sy = toScreenCoords(mid)
		cam2D:ZoomAtScreenPoint(ratio, sx, sy)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		isPinching = false
		pinchCooldownUntil = os.clock() + 0.18
	end
end))

table.insert(connections, UserInputService.InputBegan:Connect(function(inp: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	local kc = inp.KeyCode
	if kc == Enum.KeyCode.Escape then
		hudUI:ClearArmedModes()
		hudUI.radialRoot.Visible = false
		hudUI.buildPopup.Visible = false
		hudUI.inspectorModal.Visible = false
		hudUI.emojiPopup.Visible = false
		hudUI.chatPopup.Visible = false
	elseif localInMenu then
		return
	elseif kc == Enum.KeyCode.Space then
		canvas.altView = not canvas.altView
		canvas:MarkAllDirty()
	elseif kc == Enum.KeyCode.B then
		hudUI:ToggleBuildMenu(nil, nil)
	elseif kc == Enum.KeyCode.V then
		hudUI:ArmBoatMode()
	elseif kc == Enum.KeyCode.R then
		sendIntent("Retreat", {})
		sendIntent("RetreatBoats", {})
	elseif kc == Enum.KeyCode.M then
		hudUI.emojiPopup.Visible = not hudUI.emojiPopup.Visible
	elseif kc == Enum.KeyCode.T then
		hudUI.chatPopup.Visible = not hudUI.chatPopup.Visible
	elseif kc == Enum.KeyCode.C then
		local me = canvas.playersById[canvas.mySmallId]
		if me ~= nil then
			cam2D:FocusOn(me.labelX, me.labelY, math.max(cam2D.scale, 2.2))
		end
	elseif kc == Enum.KeyCode.Zero then
		cam2D:FitWorld()
	elseif kc == Enum.KeyCode.Q then
		hudUI:SetAttackRatio(hudUI.attackRatio - 0.10)
	elseif kc == Enum.KeyCode.E then
		hudUI:SetAttackRatio(hudUI.attackRatio + 0.10)
	elseif kc == Enum.KeyCode.Equals or kc == Enum.KeyCode.KeypadPlus then
		cam2D:ZoomAtScreenPoint(1.25, cam2D.viewW * 0.5, cam2D.viewH * 0.5)
	elseif kc == Enum.KeyCode.Minus or kc == Enum.KeyCode.KeypadMinus then
		cam2D:ZoomAtScreenPoint(0.80, cam2D.viewW * 0.5, cam2D.viewH * 0.5)
	elseif kc.Value &gt;= Enum.KeyCode.One.Value and kc.Value &lt;= Enum.KeyCode.Nine.Value then
		local pct = (kc.Value - Enum.KeyCode.One.Value + 1) * 0.10
		hudUI:SetAttackRatio(pct)
	end
end))

table.insert(connections, RunService.RenderStepped:Connect(function(dt: number)
	local absSize = ScreenGui.AbsoluteSize
	if absSize.X &gt; 0 and absSize.Y &gt; 0 and (absSize.X ~= cam2D.viewW or absSize.Y ~= cam2D.viewH) then
		cam2D:SetViewportSize(absSize.X, absSize.Y)
		local responsiveScale = math.clamp(math.min(absSize.X / 1280, absSize.Y / 720), 0.50, 1.15)
		menuUI.uiScale.Scale = responsiveScale
		hudUI.uiScale.Scale = responsiveScale
	end
	hudUI:SyncCanvasExclusions(localInMenu)

	if not UserInputService:GetFocusedTextBox() then
		local mx, my = gamepadStick.X, gamepadStick.Y
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
			mx -= 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
			mx += 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
			my -= 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
			my += 1
		end
		cam2D:StepKeyboard(mx, my, dt)
		if gamepadZoomDir ~= 0 then
			cam2D:ZoomAtScreenPoint(1 + gamepadZoomDir * dt * 1.6, cam2D.viewW * 0.5, cam2D.viewH * 0.5)
		end
	end

	if localInMenu and not isDragging then
		cam2D.centerX = if canvas.map ~= nil
			then (canvas.map.width * 0.5 + math.sin(os.clock() * 0.12) * 48)
			else cam2D.centerX
	end

	canvas:RenderFrame(latestSnapshot, dt)
	if not localInMenu then
		hudUI:StepMinimapViewport()
	end
end))
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="ModuleScript" referent="RBX000123"><Properties><string name="Name">MapCanvas</string><ProtectedString name="Source">--!native
--!strict
-- Pure 2D Full-Scale OpenFront Renderer (`MapCanvas.luau` — Multi-Atlas `EditableImage` Grid!)
-- Supports ANY map dimension up to `4108x1948` (`8,002,384` pixels!) with zero seams &amp; zero crashes:
--   Backend 1 (Primary): Tiled `ceil(W / 1024) x ceil(H / 1024)` grid of `&lt;= 1024x1024` `EditableImage`s
--     with surgical per-tile dirty-row band `:WritePixelsBuffer` uploads + `:Destroy()` cleanup!
--   Backend 2 (Auto Fallback): Multi-row adaptive opaque `Scanline2D` (`BackgroundTransparency == 0`,
--     automatically downsamples vertical step on `1000..4108px` maps so instance count stays fast &amp; crisp!)
--   Plus live `220x110` `MinimapEditableImage`, smooth Nation Label interpolation, exact `Config` range rings,
--   and strict zero-overlap AABB placement!

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local MapCodec = require(Shared:WaitForChild("MapCodec"))
local MapRegistry = require(Shared:WaitForChild("Maps"):WaitForChild("MapRegistry"))
local Theme = require(Shared:WaitForChild("Theme"))

local UiWidgets = require(script.Parent:WaitForChild("UiWidgets"))

local TILE_MAX = 1024
local MINI_W = 220
local MINI_H = 110

type AtlasTile = {
	gx: number,
	gy: number,
	tx0: number,
	ty0: number,
	tw: number,
	th: number,
	imgLabel: ImageLabel,
	editImg: any,
	uploadBuf: buffer,
}

local MapCanvas = {}
MapCanvas.__index = MapCanvas

local UNIT_ICONS: { [string]: string } = {
	City = "🏙️",
	Port = "⚓",
	Factory = "🏭",
	DefensePost = "🛡️",
	MissileSilo = "🚀",
	SAMLauncher = "📡",
	Warship = "🚢",
	TransportShip = "⛴️",
	TradeShip = "💠",
	Train = "🚂",
	AtomBomb = "☢️",
	HydrogenBomb = "💥",
	MIRV = "☄️",
	MIRVWarhead = "🔻",
	SAMMissile = "⚡",
}

export type CanvasInstance = typeof(setmetatable({} :: any, MapCanvas))

function MapCanvas.new(viewportParent: Frame, camera: any): CanvasInstance
	local self = setmetatable({}, MapCanvas) :: any
	self.viewport = viewportParent
	self.camera = camera
	self.map = nil :: MapCodec.GameMap?
	self.rawMap = nil :: any

	self.altView = false
	self.terrainOnly = false
	self.showNames = true
	self.forceScanline = false
	self.usingEditableImage = false
	self.mySmallId = 0
	self.selectedWarshipId = nil :: number?
	self.hoveredOwnerId = 0
	self.armedBuildType = nil :: string?
	self.cursorTileX = 0
	self.cursorTileY = 0
	self.scanStep = 1

	self.pR = {} :: { [number]: number }
	self.pG = {} :: { [number]: number }
	self.pB = {} :: { [number]: number }
	self.borderU32 = {} :: { [number]: number }
	self.borderColor3 = {} :: { [number]: Color3 }
	self.fillColor3 = {} :: { [number]: Color3 }
	self.blendedFillColor3 = {} :: { [number]: Color3 }
	self.patternById = {} :: { [number]: string }
	self.friendlySet = {} :: { [number]: boolean }
	self.embargoSet = {} :: { [number]: boolean }
	self.defendedSet = {} :: { [number]: boolean }
	self.playersById = {} :: { [number]: any }
	self.hudBlockedRects = {} :: { { number } }
	self.hideWorldLabels = false

	local mapRoot = Instance.new("Frame")
	mapRoot.Name = "MapSurface"
	mapRoot.BackgroundColor3 = Color3.fromRGB(63, 125, 173)
	mapRoot.BorderSizePixel = 0
	mapRoot.ClipsDescendants = false
	mapRoot.Parent = viewportParent
	self.mapRoot = mapRoot

	local scanTerrainLayer = Instance.new("Folder")
	scanTerrainLayer.Name = "ScanlineTerrain"
	scanTerrainLayer.Parent = mapRoot
	self.scanTerrainLayer = scanTerrainLayer

	local scanTerritoryLayer = Instance.new("Folder")
	scanTerritoryLayer.Name = "ScanlineTerritory"
	scanTerritoryLayer.Parent = mapRoot
	self.scanTerritoryLayer = scanTerritoryLayer

	local atlasFolder = Instance.new("Frame")
	atlasFolder.Name = "EditableAtlasGrid"
	atlasFolder.Size = UDim2.fromScale(1, 1)
	atlasFolder.BackgroundTransparency = 1
	atlasFolder.BorderSizePixel = 0
	atlasFolder.Visible = false
	atlasFolder.ZIndex = 2
	atlasFolder.Parent = mapRoot
	self.atlasFolder = atlasFolder

	local overlayRoot = Instance.new("Frame")
	overlayRoot.Name = "WorldVectorOverlay"
	overlayRoot.Size = UDim2.fromScale(1, 1)
	overlayRoot.BackgroundTransparency = 1
	overlayRoot.ClipsDescendants = true
	overlayRoot.ZIndex = 5
	overlayRoot.Parent = viewportParent
	self.overlayRoot = overlayRoot

	local cursorRing = Instance.new("Frame")
	cursorRing.Name = "BuildCursorPreview"
	cursorRing.AnchorPoint = Vector2.new(0.5, 0.5)
	cursorRing.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
	cursorRing.BackgroundTransparency = 0.78
	cursorRing.Visible = false
	cursorRing.ZIndex = 9
	UiWidgets.AddCorner(cursorRing, 999)
	self.cursorRingStroke = UiWidgets.AddStroke(cursorRing, Color3.fromRGB(250, 204, 21), 2, 0.1)
	cursorRing.Parent = overlayRoot
	self.cursorRing = cursorRing

	self.scanFramePool = {} :: { Frame }
	self.rowFrames = {} :: { [number]: { Frame } }
	self.dirtyRows = {} :: { [number]: boolean }
	self.dirtyTiles = {} :: { number }
	self.fullDirty = true

	self.unitWidgets = {} :: { [number]: any }
	self.labelWidgets = {} :: { [number]: any }
	self.railFrames = {} :: { Frame }
	self.nukeRings = {} :: { [number]: Frame }
	self.shockwaves = {} :: { { frame: Frame, x: number, y: number, maxR: number, t: number } }
	self.spawnMarkers = {} :: { [number]: Frame }

	self.atlasTiles = {} :: { AtlasTile }
	self.atlasCols = 0
	self.atlasRows = 0
	self.miniEditImg = nil :: any
	self.miniPixelBuf = buffer.create(MINI_W * MINI_H * 4)
	self.minimapDirty = true
	self.pixelBuf = nil :: buffer?

	return self
end

function MapCanvas:_DestroyAtlas()
	for _, tile in ipairs(self.atlasTiles) do
		if tile.editImg ~= nil then
			pcall(function()
				tile.editImg:Destroy()
			end)
			tile.editImg = nil
		end
		if tile.imgLabel ~= nil then
			tile.imgLabel:Destroy()
		end
	end
	table.clear(self.atlasTiles)
	self.atlasCols = 0
	self.atlasRows = 0
	if self.miniEditImg ~= nil then
		pcall(function()
			self.miniEditImg:Destroy()
		end)
		self.miniEditImg = nil
	end
end

function MapCanvas:GetMinimapEditableImage(): any
	return self.miniEditImg
end

function MapCanvas:_AllocScanFrame(parent: Instance): Frame
	local n = #self.scanFramePool
	local f: Frame
	if n &gt; 0 then
		f = self.scanFramePool[n]
		self.scanFramePool[n] = nil
	else
		f = Instance.new("Frame")
		f.BorderSizePixel = 0
	end
	f.Visible = true
	f.Parent = parent
	return f
end

function MapCanvas:_RecycleRowFrames(bandY: number)
	local list = self.rowFrames[bandY]
	if list ~= nil then
		for i = #list, 1, -1 do
			local f = list[i]
			f.Visible = false
			self.scanFramePool[#self.scanFramePool + 1] = f
			list[i] = nil
		end
	end
end

function MapCanvas:LoadMap(mapId: string)
	self:_DestroyAtlas()

	local rawDef = MapRegistry.Get(mapId)
	local decoded = MapCodec.DecodeMap(rawDef)
	self.rawMap = rawDef
	self.map = decoded
	self.scanStep = math.max(1, math.ceil(decoded.height / 240))
	self.camera:SetMapSize(decoded.width, decoded.height)

	for y, _ in pairs(self.rowFrames) do
		self:_RecycleRowFrames(y)
	end
	self.scanTerrainLayer:ClearAllChildren()
	for _, uw in pairs(self.unitWidgets) do
		uw.root:Destroy()
	end
	table.clear(self.unitWidgets)
	for _, lw in pairs(self.labelWidgets) do
		lw.root:Destroy()
	end
	table.clear(self.labelWidgets)
	for _, rf in ipairs(self.railFrames) do
		rf:Destroy()
	end
	table.clear(self.railFrames)
	for _, nr in pairs(self.nukeRings) do
		nr:Destroy()
	end
	table.clear(self.nukeRings)
	for _, sw in ipairs(self.shockwaves) do
		sw.frame:Destroy()
	end
	table.clear(self.shockwaves)
	for _, sm in pairs(self.spawnMarkers) do
		sm:Destroy()
	end
	table.clear(self.spawnMarkers)

	-- Primary Backend: Seamless 2D Grid of `&lt;= 1024x1024` EditableImage Atlas Tiles!
	self.usingEditableImage = false
	if not self.forceScanline then
		local cols = math.ceil(decoded.width / TILE_MAX)
		local rows = math.ceil(decoded.height / TILE_MAX)
		local okAll = true

		for gy = 1, rows do
			local ty0 = (gy - 1) * TILE_MAX
			local th = math.min(TILE_MAX, decoded.height - ty0)
			for gx = 1, cols do
				local tx0 = (gx - 1) * TILE_MAX
				local tw = math.min(TILE_MAX, decoded.width - tx0)

				local ok, editImg = pcall(function()
					return AssetService:CreateEditableImage({
						Size = Vector2.new(tw, th),
					})
				end)
				if not ok or editImg == nil then
					okAll = false
					break
				end

				local imgLabel = Instance.new("ImageLabel")
				imgLabel.Name = string.format("AtlasTile_%d_%d", gx, gy)
				imgLabel.Position = UDim2.fromScale(tx0 / decoded.width, ty0 / decoded.height)
				imgLabel.Size = UDim2.fromScale(tw / decoded.width, th / decoded.height)
				imgLabel.BackgroundTransparency = 1
				imgLabel.BorderSizePixel = 0
				imgLabel.ResampleMode = Enum.ResamplerMode.Pixelated
				imgLabel.ZIndex = 2
				imgLabel.Parent = self.atlasFolder

				local okContent = pcall(function()
					imgLabel.ImageContent = Content.fromObject(editImg)
				end)
				if not okContent then
					imgLabel:Destroy()
					pcall(function()
						editImg:Destroy()
					end)
					okAll = false
					break
				end

				table.insert(self.atlasTiles, {
					gx = gx,
					gy = gy,
					tx0 = tx0,
					ty0 = ty0,
					tw = tw,
					th = th,
					imgLabel = imgLabel,
					editImg = editImg,
					uploadBuf = buffer.create(tw * th * 4),
				})
			end
			if not okAll then
				break
			end
		end

		if okAll and #self.atlasTiles &gt; 0 then
			self.atlasCols = cols
			self.atlasRows = rows
			self.pixelBuf = buffer.create(decoded.size * 4)
			self.usingEditableImage = true
			self.atlasFolder.Visible = true

			local okMini, miniImg = pcall(function()
				return AssetService:CreateEditableImage({
					Size = Vector2.new(MINI_W, MINI_H),
				})
			end)
			if okMini and miniImg ~= nil then
				self.miniEditImg = miniImg
			end
		else
			self:_DestroyAtlas()
		end
	end

	if not self.usingEditableImage then
		self.atlasFolder.Visible = false
		self:_BuildStaticScanlineTerrain()
	end

	self:MarkAllDirty()
end

-- Adaptive multi-row opaque ScanlineTerrain (`&lt;= ~12,000` frames even on `4108x1948` GiantWorldMap!)
function MapCanvas:_BuildStaticScanlineTerrain()
	local map = self.map
	if map == nil then
		return
	end
	local w, h = map.width, map.height
	local stepY = self.scanStep
	local stepX = math.max(1, math.ceil(w / 500))
	local terrainBuf = map.terrain

	local y = 0
	while y &lt; h do
		local nextY = math.min(h, y + stepY)
		local rowH = (nextY - y) / h
		local rowOff = y * w
		local x = 0
		while x &lt; w do
			local tb = buffer.readu8(terrainBuf, rowOff + x)
			local run = stepX
			while x + run &lt; w and buffer.readu8(terrainBuf, rowOff + x + run) == tb do
				run += stepX
			end
			local endX = math.min(w, x + run)
			local isLand = bit32.band(tb, 0x80) ~= 0
			local isShore = bit32.band(tb, 0x40) ~= 0
			if isLand or isShore then
				local seg = Instance.new("Frame")
				seg.BorderSizePixel = 0
				seg.BackgroundTransparency = 0
				seg.BackgroundColor3 = Theme.TerrainColor3LUT[tb + 1]
				seg.Position = UDim2.fromScale(x / w, y / h)
				seg.Size = UDim2.fromScale((endX - x) / w + 0.0005, rowH + 0.0008)
				seg.ZIndex = 1
				seg.Parent = self.scanTerrainLayer
			end
			x = endX
		end
		y = nextY
	end
end

function MapCanvas:MarkAllDirty()
	local map = self.map
	if map == nil then
		return
	end
	self.fullDirty = true
	self.minimapDirty = true
	for y = 0, map.height - 1 do
		self.dirtyRows[y] = true
	end
end

function MapCanvas:SetPreferScanline(prefer: boolean)
	if self.forceScanline == prefer then
		return
	end
	self.forceScanline = prefer
	if self.rawMap ~= nil then
		local prevMap = self.map
		self:LoadMap(self.rawMap.id)
		if prevMap ~= nil and self.map ~= nil and prevMap.size == self.map.size then
			buffer.copy(self.map.owner, 0, prevMap.owner, 0, prevMap.size * 2)
			buffer.copy(self.map.fallout, 0, prevMap.fallout, 0, prevMap.size)
			self:MarkAllDirty()
		end
	end
end

function MapCanvas:UpdatePalettes(players: { any }, mySmallId: number, _units: { any }?)
	self.mySmallId = mySmallId
	table.clear(self.friendlySet)
	table.clear(self.embargoSet)
	table.clear(self.playersById)

	local myObj: any = nil
	for _, p in ipairs(players) do
		self.playersById[p.smallId] = p
		if p.smallId == mySmallId then
			myObj = p
		end
	end

	if myObj ~= nil then
		self.friendlySet[mySmallId] = true
		for _, aid in ipairs(myObj.allies or {}) do
			self.friendlySet[aid] = true
		end
		for _, eid in ipairs(myObj.embargoes or {}) do
			self.embargoSet[eid] = true
		end
		if myObj.team ~= nil then
			for _, p in ipairs(players) do
				if p.team == myObj.team then
					self.friendlySet[p.smallId] = true
				end
			end
		end
	end

	for _, p in ipairs(players) do
		local sid = p.smallId
		local r, g, b = Theme.HexToRGB(p.colorHex)
		self.pR[sid], self.pG[sid], self.pB[sid] = r, g, b
		self.fillColor3[sid] = Color3.fromRGB(r, g, b)
		local fr, fg, fb = Theme.BlendTerritoryOverTerrain(190, 210, 142, r, g, b, false)
		self.blendedFillColor3[sid] = Color3.fromRGB(fr, fg, fb)
		local br, bg, bb = Theme.BorderRGB(r, g, b)
		if self.friendlySet[sid] and sid ~= mySmallId then
			bg = math.min(255, bg + 75)
		elseif self.embargoSet[sid] then
			br = math.min(255, br + 85)
		end
		self.borderU32[sid] = Theme.PackRGBA(br, bg, bb, 255)
		self.borderColor3[sid] = Color3.fromRGB(br, bg, bb)
		self.patternById[sid] = p.patternId or "none"
	end
end

function MapCanvas:_ComputePixelU32(map: MapCodec.GameMap, ref: number): number
	local tb = buffer.readu8(map.terrain, ref)
	if self.terrainOnly then
		return Theme.TerrainU32LUT[tb + 1]
	end
	if buffer.readu8(map.fallout, ref) ~= 0 then
		local x = ref % map.width
		local y = math.floor(ref / map.width)
		return if (x * 7 + y * 13) % 5 == 0 then Theme.FalloutBrightU32 else Theme.FalloutDarkU32
	end
	local oid = buffer.readu16(map.owner, ref * 2)
	if oid == 0 then
		return Theme.TerrainU32LUT[tb + 1]
	end

	local w = map.width
	local x = ref % w
	local leftRef = if x &gt; 0 then ref - 1 elseif map.wrapX then ref + (w - 1) else -1
	local rightRef = if x &lt; w - 1 then ref + 1 elseif map.wrapX then ref - (w - 1) else -1
	local isBorder = (leftRef &lt; 0)
		or (rightRef &lt; 0)
		or (ref &lt; w)
		or (ref &gt;= map.size - w)
		or (buffer.readu16(map.owner, leftRef * 2) ~= oid)
		or (buffer.readu16(map.owner, rightRef * 2) ~= oid)
		or (buffer.readu16(map.owner, (ref - w) * 2) ~= oid)
		or (buffer.readu16(map.owner, (ref + w) * 2) ~= oid)

	if self.altView then
		if oid == self.mySmallId then
			return if isBorder then Theme.PackRGBA(16, 112, 48, 255) else Theme.Affiliation.SelfU32
		elseif self.friendlySet[oid] then
			return if isBorder then Theme.PackRGBA(161, 98, 7, 255) else Theme.Affiliation.AllyU32
		else
			return if isBorder then Theme.PackRGBA(153, 27, 27, 255) else Theme.Affiliation.EnemyU32
		end
	end

	if isBorder then
		return self.borderU32[oid] or Theme.PackRGBA(30, 30, 30, 255)
	end

	local pr = self.pR[oid] or 180
	local pg = self.pG[oid] or 180
	local pb = self.pB[oid] or 180
	local pat = self.patternById[oid]
	if pat ~= nil and pat ~= "none" then
		local y = math.floor(ref / w)
		if Theme.SamplePatternSecondary(pat, x, y) then
			pr = math.floor(pr * 0.80)
			pg = math.floor(pg * 0.80)
			pb = math.floor(pb * 0.80)
		end
	end
	if self.hoveredOwnerId == oid then
		pr = math.min(255, pr + 26)
		pg = math.min(255, pg + 26)
		pb = math.min(255, pb + 26)
	end

	local tr, tg, tblue = Theme.TerrainByteToRGB(tb)
	local fr, fg, fb = Theme.BlendTerritoryOverTerrain(tr, tg, tblue, pr, pg, pb, false)
	return Theme.PackRGBA(fr, fg, fb, 255)
end

function MapCanvas:_UploadDirtyAtlasTiles(w: number, h: number, pbuf: buffer, isFull: boolean)
	local dirtyRows = self.dirtyRows
	for _, tile in ipairs(self.atlasTiles) do
		local ty0 = tile.ty0
		local th = tile.th
		local tw = tile.tw
		local tx0 = tile.tx0
		local dMin = th
		local dMax = -1
		if isFull then
			dMin = 0
			dMax = th - 1
		else
			for ly = 0, th - 1 do
				if dirtyRows[ty0 + ly] then
					if ly &lt; dMin then
						dMin = ly
					end
					if ly &gt; dMax then
						dMax = ly
					end
				end
			end
		end

		if dMin &lt;= dMax then
			local spanRows = dMax - dMin + 1
			local rowBytes = tw * 4
			local uploadBuf = if spanRows == th then tile.uploadBuf else buffer.create(spanRows * rowBytes)
			for r = 0, spanRows - 1 do
				buffer.copy(uploadBuf, r * rowBytes, pbuf, ((ty0 + dMin + r) * w + tx0) * 4, rowBytes)
			end
			tile.editImg:WritePixelsBuffer(Vector2.new(0, dMin), Vector2.new(tw, spanRows), uploadBuf)
		end
	end

	-- Update downsampled `220x110` live Minimap EditableImage!
	if self.miniEditImg ~= nil then
		local mBuf = self.miniPixelBuf
		for my = 0, MINI_H - 1 do
			local sy = math.min(h - 1, math.floor((my + 0.5) * h / MINI_H))
			local srcRow = sy * w
			local dstRow = my * MINI_W
			for mx = 0, MINI_W - 1 do
				local sx = math.min(w - 1, math.floor((mx + 0.5) * w / MINI_W))
				buffer.writeu32(mBuf, (dstRow + mx) * 4, buffer.readu32(pbuf, (srcRow + sx) * 4))
			end
		end
		self.miniEditImg:WritePixelsBuffer(Vector2.zero, Vector2.new(MINI_W, MINI_H), mBuf)
	end
end

function MapCanvas:_FlushEditableImage()
	local map = self.map
	local pbuf = self.pixelBuf
	if map == nil or #self.atlasTiles == 0 or pbuf == nil then
		return
	end

	local w = map.width
	local h = map.height
	if self.fullDirty then
		self.fullDirty = false
		table.clear(self.dirtyTiles)
		local terrainBuf = map.terrain
		local ownerBuf = map.owner
		local falloutBuf = map.fallout
		local terrainLUT = Theme.TerrainU32LUT
		local tOnly = self.terrainOnly
		for ref = 0, map.size - 1 do
			if tOnly or (buffer.readu16(ownerBuf, ref * 2) == 0 and buffer.readu8(falloutBuf, ref) == 0) then
				buffer.writeu32(pbuf, ref * 4, terrainLUT[buffer.readu8(terrainBuf, ref) + 1])
			else
				buffer.writeu32(pbuf, ref * 4, self:_ComputePixelU32(map, ref))
			end
		end
		self:_UploadDirtyAtlasTiles(w, h, pbuf, true)
		table.clear(self.dirtyRows)
		return
	end

	local nDirty = #self.dirtyTiles
	if nDirty == 0 then
		return
	end

	local total = map.size
	for i = 1, nDirty do
		local ref = self.dirtyTiles[i]
		if ref &gt;= 0 and ref &lt; total then
			buffer.writeu32(pbuf, ref * 4, self:_ComputePixelU32(map, ref))
			local x = ref % w
			if x &gt; 0 then
				buffer.writeu32(pbuf, (ref - 1) * 4, self:_ComputePixelU32(map, ref - 1))
			elseif map.wrapX then
				buffer.writeu32(pbuf, (ref + w - 1) * 4, self:_ComputePixelU32(map, ref + w - 1))
			end
			if x &lt; w - 1 then
				buffer.writeu32(pbuf, (ref + 1) * 4, self:_ComputePixelU32(map, ref + 1))
			elseif map.wrapX then
				buffer.writeu32(pbuf, (ref - w + 1) * 4, self:_ComputePixelU32(map, ref - w + 1))
			end
			if ref &gt;= w then
				buffer.writeu32(pbuf, (ref - w) * 4, self:_ComputePixelU32(map, ref - w))
			end
			if ref &lt; total - w then
				buffer.writeu32(pbuf, (ref + w) * 4, self:_ComputePixelU32(map, ref + w))
			end
		end
	end
	table.clear(self.dirtyTiles)
	self:_UploadDirtyAtlasTiles(w, h, pbuf, false)
	table.clear(self.dirtyRows)
end

-- Adaptive Multi-Row Opaque Scanline2D Territory Renderer (`BackgroundTransparency == 0`)
function MapCanvas:_FlushScanlineRows()
	local map = self.map
	if map == nil then
		return
	end
	local w, h = map.width, map.height
	local stepY = self.scanStep
	local ownerBuf = map.owner
	local falloutBuf = map.fallout
	local dirtyBands: { [number]: boolean } = {}
	for rawY, isDirty in pairs(self.dirtyRows) do
		if isDirty and rawY &gt;= 0 and rawY &lt; h then
			dirtyBands[math.floor(rawY / stepY) * stepY] = true
		end
	end

	for y, _ in pairs(dirtyBands) do
		self:_RecycleRowFrames(y)
		if not self.terrainOnly then
			local list = self.rowFrames[y]
			if list == nil then
				list = {}
				self.rowFrames[y] = list
			end
			local nextY = math.min(h, y + stepY)
			local rowH = (nextY - y) / h
			local rowOff = y * w
			local x = 0
			while x &lt; w do
				local ref = rowOff + x
				local hasF = buffer.readu8(falloutBuf, ref) ~= 0
				local oid = buffer.readu16(ownerBuf, ref * 2)
				if not hasF and oid == 0 then
					x += 1
					continue
				end

				local isBorder = false
				if not hasF and oid &gt; 0 then
					isBorder = (x == 0)
						or (x == w - 1)
						or (y == 0)
						or (y &gt;= h - stepY)
						or (buffer.readu16(ownerBuf, (ref - 1) * 2) ~= oid)
						or (buffer.readu16(ownerBuf, (ref + 1) * 2) ~= oid)
						or (buffer.readu16(ownerBuf, (ref - w) * 2) ~= oid)
						or (y + stepY &lt; h and buffer.readu16(ownerBuf, (ref + stepY * w) * 2) ~= oid)
				end

				local run = 1
				while x + run &lt; w do
					local nRef = rowOff + x + run
					local nf = buffer.readu8(falloutBuf, nRef) ~= 0
					local noid = buffer.readu16(ownerBuf, nRef * 2)
					if nf ~= hasF or noid ~= oid then
						break
					end
					if not hasF then
						local nb = (x + run == w - 1)
							or (y == 0)
							or (y &gt;= h - stepY)
							or (buffer.readu16(ownerBuf, (nRef - 1) * 2) ~= oid)
							or (buffer.readu16(ownerBuf, (nRef + 1) * 2) ~= oid)
							or (buffer.readu16(ownerBuf, (nRef - w) * 2) ~= oid)
							or (y + stepY &lt; h and buffer.readu16(ownerBuf, (nRef + stepY * w) * 2) ~= oid)
						if nb ~= isBorder then
							break
						end
					end
					run += 1
				end

				local seg = self:_AllocScanFrame(self.scanTerritoryLayer)
				seg.Position = UDim2.fromScale(x / w, y / h)
				seg.BackgroundTransparency = 0
				if hasF then
					seg.Size = UDim2.fromScale(run / w + 0.0005, rowH + 0.0008)
					seg.ZIndex = 4
					seg.BackgroundColor3 = Theme.FalloutColor3
				elseif self.altView then
					seg.Size = UDim2.fromScale(run / w + 0.0005, rowH + 0.0008)
					seg.ZIndex = if isBorder then 4 else 3
					if oid == self.mySmallId then
						seg.BackgroundColor3 = if isBorder then Color3.fromRGB(16, 112, 48) else Theme.Affiliation.SelfFill
					elseif self.friendlySet[oid] then
						seg.BackgroundColor3 = if isBorder then Color3.fromRGB(161, 98, 7) else Theme.Affiliation.AllyFill
					else
						seg.BackgroundColor3 = if isBorder then Color3.fromRGB(153, 27, 27) else Theme.Affiliation.EnemyFill
					end
				elseif isBorder then
					seg.Size = UDim2.fromScale(run / w + 0.0004, rowH + 0.0006)
					seg.ZIndex = 4
					seg.BackgroundColor3 = self.borderColor3[oid] or Color3.fromRGB(45, 55, 72)
				else
					seg.Size = UDim2.fromScale(run / w + 0.0006, rowH + 0.0009)
					seg.ZIndex = 3
					seg.BackgroundColor3 = self.blendedFillColor3[oid] or self.fillColor3[oid] or Color3.fromRGB(180, 180, 180)
				end
				list[#list + 1] = seg
				x += run
			end
		end
	end
	table.clear(self.dirtyRows)
	table.clear(self.dirtyTiles)
	self.fullDirty = false
end

function MapCanvas:SpawnShockwave(x: number, y: number, radius: number, kind: string)
	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.BackgroundColor3 = if kind == "HydrogenBomb"
		then Color3.fromRGB(255, 237, 213)
		else Color3.fromRGB(254, 240, 138)
	ring.BackgroundTransparency = 0.35
	ring.BorderSizePixel = 0
	ring.ZIndex = 12
	UiWidgets.AddCorner(ring, 999)
	UiWidgets.AddStroke(ring, Color3.fromRGB(249, 115, 22), 3, 0.05)
	ring.Parent = self.overlayRoot
	table.insert(self.shockwaves, {
		frame = ring,
		x = x,
		y = y,
		maxR = radius,
		t = 0,
	})
end

function MapCanvas:SetRailEdges(railEdges: { { number } }?)
	for _, rf in ipairs(self.railFrames) do
		rf:Destroy()
	end
	table.clear(self.railFrames)
	local map = self.map
	if map == nil or railEdges == nil then
		return
	end
	local w, h = map.width, map.height
	for _, path in ipairs(railEdges) do
		for i = 1, #path - 3, 3 do
			local r1, r2 = path[i], path[math.min(#path, i + 3)]
			local x1, y1 = (r1 % w + 0.5) / w, (math.floor(r1 / w) + 0.5) / h
			local x2, y2 = (r2 % w + 0.5) / w, (math.floor(r2 / w) + 0.5) / h
			local seg = Instance.new("Frame")
			seg.BorderSizePixel = 0
			seg.AnchorPoint = Vector2.new(0.5, 0.5)
			seg.BackgroundColor3 = Theme.RailroadColor3
			seg.BackgroundTransparency = 0.25
			seg.Position = UDim2.fromScale((x1 + x2) * 0.5, (y1 + y2) * 0.5)
			local dx, dy = x2 - x1, y2 - y1
			local len = math.sqrt(dx * dx + dy * dy)
			seg.Size = UDim2.new(len + 0.002, 0, 0, 2)
			seg.Rotation = math.deg(math.atan2(dy * h, dx * w))
			seg.ZIndex = 4
			seg.Parent = self.mapRoot
			table.insert(self.railFrames, seg)
		end
	end
end

function MapCanvas:RenderFrame(stateSnapshot: any?, dt: number)
	local map = self.map
	if map == nil then
		return
	end

	if self.usingEditableImage then
		self:_FlushEditableImage()
	else
		self:_FlushScanlineRows()
	end

	local leftPx, topPx, widthPx, heightPx = self.camera:GetCanvasRect()
	self.mapRoot.Position = UDim2.fromOffset(leftPx, topPx)
	self.mapRoot.Size = UDim2.fromOffset(widthPx, heightPx)

	local scale = self.camera.scale
	local viewW, viewH = self.camera.viewW, self.camera.viewH

	-- Exact Server-Matched Build Cursor Preview Ring!
	if self.armedBuildType ~= nil then
		local sx, sy = self.camera:WorldToScreen(self.cursorTileX + 0.5, self.cursorTileY + 0.5)
		local rTiles = 10
		if self.armedBuildType == "DefensePost" then
			rTiles = Config.DefensePostRangeScaled(map.width)
		elseif self.armedBuildType == "SAMLauncher" then
			rTiles = Config.SamRangeScaled(1, map.width)
		elseif self.armedBuildType == "Warship" then
			rTiles = Config.WarshipRangeScaled(map.width)
		elseif self.armedBuildType == "AtomBomb" then
			local _, outer = Config.NukeRadii("AtomBomb", map.width)
			rTiles = outer
		elseif self.armedBuildType == "HydrogenBomb" then
			local _, outer = Config.NukeRadii("HydrogenBomb", map.width)
			rTiles = outer
		elseif self.armedBuildType == "MIRV" then
			rTiles = 65 * Config.MapScaleFactor(map.width)
		end
		local diamPx = math.max(18, rTiles * 2 * scale)
		self.cursorRing.Size = UDim2.fromOffset(diamPx, diamPx)
		self.cursorRing.Position = UDim2.fromOffset(sx, sy)
		self.cursorRing.Visible = true
	else
		self.cursorRing.Visible = false
	end

	if stateSnapshot == nil then
		return
	end

	-- Spawn Phase Beacons
	local inSpawn = stateSnapshot.inSpawnPhase == true
	local seenSpawn: { [number]: boolean } = {}
	if inSpawn then
		for _, p in ipairs(stateSnapshot.players or {}) do
			if p.spawnX &gt;= 0 and p.spawnY &gt;= 0 and (p.playerType ~= "Bot" or scale &gt; 1.5) then
				seenSpawn[p.smallId] = true
				local sm = self.spawnMarkers[p.smallId]
				if sm == nil then
					sm = Instance.new("Frame")
					sm.AnchorPoint = Vector2.new(0.5, 0.5)
					sm.BorderSizePixel = 0
					sm.ZIndex = 8
					UiWidgets.AddCorner(sm, 99)
					UiWidgets.AddStroke(sm, Color3.fromRGB(15, 23, 42), 2, 0.1)
					sm.Parent = self.overlayRoot
					self.spawnMarkers[p.smallId] = sm
				end
				local sx, sy = self.camera:WorldToScreen(p.spawnX + 0.5, p.spawnY + 0.5)
				local isMe = p.smallId == self.mySmallId
				local pulse = if isMe then (1 + 0.22 * math.sin(os.clock() * 7)) else 1
				local sz = (if isMe then 16 else 9) * pulse
				sm.BackgroundColor3 = if isMe then Color3.fromRGB(255, 213, 79) else Theme.HexToColor3(p.colorHex)
				sm.Size = UDim2.fromOffset(sz, sz)
				sm.Position = UDim2.fromOffset(sx, sy)
				sm.Visible = sx &gt; -20 and sx &lt; viewW + 20 and sy &gt; -20 and sy &lt; viewH + 20
			end
		end
	end
	for sid, sm in pairs(self.spawnMarkers) do
		if not seenSpawn[sid] then
			sm.Visible = false
		end
	end

	local placedRects: { { number } } = {}
	for _, hr in ipairs(self.hudBlockedRects) do
		placedRects[#placedRects + 1] = hr
	end
	local function hitsAnyRect(x0: number, y0: number, x1: number, y1: number, pad: number): boolean
		if x0 &lt; 10 or y0 &lt; 10 or x1 &gt; viewW - 10 or y1 &gt; viewH - 10 then
			return true
		end
		for i = 1, #placedRects do
			local r = placedRects[i]
			if x0 - pad &lt; r[3] and x1 + pad &gt; r[1] and y0 - pad &lt; r[4] and y1 + pad &gt; r[2] then
				return true
			end
		end
		return false
	end

	for _, u in ipairs(stateSnapshot.units or {}) do
		local ux, uy = self.camera:WorldToScreen(u.x + 0.5, u.y + 0.5)
		if ux &gt; -24 and ux &lt; viewW + 24 and uy &gt; -24 and uy &lt; viewH + 24 then
			local hr = math.clamp(scale * 2.2, 8, 13)
			placedRects[#placedRects + 1] = { ux - hr, uy - hr, ux + hr, uy + hr }
		end
	end

	-- Dynamic Smooth-Gliding Country Name Plates (`Label_&lt;smallId&gt;`, strictly zero screen-space AABB overlaps!)
	local activeLabelIds: { [number]: boolean } = {}
	if self.showNames and not inSpawn and not self.terrainOnly and not self.hideWorldLabels then
		local candidates = {}
		for _, p in ipairs(stateSnapshot.players or {}) do
			if p.alive and p.tilesOwned &gt; 0 then
				candidates[#candidates + 1] = p
			end
		end
		table.sort(candidates, function(a, b)
			if (a.smallId == self.mySmallId) ~= (b.smallId == self.mySmallId) then
				return a.smallId == self.mySmallId
			end
			return a.tilesOwned &gt; b.tilesOwned
		end)

		local nudges = { 0, -24, 24, -44, 44 }
		for _, p in ipairs(candidates) do
			local lw = self.labelWidgets[p.smallId]
			if lw ~= nil then
				lw.smoothX = lw.smoothX + (p.labelX - lw.smoothX) * 0.28
				lw.smoothY = lw.smoothY + (p.labelY - lw.smoothY) * 0.28
				lw.smoothSpan = lw.smoothSpan + ((p.labelSpan or 8) - lw.smoothSpan) * 0.28
			end
			local curSpan = if lw then lw.smoothSpan else (p.labelSpan or 8)
			local curX = if lw then lw.smoothX else p.labelX
			local curY = if lw then lw.smoothY else p.labelY

			local boxPx = math.max(curSpan, math.sqrt(p.tilesOwned) * 0.85) * scale
			local isMe = p.smallId == self.mySmallId
			if isMe or boxPx &gt;= 32 then
				local sx, sy = self.camera:WorldToScreen(curX + 0.5, curY + 0.5)
				local fontPx = math.clamp(math.floor(boxPx * 0.18), 10, 15)
				local statusPrefix = ""
				if p.emoji ~= nil and p.emoji ~= "" then
					statusPrefix = p.emoji .. " "
				elseif p.isTraitor then
					statusPrefix = "💀 "
				end
				local fullName = statusPrefix .. p.name
				local hasFlag = p.flag ~= nil and p.flag ~= ""
				local estW = math.clamp(math.ceil(#fullName * fontPx * 0.58) + (if hasFlag then 22 else 10), 54, 172)
				local estH = fontPx * 2 + 6

				local chosenY: number? = nil
				for _, dy in ipairs(nudges) do
					local cy = sy + dy
					local x0, y0 = sx - estW * 0.5, cy - estH * 0.5
					local x1, y1 = sx + estW * 0.5, cy + estH * 0.5
					if not hitsAnyRect(x0, y0, x1, y1, 6) then
						chosenY = cy
						placedRects[#placedRects + 1] = { x0, y0, x1, y1 }
						break
					end
				end

				if chosenY ~= nil then
					activeLabelIds[p.smallId] = true
					if lw == nil then
						local container = Instance.new("Frame")
						container.Name = "Label_" .. tostring(p.smallId)
						container.AnchorPoint = Vector2.new(0.5, 0.5)
						container.BackgroundColor3 = Color3.fromRGB(11, 17, 30)
						container.BackgroundTransparency = 0.42
						container.BorderSizePixel = 0
						container.ZIndex = 6
						UiWidgets.AddCorner(container, 5)

						local topRow = Instance.new("Frame")
						topRow.AnchorPoint = Vector2.new(0.5, 1)
						topRow.Position = UDim2.fromScale(0.5, 0.54)
						topRow.Size = UDim2.new(1, -8, 0, 16)
						topRow.BackgroundTransparency = 1
						topRow.Parent = container

						if hasFlag then
							UiWidgets.CreateFlagBadge(topRow, p.flag, UDim2.fromOffset(13, 9), UDim2.new(0, 1, 0.5, -4))
						end

						local nameLbl = Instance.new("TextLabel")
						nameLbl.Position = UDim2.fromOffset(if hasFlag then 17 else 0, 0)
						nameLbl.Size = UDim2.new(1, if hasFlag then -18 else 0, 1, 0)
						nameLbl.BackgroundTransparency = 1
						nameLbl.Font = Enum.Font.GothamBlack
						nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
						nameLbl.TextWrapped = false
						nameLbl.TextXAlignment = if hasFlag then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center
						nameLbl.TextColor3 = Color3.new(1, 1, 1)
						nameLbl.TextStrokeColor3 = Color3.fromRGB(10, 15, 28)
						nameLbl.TextStrokeTransparency = 0.15
						nameLbl.Parent = topRow

						local troopLbl = Instance.new("TextLabel")
						troopLbl.AnchorPoint = Vector2.new(0.5, 0)
						troopLbl.Position = UDim2.fromScale(0.5, 0.54)
						troopLbl.Size = UDim2.new(1, -8, 0, 13)
						troopLbl.BackgroundTransparency = 1
						troopLbl.Font = Enum.Font.GothamBold
						troopLbl.TextTruncate = Enum.TextTruncate.AtEnd
						troopLbl.TextWrapped = false
						troopLbl.TextColor3 = Color3.fromRGB(226, 232, 240)
						troopLbl.TextStrokeColor3 = Color3.fromRGB(10, 15, 28)
						troopLbl.TextStrokeTransparency = 0.2
						troopLbl.Parent = container

						container.Parent = self.overlayRoot
						lw = {
							root = container,
							nameLbl = nameLbl,
							troopLbl = troopLbl,
							smoothX = p.labelX,
							smoothY = p.labelY,
							smoothSpan = p.labelSpan or 8,
						}
						self.labelWidgets[p.smallId] = lw
					end

					lw.root.Size = UDim2.fromOffset(estW, estH)
					lw.nameLbl.TextSize = fontPx
					lw.nameLbl.Text = fullName
					lw.troopLbl.TextSize = math.max(9, fontPx - 2)
					lw.troopLbl.Text = Format.Troops(p.troops)
					lw.root.Position = UDim2.fromOffset(sx, chosenY)
					lw.root.Visible = true
				end
			end
		end
	end

	for sid, lw in pairs(self.labelWidgets) do
		if not activeLabelIds[sid] then
			lw.root.Visible = false
		end
	end

	-- Structures, Ships, Trains &amp; Missiles
	local activeUnitIds: { [number]: boolean } = {}
	local activeNukeRings: { [number]: boolean } = {}

	for _, u in ipairs(stateSnapshot.units or {}) do
		activeUnitIds[u.id] = true
		local sx, sy = self.camera:WorldToScreen(u.x + 0.5, u.y + 0.5)
		local onScreen = sx &gt; -40 and sx &lt; viewW + 40 and sy &gt; -40 and sy &lt; viewH + 40

		local wObj = self.unitWidgets[u.id]
		if wObj == nil then
			local holder = Instance.new("Frame")
			holder.Name = "Unit_" .. tostring(u.id)
			holder.AnchorPoint = Vector2.new(0.5, 0.5)
			holder.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
			holder.BackgroundTransparency = 0.15
			holder.BorderSizePixel = 0
			holder.ZIndex = 7
			UiWidgets.AddCorner(holder, 99)
			local stroke = UiWidgets.AddStroke(holder, Color3.new(1, 1, 1), 1.5, 0.2)

			local iconLbl = Instance.new("TextLabel")
			iconLbl.Size = UDim2.fromScale(0.84, 0.84)
			iconLbl.AnchorPoint = Vector2.new(0.5, 0.5)
			iconLbl.Position = UDim2.fromScale(0.5, 0.5)
			iconLbl.BackgroundTransparency = 1
			iconLbl.TextScaled = true
			iconLbl.Font = Enum.Font.GothamBold
			iconLbl.TextColor3 = Color3.new(1, 1, 1)
			iconLbl.Text = UNIT_ICONS[u.unitType] or "●"
			iconLbl.Parent = holder

			local badge = Instance.new("TextLabel")
			badge.AnchorPoint = Vector2.new(0.5, 0)
			badge.Position = UDim2.new(0.5, 0, 1, 2)
			badge.Size = UDim2.fromOffset(46, 12)
			badge.BackgroundTransparency = 1
			badge.Font = Enum.Font.GothamBold
			badge.TextSize = 9
			badge.TextWrapped = false
			badge.TextTruncate = Enum.TextTruncate.AtEnd
			badge.TextColor3 = Color3.fromRGB(254, 240, 138)
			badge.TextStrokeTransparency = 0.2
			badge.Parent = holder

			local rangeRing: Frame? = nil
			if u.unitType == "SAMLauncher" or u.unitType == "Warship" then
				local rr = Instance.new("Frame")
				rr.AnchorPoint = Vector2.new(0.5, 0.5)
				rr.Position = UDim2.fromScale(0.5, 0.5)
				rr.BackgroundTransparency = 1
				rr.Visible = false
				UiWidgets.AddCorner(rr, 999)
				UiWidgets.AddStroke(
					rr,
					if u.unitType == "SAMLauncher" then Color3.fromRGB(34, 211, 238) else Color3.fromRGB(96, 165, 250),
					1.3,
					0.55
				)
				rr.Parent = holder
				rangeRing = rr
			end

			holder.Parent = self.overlayRoot
			wObj = { root = holder, icon = iconLbl, badge = badge, stroke = stroke, rangeRing = rangeRing }
			self.unitWidgets[u.id] = wObj
		end

		wObj.root.Visible = onScreen and not self.terrainOnly
		if onScreen and not self.terrainOnly then
			local basePx = math.clamp(scale * 4.5, 13, 23)
			if u.unitType == "TradeShip" or u.unitType == "Train" then
				basePx = math.clamp(scale * 3.0, 9, 15)
			elseif u.unitType == "AtomBomb" or u.unitType == "HydrogenBomb" or u.unitType == "MIRV" then
				basePx = math.clamp(scale * 5.0, 15, 26)
			end
			wObj.root.Size = UDim2.fromOffset(basePx, basePx)
			wObj.root.Position = UDim2.fromOffset(sx, sy)
			wObj.stroke.Color = self.fillColor3[u.ownerSmallId] or Color3.new(1, 1, 1)

			local candBadge = ""
			if not self.hideWorldLabels and scale &gt;= 1.2 then
				if u.underConstruction then
					candBadge = string.format("%d%%", math.floor((u.constructionProgress or 0) * 100))
				elseif u.unitType == "TransportShip" then
					candBadge = Format.Troops(u.troops or 0)
				elseif u.unitType == "Warship" and (u.hp or 100) &lt; (u.maxHp or 100) then
					candBadge = string.format("%d%%", math.floor((u.hp / math.max(1, u.maxHp)) * 100))
				elseif (u.level or 1) &gt; 1 then
					candBadge = "Lv" .. tostring(u.level)
				end
			end
			if candBadge ~= "" then
				local bx0, by0 = sx - 22, sy + basePx * 0.5 + 1
				local bx1, by1 = sx + 22, by0 + 12
				if not hitsAnyRect(bx0, by0, bx1, by1, 3) then
					wObj.badge.Text = candBadge
					placedRects[#placedRects + 1] = { bx0, by0, bx1, by1 }
				else
					wObj.badge.Text = ""
				end
			else
				wObj.badge.Text = ""
			end

			if wObj.rangeRing ~= nil then
				if u.unitType == "SAMLauncher" and u.ownerSmallId == self.mySmallId and scale &gt;= 1.0 and not self.hideWorldLabels then
					local dPx = Config.SamRangeScaled(u.level or 1, map.width) * 2 * scale
					wObj.rangeRing.Size = UDim2.fromOffset(dPx, dPx)
					wObj.rangeRing.Visible = true
				elseif u.unitType == "Warship" and self.selectedWarshipId == u.id then
					local dPx = Config.WarshipRangeScaled(map.width) * 2 * scale
					wObj.rangeRing.Size = UDim2.fromOffset(dPx, dPx)
					wObj.rangeRing.Visible = true
				else
					wObj.rangeRing.Visible = false
				end
			end
		end

		if u.unitType == "AtomBomb" or u.unitType == "HydrogenBomb" or u.unitType == "MIRV" or u.unitType == "MIRVWarhead" then
			activeNukeRings[u.id] = true
			local nr = self.nukeRings[u.id]
			if nr == nil then
				nr = Instance.new("Frame")
				nr.AnchorPoint = Vector2.new(0.5, 0.5)
				nr.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
				nr.BackgroundTransparency = 0.80
				nr.ZIndex = 6
				UiWidgets.AddCorner(nr, 999)
				UiWidgets.AddStroke(nr, Color3.fromRGB(239, 68, 68), 2, 0.15)
				nr.Parent = self.overlayRoot
				self.nukeRings[u.id] = nr
			end
			local _, outerR = Config.NukeRadii(u.unitType, map.width)
			local dPx = math.max(16, outerR * 2 * scale)
			local dxScreen, dyScreen = self.camera:WorldToScreen(u.dstX + 0.5, u.dstY + 0.5)
			nr.Size = UDim2.fromOffset(dPx, dPx)
			nr.Position = UDim2.fromOffset(dxScreen, dyScreen)
			nr.BackgroundTransparency = 0.72 + 0.16 * math.sin(os.clock() * 12)
			nr.Visible = true
		end
	end

	for uid, wObj in pairs(self.unitWidgets) do
		if not activeUnitIds[uid] then
			wObj.root:Destroy()
			self.unitWidgets[uid] = nil
		end
	end
	for uid, nr in pairs(self.nukeRings) do
		if not activeNukeRings[uid] then
			nr:Destroy()
			self.nukeRings[uid] = nil
		end
	end

	for i = #self.shockwaves, 1, -1 do
		local sw = self.shockwaves[i]
		sw.t += dt * 1.65
		if sw.t &gt;= 1 then
			sw.frame:Destroy()
			table.remove(self.shockwaves, i)
		else
			local sx, sy = self.camera:WorldToScreen(sw.x + 0.5, sw.y + 0.5)
			local curDiam = math.max(10, sw.maxR * 2 * scale * (0.2 + 0.85 * sw.t))
			sw.frame.Size = UDim2.fromOffset(curDiam, curDiam)
			sw.frame.Position = UDim2.fromOffset(sx, sy)
			sw.frame.BackgroundTransparency = 0.25 + 0.75 * sw.t
		end
	end
end

function MapCanvas:Destroy()
	self:_DestroyAtlas()
	self.mapRoot:Destroy()
	self.overlayRoot:Destroy()
end

return MapCanvas
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000124"><Properties><string name="Name">MenuUI</string><ProtectedString name="Source">--!strict
-- Authentic Browser-Exact OpenFront.io Main Menu, Profile Bar, Flag/Color/Pattern Customizer,
-- Rotating Public Lobby Queue Card, Singleplayer Launcher, Host Custom Match Modal, Settings &amp; Guide!

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("OpenFrontShared")

local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local MapRegistry = require(Shared:WaitForChild("Maps"):WaitForChild("MapRegistry"))
local Theme = require(Shared:WaitForChild("Theme"))
local Types = require(Shared:WaitForChild("Types"))

local SoundFX = require(script.Parent:WaitForChild("SoundFX"))
local UiWidgets = require(script.Parent:WaitForChild("UiWidgets"))

local MenuUI = {}
MenuUI.__index = MenuUI

export type MenuInstance = typeof(setmetatable({} :: any, MenuUI))

function MenuUI.new(parentGui: ScreenGui, callbacks: {
	onSendIntent: (intent: string, payload: any) -&gt; (),
	onLocalSettingChanged: (profile: Types.PlayerProfileSave) -&gt; (),
}): MenuInstance
	local self = setmetatable({}, MenuUI) :: any
	self.callbacks = callbacks
	self.profile = nil :: Types.PlayerProfileSave?
	self.lobbyState = nil :: any
	self.isQueued = false
	self.customCfg = Config.DefaultGameConfig(true)

	-- Fullscreen translucent tint over the live animated AI background battle!
	local root = Instance.new("Frame")
	root.Name = "MenuOverlay"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(8, 13, 24)
	root.BackgroundTransparency = 0.34
	root.BorderSizePixel = 0
	root.ZIndex = 30
	root.Parent = parentGui
	self.root = root

	local uiScale = Instance.new("UIScale")
	uiScale.Name = "ResponsiveUIScale"
	uiScale.Scale = 1
	uiScale.Parent = root
	self.uiScale = uiScale

	-- Fullscreen modal backdrop scrim so sub-modals NEVER bleed over MainPortalCard!
	local modalScrim = Instance.new("TextButton")
	modalScrim.Name = "ModalScrim"
	modalScrim.Size = UDim2.fromScale(1, 1)
	modalScrim.BackgroundColor3 = Color3.fromRGB(4, 9, 20)
	modalScrim.BackgroundTransparency = 0.22
	modalScrim.BorderSizePixel = 0
	modalScrim.Text = ""
	modalScrim.AutoButtonColor = false
	modalScrim.Visible = false
	modalScrim.ZIndex = 44
	modalScrim.Parent = root
	self.modalScrim = modalScrim

	-- Top Header Bar (XP Level Badge + Wins/Stats + Settings + How to Play)
	local topBar = Instance.new("Frame")
	topBar.Size = UDim2.new(1, -32, 0, 52)
	topBar.Position = UDim2.fromOffset(16, 12)
	topBar.BackgroundColor3 = Theme.UI.BgPanel
	topBar.BackgroundTransparency = 0.10
	topBar.BorderSizePixel = 0
	UiWidgets.AddCorner(topBar, 10)
	UiWidgets.AddStroke(topBar, Theme.UI.Border, 1, 0.35)
	topBar.Parent = root

	local brandLbl = Instance.new("TextLabel")
	brandLbl.Position = UDim2.fromOffset(16, 0)
	brandLbl.Size = UDim2.fromOffset(196, 52)
	brandLbl.BackgroundTransparency = 1
	brandLbl.Font = Enum.Font.GothamBlack
	brandLbl.Text = "OPENFRONT"
	brandLbl.TextSize = 21
	brandLbl.TextTruncate = Enum.TextTruncate.AtEnd
	brandLbl.TextXAlignment = Enum.TextXAlignment.Left
	brandLbl.TextColor3 = Color3.new(1, 1, 1)
	brandLbl.Parent = topBar

	local statsLbl = Instance.new("TextLabel")
	statsLbl.Position = UDim2.fromOffset(222, 5)
	statsLbl.Size = UDim2.new(1, -482, 0, 22)
	statsLbl.BackgroundTransparency = 1
	statsLbl.Font = Enum.Font.GothamBold
	statsLbl.TextSize = 13
	statsLbl.TextTruncate = Enum.TextTruncate.AtEnd
	statsLbl.TextWrapped = false
	statsLbl.TextXAlignment = Enum.TextXAlignment.Left
	statsLbl.TextColor3 = Color3.fromRGB(226, 232, 240)
	statsLbl.Text = "Lv. 1  •  0 Wins  •  0 Games"
	statsLbl.Parent = topBar
	self.statsLbl = statsLbl

	local xpBg = Instance.new("Frame")
	xpBg.Position = UDim2.fromOffset(222, 31)
	xpBg.Size = UDim2.fromOffset(210, 9)
	xpBg.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
	xpBg.BorderSizePixel = 0
	UiWidgets.AddCorner(xpBg, 99)
	xpBg.Parent = topBar

	local xpFill = Instance.new("Frame")
	xpFill.Size = UDim2.fromScale(0.15, 1)
	xpFill.BackgroundColor3 = Theme.UI.AccentBlue
	xpFill.BorderSizePixel = 0
	UiWidgets.AddCorner(xpFill, 99)
	xpFill.Parent = xpBg
	self.xpFill = xpFill

	local helpBtn = UiWidgets.MakeButton(
		topBar,
		"❓ How to Play",
		Theme.UI.BgCard,
		UDim2.fromOffset(116, 34),
		UDim2.new(1, -248, 0.5, -17)
	)
	local settingsBtn = UiWidgets.MakeButton(
		topBar,
		"⚙️ Settings",
		Theme.UI.BgCard,
		UDim2.fromOffset(110, 34),
		UDim2.new(1, -122, 0.5, -17)
	)

	-- Center Main Card (exact OpenFront.io centered portal card!)
	local centerCard = Instance.new("Frame")
	centerCard.Name = "MainPortalCard"
	centerCard.AnchorPoint = Vector2.new(0.5, 0.5)
	centerCard.Position = UDim2.new(0.5, 0, 0.54, 0)
	centerCard.Size = UDim2.fromOffset(480, 446)
	centerCard.BackgroundColor3 = Theme.UI.BgPanel
	centerCard.BackgroundTransparency = 0.08
	centerCard.BorderSizePixel = 0
	UiWidgets.AddCorner(centerCard, 14)
	UiWidgets.AddStroke(centerCard, Color3.fromRGB(96, 165, 250), 1.5, 0.45)
	centerCard.Parent = root
	self.centerCard = centerCard

	local titleHero = Instance.new("TextLabel")
	titleHero.Position = UDim2.fromOffset(20, 14)
	titleHero.Size = UDim2.new(1, -40, 0, 32)
	titleHero.BackgroundTransparency = 1
	titleHero.Font = Enum.Font.GothamBlack
	titleHero.Text = "CONQUER THE WORLD"
	titleHero.TextSize = 24
	titleHero.TextColor3 = Color3.new(1, 1, 1)
	titleHero.Parent = centerCard

	local subHero = Instance.new("TextLabel")
	subHero.Position = UDim2.fromOffset(20, 44)
	subHero.Size = UDim2.new(1, -40, 0, 18)
	subHero.BackgroundTransparency = 1
	subHero.Font = Enum.Font.Gotham
	subHero.Text = "Expand borders • Build cities, ports &amp; trains • Launch MIRV nukes"
	subHero.TextSize = 12
	subHero.TextColor3 = Theme.UI.TextMuted
	subHero.Parent = centerCard

	-- Identity Customizer Row (Flag + Color + Pattern)
	local idRow = Instance.new("Frame")
	idRow.Position = UDim2.fromOffset(20, 70)
	idRow.Size = UDim2.new(1, -40, 0, 48)
	idRow.BackgroundColor3 = Theme.UI.BgCard
	idRow.BorderSizePixel = 0
	UiWidgets.AddCorner(idRow, 9)
	idRow.Parent = centerCard

	local flagHolder = Instance.new("Frame")
	flagHolder.Position = UDim2.fromOffset(10, 9)
	flagHolder.Size = UDim2.fromOffset(38, 30)
	flagHolder.BackgroundTransparency = 1
	flagHolder.Parent = idRow
	self.flagHolder = flagHolder

	local flagBtn = UiWidgets.MakeButton(
		idRow,
		"🏳️ Change Flag",
		Theme.UI.BgHover,
		UDim2.fromOffset(124, 32),
		UDim2.fromOffset(56, 8)
	)

	local colorSwatch = Instance.new("TextButton")
	colorSwatch.Position = UDim2.fromOffset(190, 8)
	colorSwatch.Size = UDim2.fromOffset(118, 32)
	colorSwatch.BackgroundColor3 = Theme.HexToColor3(Theme.HumanColors[1])
	colorSwatch.BorderSizePixel = 0
	colorSwatch.Font = Enum.Font.GothamBold
	colorSwatch.TextSize = 12
	colorSwatch.Text = "🎨 Color"
	colorSwatch.TextColor3 = Color3.fromRGB(15, 23, 42)
	UiWidgets.AddCorner(colorSwatch, 7)
	UiWidgets.AddStroke(colorSwatch, Color3.new(1, 1, 1), 1.5, 0.35)
	colorSwatch.Parent = idRow
	self.colorSwatch = colorSwatch

	local patternBtn = UiWidgets.MakeButton(
		idRow,
		"❖ Pattern: Solid",
		Theme.UI.BgHover,
		UDim2.fromOffset(122, 32),
		UDim2.fromOffset(316, 8)
	)
	self.patternBtn = patternBtn

	-- Featured Live Public Lobby Card (exact OpenFront LobbyCard.ts!)
	local publicCard = Instance.new("Frame")
	publicCard.Position = UDim2.fromOffset(20, 128)
	publicCard.Size = UDim2.new(1, -40, 0, 150)
	publicCard.BackgroundColor3 = Color3.fromRGB(22, 33, 52)
	publicCard.BorderSizePixel = 0
	UiWidgets.AddCorner(publicCard, 10)
	UiWidgets.AddStroke(publicCard, Theme.UI.AccentBlue, 1.5, 0.25)
	publicCard.Parent = centerCard

	local pubMapThumb = Instance.new("Frame")
	pubMapThumb.Position = UDim2.fromOffset(12, 12)
	pubMapThumb.Size = UDim2.fromOffset(196, 126)
	pubMapThumb.BorderSizePixel = 0
	pubMapThumb.Parent = publicCard
	self.pubMapThumb = pubMapThumb
	self.lastRenderedPubMap = ""

	local pubTitle = Instance.new("TextLabel")
	pubTitle.Position = UDim2.fromOffset(220, 14)
	pubTitle.Size = UDim2.fromOffset(205, 24)
	pubTitle.BackgroundTransparency = 1
	pubTitle.Font = Enum.Font.GothamBlack
	pubTitle.TextXAlignment = Enum.TextXAlignment.Left
	pubTitle.TextSize = 18
	pubTitle.TextColor3 = Color3.new(1, 1, 1)
	pubTitle.Text = "World Map"
	pubTitle.Parent = publicCard
	self.pubTitle = pubTitle

	local pubMeta = Instance.new("TextLabel")
	pubMeta.Position = UDim2.fromOffset(220, 40)
	pubMeta.Size = UDim2.fromOffset(205, 36)
	pubMeta.BackgroundTransparency = 1
	pubMeta.Font = Enum.Font.GothamBold
	pubMeta.TextXAlignment = Enum.TextXAlignment.Left
	pubMeta.TextWrapped = true
	pubMeta.TextSize = 13
	pubMeta.TextColor3 = Color3.fromRGB(147, 197, 253)
	pubMeta.Text = "PUBLIC FFA  •  Starting in 12s"
	pubMeta.Parent = publicCard
	self.pubMeta = pubMeta

	local joinPublicBtn = UiWidgets.MakeButton(
		publicCard,
		"▶ JOIN PUBLIC MATCH",
		Theme.UI.AccentBlue,
		UDim2.fromOffset(205, 44),
		UDim2.fromOffset(220, 92)
	)
	joinPublicBtn.TextSize = 15
	self.joinPublicBtn = joinPublicBtn

	-- Singleplayer + Host Custom Match Buttons
	local singleBtn = UiWidgets.MakeButton(
		centerCard,
		"⚡ PLAY SINGLEPLAYER NOW",
		Theme.UI.AccentGreen,
		UDim2.new(1, -40, 0, 48),
		UDim2.fromOffset(20, 290)
	)
	singleBtn.TextSize = 16

	local hostBtn = UiWidgets.MakeButton(
		centerCard,
		"🛠️ HOST CUSTOM / TEAM / SHINOBI LOBBY",
		Color3.fromRGB(51, 65, 85),
		UDim2.new(1, -40, 0, 44),
		UDim2.fromOffset(20, 348)
	)
	hostBtn.TextSize = 14

	local footerTip = Instance.new("TextLabel")
	footerTip.Position = UDim2.fromOffset(20, 402)
	footerTip.Size = UDim2.new(1, -40, 0, 30)
	footerTip.BackgroundTransparency = 1
	footerTip.Font = Enum.Font.Gotham
	footerTip.TextSize = 11
	footerTip.TextColor3 = Theme.UI.TextMuted
	footerTip.Text = "Left-Click: Attack • Right-Click: Radial Menu • Ctrl+Click / B: Build • Scroll: Zoom"
	footerTip.Parent = centerCard

	-- Sub-Modals (Host Custom Lobby, Flag Picker, Settings, How to Play)
	self.hostModal = self:_BuildHostModal(root)
	self.flagModal = self:_BuildFlagModal(root)
	self.settingsModal = self:_BuildSettingsModal(root)
	self.helpModal = self:_BuildHelpModal(root)

	local function openExclusiveModal(targetModal: Frame?)
		self.hostModal.Visible = (targetModal == self.hostModal)
		self.flagModal.Visible = (targetModal == self.flagModal)
		self.settingsModal.Visible = (targetModal == self.settingsModal)
		self.helpModal.Visible = (targetModal == self.helpModal)
		local anyOpen = targetModal ~= nil
		self.modalScrim.Visible = anyOpen
		self.centerCard.Visible = not anyOpen
	end
	self._openModal = openExclusiveModal
	self.modalScrim.Activated:Connect(function()
		openExclusiveModal(nil)
	end)

	-- Wire buttons
	joinPublicBtn.Activated:Connect(function()
		SoundFX.Play("click")
		if self.lobbyState ~= nil and (self.lobbyState.onlineCount or 1) &lt;= 1 then
			local cfg = Config.DefaultGameConfig(false)
			cfg.mapId = self.lobbyState.nextMapId or "World"
			cfg.mode = self.lobbyState.nextMode or "FFA"
			cfg.numTeams = self.lobbyState.nextNumTeams or 0
			self.callbacks.onSendIntent("StartMatchNow", cfg)
		else
			self.isQueued = not self.isQueued
			self.callbacks.onSendIntent("ToggleQueue", {})
			self:_RefreshLobbyCard()
		end
	end)

	singleBtn.Activated:Connect(function()
		SoundFX.Play("click")
		local cfg = Config.DefaultGameConfig(true)
		cfg.mapId = self.customCfg.mapId
		self.callbacks.onSendIntent("StartMatchNow", cfg)
	end)

	hostBtn.Activated:Connect(function()
		SoundFX.Play("click")
		openExclusiveModal(self.hostModal)
	end)

	flagBtn.Activated:Connect(function()
		SoundFX.Play("click")
		openExclusiveModal(self.flagModal)
	end)

	colorSwatch.Activated:Connect(function()
		SoundFX.Play("click")
		if self.profile ~= nil then
			local nextIdx = (self.profile.colorIndex % #Theme.HumanColors) + 1
			self.profile.colorIndex = nextIdx
			self.callbacks.onSendIntent("UpdateProfile", { colorIndex = nextIdx })
			self:SetProfile(self.profile)
		end
	end)

	patternBtn.Activated:Connect(function()
		SoundFX.Play("click")
		if self.profile ~= nil then
			local curIdx = 1
			for i, pat in ipairs(Theme.Patterns) do
				if pat.id == self.profile.patternId then
					curIdx = i
					break
				end
			end
			local nxt = Theme.Patterns[(curIdx % #Theme.Patterns) + 1]
			self.profile.patternId = nxt.id
			self.callbacks.onSendIntent("UpdateProfile", { patternId = nxt.id })
			self:SetProfile(self.profile)
		end
	end)

	settingsBtn.Activated:Connect(function()
		SoundFX.Play("click")
		openExclusiveModal(self.settingsModal)
	end)

	helpBtn.Activated:Connect(function()
		SoundFX.Play("click")
		openExclusiveModal(self.helpModal)
	end)

	-- Render initial World thumbnail right away
	UiWidgets.PopulateMapPreview(self.pubMapThumb, MapRegistry.Get("World"))
	self.lastRenderedPubMap = "World"

	return self
end

function MenuUI:_BuildHostModal(parent: Frame): Frame
	local modal = Instance.new("Frame")
	modal.Name = "HostLobbyModal"
	modal.AnchorPoint = Vector2.new(0.5, 0.5)
	modal.Position = UDim2.fromScale(0.5, 0.5)
	modal.Size = UDim2.fromOffset(740, 510)
	modal.BackgroundColor3 = Theme.UI.BgDark
	modal.BorderSizePixel = 0
	modal.Visible = false
	modal.ZIndex = 45
	UiWidgets.AddCorner(modal, 14)
	UiWidgets.AddStroke(modal, Theme.UI.AccentBlue, 2, 0.25)
	modal.Parent = parent

	local header = Instance.new("TextLabel")
	header.Position = UDim2.fromOffset(20, 14)
	header.Size = UDim2.fromOffset(520, 28)
	header.BackgroundTransparency = 1
	header.Font = Enum.Font.GothamBlack
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.TextSize = 20
	header.TextColor3 = Color3.new(1, 1, 1)
	header.Text = "🛠️ HOST FULL-SCALE MATCH (24 1:1 MAPS)"
	header.ZIndex = 46
	header.Parent = modal

	local closeBtn = UiWidgets.MakeButton(
		modal,
		"✕ Close",
		Theme.UI.AccentRed,
		UDim2.fromOffset(88, 32),
		UDim2.new(1, -104, 0, 12)
	)
	closeBtn.ZIndex = 46
	closeBtn.Activated:Connect(function()
		SoundFX.Play("click")
		if self._openModal then
			self._openModal(nil)
		else
			modal.Visible = false
		end
	end)

	-- Left Column: All 10 Real OpenFront Maps Scroll Grid with Live Rendered Previews!
	local mapScroll = Instance.new("ScrollingFrame")
	mapScroll.Position = UDim2.fromOffset(18, 52)
	mapScroll.Size = UDim2.fromOffset(420, 392)
	mapScroll.BackgroundColor3 = Theme.UI.BgPanel
	mapScroll.BorderSizePixel = 0
	mapScroll.ScrollBarThickness = 6
	mapScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	mapScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	mapScroll.ZIndex = 46
	UiWidgets.AddCorner(mapScroll, 10)
	mapScroll.Parent = modal

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(194, 128)
	grid.CellPadding = UDim2.fromOffset(10, 10)
	grid.Parent = mapScroll
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.Parent = mapScroll

	local cardStrokes: { [string]: UIStroke } = {}
	for _, mapDef in ipairs(MapRegistry.List) do
		local card = Instance.new("TextButton")
		card.BackgroundColor3 = Theme.UI.BgCard
		card.BorderSizePixel = 0
		card.Text = ""
		card.AutoButtonColor = true
		card.ZIndex = 47
		UiWidgets.AddCorner(card, 8)
		local st = UiWidgets.AddStroke(
			card,
			if mapDef.id == self.customCfg.mapId then Theme.UI.AccentGold else Theme.UI.Border,
			if mapDef.id == self.customCfg.mapId then 2.5 else 1,
			0.15
		)
		cardStrokes[mapDef.id] = st
		card.Parent = mapScroll

		local prev = Instance.new("Frame")
		prev.Position = UDim2.fromOffset(7, 7)
		prev.Size = UDim2.fromOffset(180, 92)
		prev.ZIndex = 48
		prev.Parent = card
		UiWidgets.PopulateMapPreview(prev, mapDef)

		local lbl = Instance.new("TextLabel")
		lbl.Position = UDim2.fromOffset(6, 100)
		lbl.Size = UDim2.fromOffset(182, 24)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 10
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.TextWrapped = false
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Text = string.format("%s · %dx%d (%d)", mapDef.name, mapDef.width, mapDef.height, #mapDef.nations)
		lbl.ZIndex = 48
		lbl.Parent = card

		card.Activated:Connect(function()
			SoundFX.Play("click")
			self.customCfg.mapId = mapDef.id
			for id, s in pairs(cardStrokes) do
				s.Color = if id == mapDef.id then Theme.UI.AccentGold else Theme.UI.Border
				s.Thickness = if id == mapDef.id then 2.5 else 1
			end
		end)
	end

	-- Right Column: Exact OpenFront GameConfig toggles &amp; cycle pills!
	local optsFrame = Instance.new("ScrollingFrame")
	optsFrame.Position = UDim2.fromOffset(450, 52)
	optsFrame.Size = UDim2.fromOffset(272, 392)
	optsFrame.BackgroundColor3 = Theme.UI.BgPanel
	optsFrame.BorderSizePixel = 0
	optsFrame.ScrollBarThickness = 5
	optsFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	optsFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	optsFrame.ZIndex = 46
	UiWidgets.AddCorner(optsFrame, 10)
	optsFrame.Parent = modal

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 7)
	listLayout.Parent = optsFrame
	local opad = Instance.new("UIPadding")
	opad.PaddingTop = UDim.new(0, 10)
	opad.PaddingLeft = UDim.new(0, 10)
	opad.PaddingRight = UDim.new(0, 10)
	opad.PaddingBottom = UDim.new(0, 10)
	opad.Parent = optsFrame

	local function addCycleOption(labelFn: () -&gt; string, onClick: () -&gt; ())
		local b = UiWidgets.MakeButton(optsFrame, labelFn(), Theme.UI.BgCard, UDim2.new(1, 0, 0, 34), nil)
		b.ZIndex = 47
		b.TextSize = 12
		b.Activated:Connect(function()
			SoundFX.Play("click")
			onClick()
			b.Text = labelFn()
		end)
	end

	local modePresets = {
		{ label = "Free For All (FFA)", mode = "FFA", teams = 0 },
		{ label = "2 Teams (Red vs Blue)", mode = "Teams", teams = 2 },
		{ label = "3 Teams", mode = "Teams", teams = 3 },
		{ label = "4 Teams", mode = "Teams", teams = 4 },
		{ label = "Humans vs AI Nations", mode = "Teams", teams = -1 },
	}
	local modeIdx = 1
	addCycleOption(function()
		return "⚔️ Mode: " .. modePresets[modeIdx].label
	end, function()
		modeIdx = (modeIdx % #modePresets) + 1
		self.customCfg.mode = modePresets[modeIdx].mode :: any
		self.customCfg.numTeams = modePresets[modeIdx].teams
	end)

	local diffs = { "Easy", "Medium", "Hard", "Impossible" }
	local diffIdx = 2
	addCycleOption(function()
		return "🎖️ AI Difficulty: " .. self.customCfg.difficulty
	end, function()
		diffIdx = (diffIdx % #diffs) + 1
		self.customCfg.difficulty = diffs[diffIdx] :: any
	end)

	local botSteps = { 0, 40, 100, 180 }
	local botIdx = 4
	addCycleOption(function()
		return "🤖 Minor Bots: " .. tostring(self.customCfg.bots)
	end, function()
		botIdx = (botIdx % #botSteps) + 1
		self.customCfg.bots = botSteps[botIdx]
	end)

	addCycleOption(function()
		return "🏛️ AI Nations: " .. (if self.customCfg.spawnNations then "Enabled" else "Disabled")
	end, function()
		self.customCfg.spawnNations = not self.customCfg.spawnNations
	end)

	local startGoldSteps = { 0, 1_000_000, 5_000_000, 25_000_000 }
	local sgIdx = 1
	addCycleOption(function()
		return "💰 Starting Gold: " .. Format.Gold(self.customCfg.startingGold)
	end, function()
		sgIdx = (sgIdx % #startGoldSteps) + 1
		self.customCfg.startingGold = startGoldSteps[sgIdx]
	end)

	local multSteps = { 1, 2, 5, 10 }
	local multIdx = 1
	addCycleOption(function()
		return "📈 Gold Multiplier: " .. tostring(self.customCfg.goldMultiplier) .. "x"
	end, function()
		multIdx = (multIdx % #multSteps) + 1
		self.customCfg.goldMultiplier = multSteps[multIdx]
	end)

	addCycleOption(function()
		return "⚡ Instant Build: " .. (if self.customCfg.instantBuild then "ON" else "OFF")
	end, function()
		self.customCfg.instantBuild = not self.customCfg.instantBuild
	end)

	addCycleOption(function()
		return "♾️ Infinite Gold: " .. (if self.customCfg.infiniteGold then "ON" else "OFF")
	end, function()
		self.customCfg.infiniteGold = not self.customCfg.infiniteGold
	end)

	addCycleOption(function()
		return "🪖 Infinite Troops: " .. (if self.customCfg.infiniteTroops then "ON" else "OFF")
	end, function()
		self.customCfg.infiniteTroops = not self.customCfg.infiniteTroops
	end)

	addCycleOption(function()
		return "🤝 Alliances: " .. (if self.customCfg.disableAlliances then "Disabled" else "Allowed (5m)")
	end, function()
		self.customCfg.disableAlliances = not self.customCfg.disableAlliances
	end)

	addCycleOption(function()
		return "⏳ Doomsday Clock: " .. (if self.customCfg.doomsdayEnabled then "ON (Anti-Stall)" else "OFF")
	end, function()
		self.customCfg.doomsdayEnabled = not self.customCfg.doomsdayEnabled
	end)

	addCycleOption(function()
		return "🎲 Random Spawn: " .. (if self.customCfg.randomSpawn then "ON" else "Choose Spot")
	end, function()
		self.customCfg.randomSpawn = not self.customCfg.randomSpawn
	end)

	local launchBtn = UiWidgets.MakeButton(
		modal,
		"🚀 LAUNCH MATCH NOW",
		Theme.UI.AccentGreen,
		UDim2.new(1, -36, 0, 44),
		UDim2.fromOffset(18, 454)
	)
	launchBtn.TextSize = 16
	launchBtn.ZIndex = 47
	launchBtn.Activated:Connect(function()
		SoundFX.Play("click")
		if self._openModal then
			self._openModal(nil)
		end
		self.callbacks.onSendIntent("StartMatchNow", self.customCfg)
	end)

	return modal
end

function MenuUI:_BuildFlagModal(parent: Frame): Frame
	local modal = Instance.new("Frame")
	modal.AnchorPoint = Vector2.new(0.5, 0.5)
	modal.Position = UDim2.fromScale(0.5, 0.5)
	modal.Size = UDim2.fromOffset(560, 420)
	modal.BackgroundColor3 = Theme.UI.BgDark
	modal.BorderSizePixel = 0
	modal.Visible = false
	modal.ZIndex = 48
	UiWidgets.AddCorner(modal, 14)
	UiWidgets.AddStroke(modal, Theme.UI.AccentGold, 2, 0.25)
	modal.Parent = parent

	local hdr = Instance.new("TextLabel")
	hdr.Position = UDim2.fromOffset(18, 12)
	hdr.Size = UDim2.fromOffset(380, 28)
	hdr.BackgroundTransparency = 1
	hdr.Font = Enum.Font.GothamBlack
	hdr.TextSize = 18
	hdr.TextXAlignment = Enum.TextXAlignment.Left
	hdr.TextColor3 = Color3.new(1, 1, 1)
	hdr.Text = "🏳️ SELECT NATION OR SHINOBI FLAG"
	hdr.ZIndex = 49
	hdr.Parent = modal

	local closeBtn = UiWidgets.MakeButton(
		modal,
		"✕",
		Theme.UI.AccentRed,
		UDim2.fromOffset(36, 30),
		UDim2.new(1, -50, 0, 11)
	)
	closeBtn.ZIndex = 49
	closeBtn.Activated:Connect(function()
		if self._openModal then
			self._openModal(nil)
		else
			modal.Visible = false
		end
	end)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Position = UDim2.fromOffset(16, 50)
	scroll.Size = UDim2.new(1, -32, 1, -66)
	scroll.BackgroundColor3 = Theme.UI.BgPanel
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.ZIndex = 49
	UiWidgets.AddCorner(scroll, 10)
	scroll.Parent = modal

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(164, 42)
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.Parent = scroll

	for _, spec in ipairs(Format.Flags) do
		local item = Instance.new("TextButton")
		item.BackgroundColor3 = Theme.UI.BgCard
		item.BorderSizePixel = 0
		item.Text = ""
		item.ZIndex = 50
		UiWidgets.AddCorner(item, 7)
		item.Parent = scroll

		local fb = UiWidgets.CreateFlagBadge(item, spec.code, UDim2.fromOffset(32, 22), UDim2.fromOffset(8, 10))
		fb.ZIndex = 51

		local nm = Instance.new("TextLabel")
		nm.Position = UDim2.fromOffset(48, 0)
		nm.Size = UDim2.new(1, -54, 1, 0)
		nm.BackgroundTransparency = 1
		nm.Font = Enum.Font.GothamBold
		nm.TextSize = 11
		nm.TextTruncate = Enum.TextTruncate.AtEnd
		nm.TextXAlignment = Enum.TextXAlignment.Left
		nm.TextColor3 = Color3.new(1, 1, 1)
		nm.Text = spec.label
		nm.ZIndex = 51
		nm.Parent = item

		item.Activated:Connect(function()
			SoundFX.Play("click")
			if self._openModal then
				self._openModal(nil)
			else
				modal.Visible = false
			end
			if self.profile ~= nil then
				self.profile.flag = spec.code
				self.callbacks.onSendIntent("UpdateProfile", { flag = spec.code })
				self:SetProfile(self.profile)
			end
		end)
	end

	return modal
end

function MenuUI:_BuildSettingsModal(parent: Frame): Frame
	local modal = Instance.new("Frame")
	modal.AnchorPoint = Vector2.new(0.5, 0.5)
	modal.Position = UDim2.fromScale(0.5, 0.5)
	modal.Size = UDim2.fromOffset(420, 320)
